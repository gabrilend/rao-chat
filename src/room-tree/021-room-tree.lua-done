-- 021-room-tree.lua — the room tree: rooms inside rooms, like folders.
--
-- Every room folder holds a `parent` file naming the room it sits inside
-- (or nothing, for a room at the top).  That one line per room is the whole
-- truth about the tree; everything this module offers is worked out from
-- it on request:
--
--   * which rooms sit directly inside a room (its children);
--   * which rooms a room sits inside, from the top down (its ancestors);
--   * its path of names from the top, "home/ritz/programming";
--   * the `where` note kept in each room folder (the room's real folder on
--     disk and its path of names, side by side, as the owner asked), which
--     is rewritten for a room and everything below it whenever a name or a
--     parent above it changes — this module listens on the room-folders
--     module's change bell for that, so loading it is enough;
--   * moving a room, refusing any move that would put a room inside itself
--     or inside one of its own descendants (that would cut it off from the
--     top of every tree);
--   * what a given contact is told about a room's parent (open question 3,
--     both answers built, chosen by the config key tree.parent-disclosure);
--   * the reader's side: from the rooms a person has received, the trees
--     they see (worked out in 023, offered from here).
--
-- Nothing here stores a tree separately from the `parent` files, so there
-- is nothing to fall out of step with them except `where`, which is kept
-- current by the bell and can be rebuilt for the whole home at any time.

local rooms = require("002-room-folders")
local where_file = require("022-where-file")
local reader_forest = require("023-reader-forest")

local M = {}

-- {{{ local function contains
local function contains(list, wanted)
    for _, item in ipairs(list) do
        -- found: yes; otherwise keep looking
        if item == wanted then
            return true
        end
    end
    return false
end
-- }}}

-- A room's name as one step of a path of names.  Room-folders (101) refuses
-- empty names and line breaks; meeting one here means a file was edited
-- by hand, so it is reported.  A "/" is allowed or refused by the owner's
-- setting rooms.slash-in-name (101's choice, read only when a "/" is
-- actually present, as 101 does): allow — the name is escaped in the path
-- (022 explains how); refuse — a "/" on disk is damage and is reported.

-- {{{ local function refuse_slash
local function refuse_slash(name)
    error("room-tree: a room name holds '/' although rooms.slash-in-name = refuse: " .. name)
end
-- }}}

local slash_in_name = {
    ["allow"] = where_file.path_step,
    ["refuse"] = refuse_slash,
}

-- {{{ local function name_step
local function name_step(home, room)
    -- empty, or holding a line break: damage on disk
    if room.name == "" or room.name:find("[\r\n]") then
        error("room-tree: room " .. room.id .. " has an empty or multi-line name: "
            .. string.format("%q", room.name))
    end
    -- no slash: the name is its own step (a lone "\" is still escaped, so
    -- the path splits back the same way); a slash: the owner's setting
    if not room.name:find("/", 1, true) then
        return where_file.path_step(room.name)
    end
    local mode = rooms.config_value(home, "rooms.slash-in-name")
    local handle = slash_in_name[mode]
    -- a value that is neither: a typo in config
    if handle == nil then
        error("room-tree: rooms.slash-in-name must be allow or refuse, got " .. mode)
    end
    return handle(room.name)
end
-- }}}

-- A room whose parent id names a room not held in this home (it arrived
-- from someone who said its parent, and that parent has not reached you
-- yet).  101's setting rooms.unknown-parent decides whether such a room
-- may exist: keep — it counts as a top room until the parent arrives, when
-- the tree joins by itself; refuse — it should never have been written,
-- so meeting one is damage and is reported.  Read only in that case.

-- {{{ local function keep_as_top
local function keep_as_top(room)
    return true
end
-- }}}

-- {{{ local function refuse_unheld
local function refuse_unheld(room)
    error("room-tree: room " .. room.id .. " names parent " .. room.parent_id
        .. ", which is not on disk (rooms.unknown-parent = refuse)")
end
-- }}}

local unknown_parent = {
    ["keep"] = keep_as_top,
    ["refuse"] = refuse_unheld,
}

-- {{{ local function unheld_parent_is_top
local function unheld_parent_is_top(home, room)
    local mode = rooms.config_value(home, "rooms.unknown-parent")
    local handle = unknown_parent[mode]
    -- a value that is neither keep nor refuse: a typo in config
    if handle == nil then
        error("room-tree: rooms.unknown-parent must be keep or refuse, got " .. mode)
    end
    return handle(room)
end
-- }}}

-- {{{ function M.ancestors
-- Rooms from the top of the tree down to `id`, ending with `id` itself.
-- Parents that lead round in a ring are damage and are reported.  A parent
-- file naming a room not on disk is decided by rooms.unknown-parent (see
-- unheld_parent_is_top): keep ends the chain there, refuse reports it.
function M.ancestors(home, id)
    local chain = {}
    local seen = {}
    local current = id
    while true do
        -- met this room already on the way up: the parents form a ring
        if seen[current] then
            error("room-tree: the parents above room " .. id .. " lead round in a ring at " .. current)
        end
        seen[current] = true
        table.insert(chain, 1, current)
        local parent_id = rooms.read_room(home, current).parent_id
        -- no parent: this is the top, the chain is complete
        if parent_id == "" then
            return chain
        end
        -- a parent that is not on disk: the owner's setting decides (keep:
        -- this room is the top for now; refuse: an error is raised inside)
        if not rooms.room_exists(home, parent_id) then
            unheld_parent_is_top(home, rooms.read_room(home, current))
            return chain
        end
        current = parent_id
    end
end
-- }}}

-- {{{ function M.children_of
-- The rooms whose parent is `id`, in room-id order (list_rooms' order).
-- Found by reading every room's parent file: phase 1 keeps no index of
-- children, so this costs one read per room in the home.
function M.children_of(home, id)
    local children = {}
    for _, other in ipairs(rooms.list_rooms(home)) do
        -- a room whose parent is this one: a child; any other: skip
        if rooms.read_room(home, other).parent_id == id then
            children[#children + 1] = other
        end
    end
    return children
end
-- }}}

-- {{{ function M.path_of_names
-- "home/ritz/programming": the names of the room's ancestors, top first.
-- These are the sender's own names; a reader's names are their own.
function M.path_of_names(home, id)
    local names = {}
    for _, step in ipairs(M.ancestors(home, id)) do
        names[#names + 1] = name_step(home, rooms.read_room(home, step))
    end
    return table.concat(names, "/")
end
-- }}}

-- {{{ local function children_index
-- One pass over every room, giving parent id -> list of child ids, so a
-- walk down a subtree reads each room once instead of once per level.
local function children_index(home)
    local index = {}
    local room_by_id = {}
    for _, id in ipairs(rooms.list_rooms(home)) do
        local room = rooms.read_room(home, id)
        room_by_id[id] = room
        local siblings = index[room.parent_id] or {}
        siblings[#siblings + 1] = id
        index[room.parent_id] = siblings
    end
    return index, room_by_id
end
-- }}}

-- {{{ local function write_subtree
-- Writes `where` for `id` (whose path of names is `path`) and then for
-- every room below it.  `visited` stops a ring of parents below from
-- looping forever; a ring cannot reach a top, so meeting one is an error.
local function write_subtree(home, id, path, index, room_by_id, visited)
    -- already written in this walk: the parents below form a ring
    if visited[id] then
        error("room-tree: the rooms below " .. id .. " lead round in a ring")
    end
    visited[id] = true
    where_file.write(rooms.room_dir(home, id), path)
    for _, child in ipairs(index[id] or {}) do
        write_subtree(home, child, path .. "/" .. name_step(home, room_by_id[child]),
            index, room_by_id, visited)
    end
end
-- }}}

-- {{{ function M.write_where
-- Rewrites `where` for `id` and every room below it.  Writing `where` does
-- not ring the bell: it is derived from name and parent, and nobody else
-- needs to hear about it.
function M.write_where(home, id)
    local index, room_by_id = children_index(home)
    write_subtree(home, id, M.path_of_names(home, id), index, room_by_id, {})
end
-- }}}

-- {{{ function M.write_all_where
-- Rewrites `where` for every room in the home, walking down from each top
-- room.  For a home made before the room tree was loaded, or a home folder
-- that was moved (the folder line records the old place).
function M.write_all_where(home)
    local index, room_by_id = children_index(home)
    local visited = {}
    for _, id in ipairs(rooms.list_rooms(home)) do
        local room = room_by_id[id]
        -- a top room: walk down from it
        -- a room under a parent held here: reached from that parent's walk
        -- a room under a parent not held here: rooms.unknown-parent decides
        --   (keep: a top for now; refuse: an error is raised inside)
        local top = room.parent_id == ""
        if not top and room_by_id[room.parent_id] == nil then
            top = unheld_parent_is_top(home, room)
        end
        if top then
            write_subtree(home, id, name_step(home, room), index, room_by_id, visited)
        end
    end
    -- rooms never reached from a top hang from a missing parent or a ring
    for id in pairs(room_by_id) do
        -- reached: fine; not reached: the tree is broken above it
        if not visited[id] then
            M.ancestors(home, id)   -- raises the precise error
            error("room-tree: room " .. id .. " was not reached from any top room")
        end
    end
end
-- }}}

-- {{{ function M.read_where
-- Gives { folder = string, names = string } from the room's `where` file.
function M.read_where(home, id)
    return where_file.read(rooms.room_dir(home, id))
end
-- }}}

-- {{{ function M.move_room
-- Puts room `id` inside `new_parent_id` ("" for the top).  Refuses a move
-- into itself or into anything below it: such a room would have no top,
-- and every walk up from it would go round forever.  The write goes
-- through room-folders, which rings the bell, which rewrites `where`.
function M.move_room(home, id, new_parent_id)
    -- the room being moved must exist; a mistyped id is reported
    if not rooms.room_exists(home, id) then
        error("room-tree: cannot move room " .. id .. ": it is not on disk")
    end
    -- moving to the top: always allowed, nothing can loop
    if new_parent_id == "" then
        rooms.write_parent(home, id, "")
        return
    end
    -- the new parent must exist
    if not rooms.room_exists(home, new_parent_id) then
        error("room-tree: cannot move room " .. id .. " into " .. new_parent_id
            .. ": that room is not on disk")
    end
    -- into itself: refused
    if new_parent_id == id then
        error("room-tree: cannot move room " .. id .. " inside itself")
    end
    -- into one of its own descendants: refused (it would appear among the
    -- new parent's ancestors)
    if contains(M.ancestors(home, new_parent_id), id) then
        error("room-tree: cannot move room " .. id .. " inside " .. new_parent_id
            .. ", which is inside it")
    end
    rooms.write_parent(home, id, new_parent_id)
end
-- }}}

-- ---------------------------------------------------------------------
-- what a reader is told about parents (open question 3)
-- ---------------------------------------------------------------------

-- How much each mode says about a room's parent to one contact.
--   always:      the parent's id, to everyone the room's messages go to.
--                The reader learns that some room sits above (never its
--                name) and joins the two the moment they have both.
--   shared-only: the parent's id only to people who are also on the
--                parent's own recipient list; to anyone else, "".  The
--                reader learns nothing about rooms they are not in.

-- {{{ local function disclose_always
local function disclose_always(home, room, contact)
    return room.parent_id
end
-- }}}

-- {{{ local function disclose_shared_only
local function disclose_shared_only(home, room, contact)
    -- a top room has no parent to tell anyone about
    if room.parent_id == "" then
        return ""
    end
    -- the contact also hears the parent: they may know it; otherwise not
    if contains(rooms.read_room(home, room.parent_id).recipients, contact) then
        return room.parent_id
    end
    return ""
end
-- }}}

local disclosure_modes = {
    ["always"] = disclose_always,
    ["shared-only"] = disclose_shared_only,
}

-- {{{ local function mode_function
local function mode_function(mode)
    local chosen = disclosure_modes[mode]
    -- an unknown mode is a typo in config or in a caller: stop
    if chosen == nil then
        error("room-tree: unknown parent-disclosure mode '" .. tostring(mode)
            .. "' (expected always or shared-only)")
    end
    return chosen
end
-- }}}

-- {{{ function M.disclosure_mode
-- The mode chosen in config (tree.parent-disclosure); an absent or unknown
-- value is an error, never a quiet default.
function M.disclosure_mode(home)
    local mode = rooms.config_value(home, "tree.parent-disclosure")
    mode_function(mode)
    return mode
end
-- }}}

-- {{{ function M.parent_to_disclose
-- The parent id to send along with room `id`'s messages to `contact`, or
-- "".  Asking about a contact who is not on the room's list is an error:
-- nothing is sent to them, so there is nothing to decide.
function M.parent_to_disclose(home, id, contact, mode)
    local disclose = mode_function(mode)
    local room = rooms.read_room(home, id)
    -- not a recipient here: the caller has the wrong room or person
    if not contains(room.recipients, contact) then
        error("room-tree: " .. contact .. " is not a recipient of room " .. id
            .. "; nothing is sent to them there")
    end
    return disclose(home, room, contact)
end
-- }}}

-- {{{ function M.what_contact_receives
-- What `contact` would have learned from this home under `mode`: one entry
-- per room they are a recipient of, { room_id, name, disclosed_parent_id },
-- ready for visible_forest.  The name given is the sender's own name for
-- the room — names do not travel (vision section 4); this stands in for
-- the reader naming each room the same way, which is what the owner's
-- example assumes.  Delivery itself is phase 2; this is the phase-1 view.
function M.what_contact_receives(home, contact, mode)
    local received = {}
    for _, id in ipairs(rooms.list_rooms(home)) do
        local room = rooms.read_room(home, id)
        -- the contact hears this room: record what they are told; else skip
        if contains(room.recipients, contact) then
            received[#received + 1] = {
                room_id = id,
                name = room.name,
                disclosed_parent_id = M.parent_to_disclose(home, id, contact, mode),
            }
        end
    end
    return received
end
-- }}}

-- The reader's trees, from what they have received (see 023).
M.visible_forest = reader_forest.visible_forest
M.forest_paths = reader_forest.forest_paths

-- ---------------------------------------------------------------------
-- keeping `where` current: listening on the bell
-- ---------------------------------------------------------------------

-- {{{ local function ignore
local function ignore(home, id)
end
-- }}}

-- What each kind of change means for `where`:
--   created, name, parent: the room's own path (and every path below it,
--     for name and parent) may have changed — rewrite from this room down;
--   recipients, log: names and parents untouched — nothing to do;
--   removed-room: the folder is gone; the rooms that were inside it are
--     re-parented by whoever removed it, which rings "parent" for each;
--   split: the room became a read-only record; its name and place are
--     unchanged, so its `where` still holds.
local bell_actions = {
    ["created"] = M.write_where,
    ["name"] = M.write_where,
    ["parent"] = M.write_where,
    ["recipients"] = ignore,
    ["log"] = ignore,
    ["removed-room"] = ignore,
    ["split"] = ignore,
}

-- {{{ local function on_bell
local function on_bell(home, id, what)
    local action = bell_actions[what]
    -- a kind of change the contract does not list: stop and say so
    if action == nil then
        error("room-tree: the change bell rang with an unknown kind '" .. tostring(what) .. "'")
    end
    action(home, id)
end
-- }}}

rooms.on_change(on_bell)

return M
