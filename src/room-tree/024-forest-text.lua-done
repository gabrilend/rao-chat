-- 024-forest-text.lua — draws a reader's trees (from 023) as plain text.
--
-- Kept apart from the making of the trees so that the trees can be tested
-- as data and drawn any number of ways.  This drawing is the one used by
-- the tests and the phase demo: one room per line, children indented under
-- their parent with the same box-drawing branches the planning document
-- uses, and a room whose parent was said but never reached the reader
-- marked with "(inside a room you are not in)".
--
--   home
--   └── ritz
--       └── programming

local M = {}

local UNSEEN_MARK = "   (inside a room you are not in)"

-- {{{ local function mark_for
local function mark_for(node)
    -- a parent was said but not received: say so; otherwise nothing
    if node.parent_unseen then
        return UNSEEN_MARK
    end
    return ""
end
-- }}}

-- {{{ local function draw_children
-- `lead` is what goes in front of each child's branch: spaces or a bar
-- for every level above, so lines under an unfinished parent keep a bar.
local function draw_children(children, lead, lines)
    for position, child in ipairs(children) do
        local last = position == #children
        -- the last child closes the branch; the others keep it open below
        local branch, below = "├── ", "│   "
        if last then
            branch, below = "└── ", "    "
        end
        lines[#lines + 1] = lead .. branch .. child.name .. mark_for(child)
        draw_children(child.children, lead .. below, lines)
    end
end
-- }}}

-- {{{ function M.lines
-- A list of strings, one per room, trees in the forest's order.
function M.lines(forest)
    local lines = {}
    for _, top in ipairs(forest) do
        lines[#lines + 1] = top.name .. mark_for(top)
        draw_children(top.children, "", lines)
    end
    return lines
end
-- }}}

-- {{{ function M.text
-- The same lines joined with line breaks, ending in one.
function M.text(forest)
    return table.concat(M.lines(forest), "\n") .. "\n"
end
-- }}}

return M
