-- 039-options.lua — the undecided choices in the room-tree module, written
-- down for the options tally (scripts/tally-options, issue 106).
--
-- Each entry is one question the owner (or some later state of the project)
-- has to settle.  Where a choice is switchable, every variant is built and
-- tested and the home's config file picks the one in use.  The findings
-- are what building and testing each variant showed, so the choice can be
-- made on facts.  Plain data: nothing here runs.

return {
    {
        id = "tree-parent-disclosure",
        question = "What travels with a message to place its room in the reader's tree: the parent room's id "
            .. "always, or only to people who are also in the parent room?",
        waits_on = "owner",
        detail = "open question 3",
        config_key = "tree.parent-disclosure",
        variants = {
            {
                name = "always",
                summary = "Every message says its room's parent id, to everyone the room's messages go to.",
                built_in = "src/room-tree/021-room-tree.lua (disclose_always, parent_to_disclose)",
                tests = { "tests/033-test-disclosure.lua", "tests/035-test-owner-example.lua" },
                findings = {
                    "In the owner's example the girlfriend sees two trees, home and programming, but "
                        .. "programming is marked as sitting inside a room she is not in: she learns a hidden "
                        .. "room exists above it (not its name or members). The programming friend learns the "
                        .. "same about programming.",
                    "When she is added to ritz, the gap closes the moment ritz's first message reaches her, "
                        .. "before programming says anything more: her copy of programming already named ritz.",
                    "When she is taken out of ritz again she keeps the joined tree: what she was told cannot "
                        .. "be untold, and programming keeps naming ritz.",
                    "Cost: one room read per message; no recipient lists consulted.",
                },
            },
            {
                name = "shared-only",
                summary = "The parent id is said only to people also on the parent's recipient list; to "
                    .. "everyone else, nothing.",
                built_in = "src/room-tree/021-room-tree.lua (disclose_shared_only, parent_to_disclose)",
                tests = { "tests/033-test-disclosure.lua", "tests/035-test-owner-example.lua" },
                findings = {
                    "Matches the owner's words: the girlfriend sees home and programming as two unmarked "
                        .. "trees and 'has no idea they're even connected'; the friend sees programming with no "
                        .. "hint of anything above.",
                    "When she is added to ritz, ritz's next message joins ritz under home, but programming "
                        .. "stays a separate tree (home/ritz, and programming) until programming's own next "
                        .. "message says its parent: its last message told her nothing. In a deeper tree the "
                        .. "gap closes one level each time a room speaks. See choice tree-disclosure-refresh.",
                    "When she is taken out of ritz, programming's next message detaches it again, but her old "
                        .. "copy of ritz stays under home.",
                    "Neither mode concerns the owner's own devices: they are never recipients (issue 103), "
                        .. "so they must get the whole tree from phase 3's catching up, not from disclosure.",
                    "Cost: one extra read (the parent's recipient list) per recipient per message.",
                },
            },
        },
        leaning = "shared-only: it is the behaviour the owner described (no hint of rooms you are not in). "
            .. "Its one weakness, the gap closing late, is answered by announce-on-add in phase 2.",
    },
    {
        id = "tree-disclosure-refresh",
        question = "When someone is added to a parent room, are the rooms below it re-announced to them at "
            .. "once, so their tree joins without waiting for each room to speak?",
        waits_on = "state",
        detail = "issue 102, found while building; needs phase 2 (delivery) to exist, since it is a message "
            .. "with no text that only carries a room's place",
        config_key = "",
        variants = {
            {
                name = "next-message",
                summary = "Nothing extra is sent; a reader learns a room's parent with that room's next message.",
                built_in = "the phase 1 model: tests/035-test-owner-example.lua (send_in keeps only the latest "
                    .. "disclosure per room)",
                tests = { "tests/035-test-owner-example.lua" },
                findings = {
                    "Under always, adding the girlfriend to ritz closes her gap as soon as ritz speaks.",
                    "Under shared-only, it takes a message in ritz and then one in programming; a quiet child "
                        .. "room can stay detached for her indefinitely.",
                },
            },
            {
                name = "announce-on-add",
                summary = "Adding someone to a room also sends them, for each room below it that they are "
                    .. "in, a small notice carrying that room's id and parent id.",
                built_in = "not built (phase 2 delivery)",
                tests = {},
                findings = {
                    "what_contact_receives (021) already computes exactly what such notices would carry: "
                        .. "the test shows it joins her tree immediately in both modes.",
                },
            },
        },
        leaning = "announce-on-add, if shared-only is chosen; under always it matters much less.",
    },
    {
        id = "tree-where-per-recipient",
        question = "Should a room's where file keep only your own path of names, or also the path each "
            .. "recipient sees (e.g. 'programming' alone, for the girlfriend)?",
        waits_on = "owner",
        detail = "issue 102, found while writing the issue",
        config_key = "",
        variants = {
            {
                name = "own-path",
                summary = "where holds your folder and your path of names only.",
                built_in = "src/room-tree/022-where-file.lua, 021-room-tree.lua (write_where)",
                tests = { "tests/032-test-tree.lua" },
                findings = {
                    "Two lines per room; rewritten for a subtree on a name or parent change, one pass over "
                        .. "all rooms (children_index) plus one write per room below.",
                    "Each recipient's view can be worked out on demand with what_contact_receives + "
                        .. "visible_forest, so nothing is lost by not storing it.",
                },
            },
            {
                name = "per-recipient",
                summary = "where also holds one line per recipient with the path that person sees.",
                built_in = "not built",
                tests = {},
                findings = {
                    "Would have to be rewritten on every recipients change anywhere above a room, not only "
                        .. "on name or parent changes, and depends on the disclosure mode and on phase 2's "
                        .. "record of what was actually told to whom.",
                },
            },
        },
        leaning = "own-path; compute each person's view when it is asked for.",
    },
    {
        id = "tree-slash-in-path",
        question = "When room names may hold '/' (101's rooms.slash-in-name = allow), how does a path of "
            .. "names keep its steps apart?",
        waits_on = "state",
        detail = "issue 102; only matters if the owner answers 101's rooms.slash-in-name with allow",
        config_key = "",
        variants = {
            {
                name = "escape",
                summary = "Inside a path, '\\' is written '\\\\' and '/' is written '\\/'; split_path undoes it.",
                built_in = "src/room-tree/022-where-file.lua (path_step, split_path)",
                tests = { "tests/032-test-tree.lua" },
                findings = {
                    "Paths with no '/' or '\\' in any name are unchanged, so under refuse nothing differs.",
                    "'home' + 'a/b' + 'c' is written 'home/a\\/b/c' and splits back to the three names; a "
                        .. "name holding '\\' also round-trips.",
                    "A person reading where with cat sees the backslashes.",
                },
            },
            {
                name = "one-name-per-line",
                summary = "where writes the path as one name per line instead of one '/'-joined line.",
                built_in = "not built",
                tests = {},
                findings = {
                    "Would change the where file's shape from two key = value lines; not built because "
                        .. "escape already works and leaves the common case untouched.",
                },
            },
        },
        leaning = "escape, only if the owner allows '/' in names at all.",
    },
    {
        id = "tree-untell-on-removal",
        question = "When someone is taken off a parent room's list, should they be told to forget where the "
            .. "rooms below it sit, or keep what they were already told?",
        waits_on = "state",
        detail = "issue 102, found while building; needs phase 2's wire format and 103's removal split",
        config_key = "",
        variants = {
            {
                name = "keep-what-was-told",
                summary = "Nothing is taken back; later messages simply say less (shared-only) or the same (always).",
                built_in = "the phase 1 model: tests/035-test-owner-example.lua (last block)",
                tests = { "tests/035-test-owner-example.lua" },
                findings = {
                    "Taken out of ritz: under always she keeps the whole joined tree; under shared-only "
                        .. "programming detaches at its next message but her copy of ritz stays under home.",
                },
            },
            {
                name = "forget-notice",
                summary = "The removal carries a notice telling the reader to drop the parent ids of the rooms "
                    .. "below, so their trees split again.",
                built_in = "not built (phase 2 delivery)",
                tests = {},
                findings = {
                    "A reader's server can ignore such a notice; it hides structure only from honest readers.",
                },
            },
        },
        leaning = "keep-what-was-told: nothing can be un-sent, and the removal split (103) already stops "
            .. "further messages.",
    },
}
