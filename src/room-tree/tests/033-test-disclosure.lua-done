-- 033-test-disclosure.lua — tests what each contact is told about a room's
-- parent, in both answers to open question 3.
--
-- For every room and every person on its list, asks "what parent id goes
-- with this room's messages to this person?" under "always" (the parent's
-- id, to everyone) and "shared-only" (the parent's id only to people who
-- are also in the parent room), and checks the config key that chooses
-- between them fails loudly when unset or misspelt.
--
-- Run: luajit 033-test-disclosure.lua [DIR] stand-in|real

local DIR = "/home/ritz/programs/rao-chat"
-- a project folder given first: use it; otherwise the one above
if arg[1] and arg[1] ~= "" then
    DIR = arg[1]
end

local t = dofile(DIR .. "/src/room-tree/tests/031-test-support.lua")
local rooms, tree = t.setup(DIR, arg[2])

local home = t.fresh_home(rooms, "disclosure")
local h = rooms.create_room(home, { name = "home", parent_id = "", recipients = { "girlfriend", "sister" } })
local r = rooms.create_room(home, { name = "ritz", parent_id = h, recipients = {} })
local p = rooms.create_room(home, { name = "programming", parent_id = r, recipients = { "girlfriend", "friend" } })

-- always: the parent id to everyone on the list
t.equal(tree.parent_to_disclose(home, h, "girlfriend", "always"), "", "always: a top room says no parent")
-- ritz is "just you": an empty list (your own devices are never
-- recipients, issue 103), so there is nobody to tell anything
t.refuses(function() tree.parent_to_disclose(home, r, "girlfriend", "always") end, "not a recipient", "ritz has nobody to tell")
t.equal(tree.parent_to_disclose(home, p, "girlfriend", "always"), r, "always: girlfriend told programming is in ritz")
t.equal(tree.parent_to_disclose(home, p, "friend", "always"), r, "always: friend told programming is in ritz")

-- shared-only: only to people also in the parent
t.equal(tree.parent_to_disclose(home, h, "sister", "shared-only"), "", "shared-only: a top room says no parent")
t.equal(tree.parent_to_disclose(home, p, "girlfriend", "shared-only"), "", "shared-only: girlfriend not in ritz, told nothing")
t.equal(tree.parent_to_disclose(home, p, "friend", "shared-only"), "", "shared-only: friend not in ritz, told nothing")

-- once the girlfriend is in ritz, shared-only tells her
rooms.write_recipients(home, r, { "girlfriend" })
t.equal(tree.parent_to_disclose(home, r, "girlfriend", "always"), h, "always: girlfriend told ritz is in home")
t.equal(tree.parent_to_disclose(home, p, "girlfriend", "shared-only"), r, "shared-only: girlfriend in ritz now told")
t.equal(tree.parent_to_disclose(home, r, "girlfriend", "shared-only"), h, "shared-only: girlfriend told ritz is in home")
t.equal(tree.parent_to_disclose(home, p, "friend", "shared-only"), "", "shared-only: friend still told nothing")

-- asking about someone not on the list, or an unknown mode
t.refuses(function() tree.parent_to_disclose(home, p, "sister", "always") end, "not a recipient", "not a recipient is refused")
t.refuses(function() tree.parent_to_disclose(home, p, "friend", "sometimes") end, "unknown parent-disclosure mode", "unknown mode refused")

-- the config key: absent, wrong, each right value
t.refuses(function() tree.disclosure_mode(home) end, "tree.parent-disclosure", "absent config key is an error")
rooms.set_config(home, "tree.parent-disclosure", "maybe")
t.refuses(function() tree.disclosure_mode(home) end, "unknown parent-disclosure mode", "misspelt config value is an error")
for _, mode in ipairs({ "always", "shared-only" }) do
    rooms.set_config(home, "tree.parent-disclosure", mode)
    t.equal(tree.disclosure_mode(home), mode, "config selects " .. mode)
end

-- what a contact receives, as the list the reader's side takes
rooms.set_config(home, "tree.parent-disclosure", "always")
local got = tree.what_contact_receives(home, "friend", tree.disclosure_mode(home))
t.equal(#got, 1, "friend receives one room")
t.equal(got[1].room_id, p, "friend receives programming")
t.equal(got[1].disclosed_parent_id, r, "with its parent id under always")
t.equal(got[1].name, "programming", "named as the sender names it")
t.equal(#tree.what_contact_receives(home, "nobody", "always"), 0, "a stranger receives nothing")

t.finish("033-test-disclosure")
