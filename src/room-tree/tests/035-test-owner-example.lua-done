-- 035-test-owner-example.lua — the owner's own example, seen from each
-- reader's side, under both answers to open question 3.
--
-- The owner keeps three rooms, one inside the next:
--
--   home                  recipients: girlfriend, sister (the household)
--   └── ritz              recipients: none (just the owner; own devices
--                                     are never recipients, issue 103)
--       └── programming   recipients: girlfriend, friend (programmers)
--
-- Messages are "sent" by recording, for every person on a room's list, what
-- that person is told: the room's id, its name, and the parent id chosen by
-- the disclosure mode.  Each reader keeps only the latest thing they were
-- told about each room, the way a reader's server would.  Their trees are
-- then worked out from that alone and compared with what the owner said:
--
--   girlfriend: two trees, home and programming, not connected;
--   friend:     one tree, programming, nothing above it;
--   sister:     one tree, home;
--   then the girlfriend is added to ritz, and her gap closes to one tree,
--   home → ritz → programming.
--
-- How and when it closes differs between the modes; that difference is the
-- finding recorded in 039-options.lua.
--
-- Run: luajit 035-test-owner-example.lua [DIR] stand-in|real

local DIR = "/home/ritz/programs/rao-chat"
-- a project folder given first: use it; otherwise the one above
if arg[1] and arg[1] ~= "" then
    DIR = arg[1]
end

local t = dofile(DIR .. "/src/room-tree/tests/031-test-support.lua")
local rooms, tree, text = t.setup(DIR, arg[2])

-- {{{ local function new_inboxes
-- inboxes[contact][room_id] = the latest { room_id, name,
-- disclosed_parent_id } that contact was told about that room.
local function new_inboxes()
    return {}
end
-- }}}

-- {{{ local function send_in
-- One message written in room `id`: every recipient is told about the room
-- as it stands right now.
local function send_in(home, inboxes, id, mode)
    local room = rooms.read_room(home, id)
    for _, contact in ipairs(room.recipients) do
        inboxes[contact] = inboxes[contact] or {}
        inboxes[contact][id] = {
            room_id = id,
            name = room.name,
            disclosed_parent_id = tree.parent_to_disclose(home, id, contact, mode),
        }
    end
end
-- }}}

-- {{{ local function view
-- The drawn trees one contact sees, from their inbox alone.
local function view(inboxes, contact)
    local received = {}
    for _, entry in pairs(inboxes[contact] or {}) do
        received[#received + 1] = entry
    end
    return text.text(tree.visible_forest(received))
end
-- }}}

local MARK = "   (inside a room you are not in)"

-- What each reader should see before the gap closes, per mode.  Under
-- "always" a room whose parent was said but never reached the reader
-- carries the mark; under "shared-only" nothing is said, so no mark.
local before = {
    ["always"] = {
        girlfriend = "home\nprogramming" .. MARK .. "\n",
        friend = "programming" .. MARK .. "\n",
        sister = "home\n",
    },
    ["shared-only"] = {
        girlfriend = "home\nprogramming\n",
        friend = "programming\n",
        sister = "home\n",
    },
}

-- What the girlfriend sees after she is added to ritz and one message is
-- then written in ritz (none yet in programming).  Under "always" her copy
-- of programming already said "inside ritz", so receiving ritz closes the
-- gap at once.  Under "shared-only" programming told her nothing when it
-- last spoke, so ritz joins home but programming still stands alone until
-- the next message in programming says its parent.
local after_ritz_speaks = {
    ["always"] = "home\n└── ritz\n    └── programming\n",
    ["shared-only"] = "home\n└── ritz\nprogramming\n",
}

local JOINED = "home\n└── ritz\n    └── programming\n"

for _, mode in ipairs({ "always", "shared-only" }) do
    local home = t.fresh_home(rooms, "owner-example-" .. mode)
    rooms.set_config(home, "tree.parent-disclosure", mode)
    local chosen = tree.disclosure_mode(home)
    local h = rooms.create_room(home, { name = "home", parent_id = "", recipients = { "girlfriend", "sister" } })
    local r = rooms.create_room(home, { name = "ritz", parent_id = h, recipients = {} })
    local p = rooms.create_room(home, { name = "programming", parent_id = r, recipients = { "girlfriend", "friend" } })

    local inboxes = new_inboxes()
    send_in(home, inboxes, h, chosen)
    send_in(home, inboxes, r, chosen)
    send_in(home, inboxes, p, chosen)

    for _, contact in ipairs({ "girlfriend", "friend", "sister" }) do
        t.equal(view(inboxes, contact), before[mode][contact], mode .. ": " .. contact .. " before")
    end

    -- the girlfriend is added to ritz; nothing has been said since, so
    -- nothing she holds has changed
    rooms.write_recipients(home, r, { "girlfriend" })
    t.equal(view(inboxes, "girlfriend"), before[mode].girlfriend, mode .. ": adding her changes nothing until a message")

    -- a message in ritz reaches her
    send_in(home, inboxes, r, chosen)
    t.equal(view(inboxes, "girlfriend"), after_ritz_speaks[mode], mode .. ": girlfriend after ritz speaks")

    -- a message in programming: joined in both modes
    send_in(home, inboxes, p, chosen)
    t.equal(view(inboxes, "girlfriend"), JOINED, mode .. ": girlfriend after programming speaks")

    -- the others are unmoved by all of it
    t.equal(view(inboxes, "friend"), before[mode].friend, mode .. ": friend unchanged")
    t.equal(view(inboxes, "sister"), before[mode].sister, mode .. ": sister unchanged")

    -- the full present-day view (as if every room had just spoken) agrees
    local fresh = tree.visible_forest(tree.what_contact_receives(home, "girlfriend", chosen))
    t.equal(text.text(fresh), JOINED, mode .. ": what_contact_receives joins her tree")
    t.same_list(tree.forest_paths(fresh), { "home", "home/ritz", "home/ritz/programming" },
        mode .. ": her paths")

    -- and the sender's own path of names for programming is the same
    t.equal(tree.path_of_names(home, p), "home/ritz/programming", mode .. ": sender's path")

    -- take her out of ritz again: under always she keeps knowing the link
    -- from what she already holds until told otherwise; under shared-only
    -- the next messages stop saying it
    rooms.write_recipients(home, r, {})
    send_in(home, inboxes, p, chosen)
    local expected_after_leaving = {
        ["always"] = JOINED,
        ["shared-only"] = "home\n└── ritz\nprogramming\n",
    }
    t.equal(view(inboxes, "girlfriend"), expected_after_leaving[mode],
        mode .. ": girlfriend after leaving ritz and programming speaks")
end

t.finish("035-test-owner-example")
