-- 032-test-tree.lua — tests the sender's own tree: children, ancestors,
-- the path of names, the `where` notes, and moving rooms.
--
-- Builds small trees of rooms in a scratch home folder in RAM, changes
-- names and parents the way a person would, and checks that every answer
-- and every `where` note follows.  Also breaks the tree on purpose (a
-- parent that is not there, parents in a ring, a name with a slash) and
-- checks that each is reported rather than quietly worked around.
--
-- Run: luajit 032-test-tree.lua [DIR] stand-in|real

local DIR = "/home/ritz/programs/rao-chat"
-- a project folder given first: use it; otherwise the one above
if arg[1] and arg[1] ~= "" then
    DIR = arg[1]
end

local t = dofile(DIR .. "/src/room-tree/tests/031-test-support.lua")
local rooms, tree = t.setup(DIR, arg[2])

-- {{{ local function make
local function make(home, name, parent_id, recipients)
    return rooms.create_room(home, { name = name, parent_id = parent_id, recipients = recipients })
end
-- }}}

-- {{{ local function write_raw
-- Writes a room file behind the modules' backs, to damage the tree.
local function write_raw(home, id, file, text)
    local f = assert(io.open(rooms.room_dir(home, id) .. "/" .. file, "w"))
    f:write(text)
    f:close()
end
-- }}}

-- ---- the owner's three rooms, from the sender's side
local home = t.fresh_home(rooms, "tree")
local h = make(home, "home", "", { "girlfriend", "sister" })
local r = make(home, "ritz", h, {})
local p = make(home, "programming", r, { "girlfriend", "friend" })
local other = make(home, "other", "", { "friend" })

t.same_list(tree.ancestors(home, p), { h, r, p }, "ancestors of programming: home, ritz, programming")
t.same_list(tree.ancestors(home, h), { h }, "ancestors of a top room: itself")
t.same_list(tree.children_of(home, h), { r }, "children of home: ritz")
t.same_list(tree.children_of(home, p), {}, "children of programming: none")
t.equal(tree.path_of_names(home, p), "home/ritz/programming", "path of names")

-- where is written on creation, because loading 021 listens on the bell
local w = tree.read_where(home, p)
t.equal(w.names, "home/ritz/programming", "where names written on create")
t.equal(w.folder, rooms.room_dir(home, p), "where folder is the room's own folder")
t.equal(tree.read_where(home, other).names, "other", "where of a lone top room")

-- the file itself is two key = value lines
local f = assert(io.open(rooms.room_dir(home, r) .. "/where"))
local raw = f:read("*a")
f:close()
t.equal(raw, "folder = " .. rooms.room_dir(home, r) .. "\nnames = home/ritz\n", "where file shape")

-- renaming a room rewrites it and everything below
rooms.write_name(home, r, "ritz-stuff")
t.equal(tree.read_where(home, r).names, "home/ritz-stuff", "rename rewrites the room's where")
t.equal(tree.read_where(home, p).names, "home/ritz-stuff/programming", "rename rewrites where below")
t.equal(tree.read_where(home, h).names, "home", "rename leaves the room above alone")
rooms.write_name(home, r, "ritz")

-- a name holding "=" is fine (only the first " = " splits)
rooms.write_name(home, other, "a = b")
t.equal(tree.read_where(home, other).names, "a = b", "a name holding = survives where")
rooms.write_name(home, other, "other")

-- moving: programming to the top, and back
tree.move_room(home, p, "")
t.equal(tree.path_of_names(home, p), "programming", "moved to the top")
t.equal(tree.read_where(home, p).names, "programming", "where follows a move to the top")
tree.move_room(home, p, r)
t.equal(tree.read_where(home, p).names, "home/ritz/programming", "where follows a move back")

-- moving a room with children carries them: ritz under other
tree.move_room(home, r, other)
t.equal(tree.read_where(home, p).names, "other/ritz/programming", "a move carries the rooms below")
t.same_list(tree.children_of(home, h), {}, "home has no children after ritz left")
tree.move_room(home, r, h)

-- refused moves
t.refuses(function() tree.move_room(home, h, h) end, "inside itself", "move into itself refused")
t.refuses(function() tree.move_room(home, h, p) end, "which is inside it", "move into a grandchild refused")
t.refuses(function() tree.move_room(home, r, p) end, "which is inside it", "move into a child refused")
t.refuses(function() tree.move_room(home, p, string.rep("0", 32)) end, "not on disk", "move into a missing room refused")
t.refuses(function() tree.move_room(home, string.rep("0", 32), h) end, "not on disk", "moving a missing room refused")
t.equal(tree.path_of_names(home, p), "home/ritz/programming", "refused moves changed nothing")

-- write_where on demand, and for the whole home
os.remove(rooms.room_dir(home, p) .. "/where")
t.refuses(function() tree.read_where(home, p) end, "no where file", "a missing where file is reported")
tree.write_all_where(home)
t.equal(tree.read_where(home, p).names, "home/ritz/programming", "write_all_where restores it")

-- deep tree: 30 levels, then a rename at the top reaches the bottom
local deep_home = t.fresh_home(rooms, "deep")
local top = make(deep_home, "d0", "", { "friend" })
local last = top
for level = 1, 30 do
    last = make(deep_home, "d" .. level, last, { "friend" })
end
t.equal(#tree.ancestors(deep_home, last), 31, "31 ancestors at depth 30")
rooms.write_name(deep_home, top, "root")
t.equal(tree.read_where(deep_home, last).names:sub(1, 8), "root/d1/", "a rename at the top reaches depth 30")

-- ---- damage, reported not hidden
local bad = t.fresh_home(rooms, "damage")
local a = make(bad, "a", "", { "friend" })
local b = make(bad, "b", a, { "friend" })
local c = make(bad, "c", b, { "friend" })

-- a parent that is not on disk: 101's rooms.unknown-parent decides, and is
-- read only when this happens, so unset it is a loud error
write_raw(bad, c, "parent", string.rep("f", 32) .. "\n")
t.refuses(function() tree.ancestors(bad, c) end, "rooms.unknown-parent", "unset rooms.unknown-parent is an error")
rooms.set_config(bad, "rooms.unknown-parent", "sometimes")
t.refuses(function() tree.ancestors(bad, c) end, "must be keep or refuse", "misspelt rooms.unknown-parent is an error")
rooms.set_config(bad, "rooms.unknown-parent", "refuse")
t.refuses(function() tree.ancestors(bad, c) end, "not on disk", "refuse: a missing parent is reported")
t.refuses(function() tree.write_all_where(bad) end, "not on disk", "refuse: write_all_where reports it too")
rooms.set_config(bad, "rooms.unknown-parent", "keep")
t.same_list(tree.ancestors(bad, c), { c }, "keep: a room under an unheld parent is a top")
t.equal(tree.path_of_names(bad, c), "c", "keep: its path starts at itself")
tree.write_all_where(bad)
t.equal(tree.read_where(bad, c).names, "c", "keep: write_all_where treats it as a top")
write_raw(bad, c, "parent", b .. "\n")
tree.write_all_where(bad)

-- parents in a ring (a inside b inside a), written behind the modules' backs
write_raw(bad, a, "parent", b .. "\n")
t.refuses(function() tree.ancestors(bad, c) end, "ring", "a ring of parents is reported")
t.refuses(function() tree.path_of_names(bad, c) end, "ring", "path of names reports the ring")
write_raw(bad, a, "parent", "")

-- a "/" in a name: 101's rooms.slash-in-name decides.  refuse: the rename
-- is refused (by 101, or by the where-rewrite with the stand-in); a "/"
-- written behind the modules' backs is reported by path_of_names.
rooms.set_config(bad, "rooms.slash-in-name", "refuse")
t.refuses(function() rooms.write_name(bad, b, "x/y") end, "rooms.slash-in-name = refuse", "refuse: a name with a slash")
write_raw(bad, b, "name", "x/y\n")
t.refuses(function() tree.path_of_names(bad, c) end, "rooms.slash-in-name = refuse", "refuse: path of names reports a slash on disk")
-- allow: the name is escaped in paths, and splits back
rooms.set_config(bad, "rooms.slash-in-name", "allow")
rooms.write_name(bad, b, "x/y")
t.equal(tree.path_of_names(bad, c), "a/x\\/y/c", "allow: the slash is escaped in the path")
t.equal(tree.read_where(bad, c).names, "a/x\\/y/c", "allow: where holds the escaped path")
local where_file = require("022-where-file")
t.same_list(where_file.split_path(tree.read_where(bad, c).names), { "a", "x/y", "c" }, "allow: the path splits back")
rooms.write_name(bad, b, "back\\slash")
t.same_list(where_file.split_path(tree.path_of_names(bad, c)), { "a", "back\\slash", "c" }, "a backslash round-trips")
rooms.write_name(bad, b, "b")

-- the reader's home: with keep, a room arrives naming a parent not yet
-- held; when that parent arrives (made with its own id), the tree joins
-- by itself, because "created" rewrites where for everything below it
local reader = t.fresh_home(rooms, "reader-home")
rooms.set_config(reader, "rooms.unknown-parent", "keep")
local ritz_id = rooms.new_room_id()
local prog = rooms.create_room(reader, { name = "programming", parent_id = ritz_id, recipients = { "owner" } })
t.equal(tree.read_where(reader, prog).names, "programming", "reader: programming alone while ritz is unheld")
rooms.create_room(reader, { name = "ritz", parent_id = "", recipients = { "owner" }, room_id = ritz_id })
t.equal(tree.read_where(reader, prog).names, "ritz/programming", "reader: joins when ritz arrives")
t.same_list(tree.ancestors(reader, prog), { ritz_id, prog }, "reader: ancestors after joining")

-- the bell with a kind of change nobody agreed on
t.refuses(function() rooms.notify(bad, a, "painted") end, "unknown kind", "unknown bell kind reported")
-- kinds that do not touch where are accepted quietly
rooms.notify(bad, a, "log")
rooms.notify(bad, a, "recipients")
t.check(true, "log and recipients bells accepted")

t.finish("032-test-tree")
