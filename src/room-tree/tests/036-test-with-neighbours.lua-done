-- 036-test-with-neighbours.lua — the room tree working alongside the real
-- neighbouring modules: room folders (101), recipients (103), people links
-- (104) and the message log (105).
--
-- Only meaningful against the real modules, so it refuses to run on the
-- stand-in.  It loads all five, sets every config key they read, and then:
--   * splits a room that has a room inside it, in both split shapes, and
--     checks that the room inside still knows its place (its ancestors and
--     its `where` note follow the room it now hangs under);
--   * compares, for the owner's example, the people-links module's "top
--     rooms this person is in" with the tops of the trees this module says
--     that person sees — two ways of asking one question, which must agree.
--
-- Run: luajit 036-test-with-neighbours.lua [DIR] real

local DIR = "/home/ritz/programs/rao-chat"
-- a project folder given first: use it; otherwise the one above
if arg[1] and arg[1] ~= "" then
    DIR = arg[1]
end

-- the stand-in has no neighbours to meet: running this on it is a mistake
if arg[2] ~= "real" then
    error("036-test-with-neighbours runs only against the real modules (second argument: real)")
end

local t = dofile(DIR .. "/src/room-tree/tests/031-test-support.lua")
local rooms, tree = t.setup(DIR, "real")
local recipients = require("041-recipients")
local people = require("061-people-links")
require("081-message-log")

-- One value for every config key the five modules read (as in 101's
-- neighbour test).  A key missing here shows up as an error naming it.
local SETTINGS = {
    ["rooms.unknown-parent"]      = "refuse",
    ["rooms.slash-in-name"]       = "refuse",
    ["tree.parent-disclosure"]    = "shared-only",
    ["recipients.split-shape"]    = "fork",
    ["recipients.arrival-list"]   = "adder-list",
    ["recipients.split-parent"]   = "keep",
    ["recipients.split-alone"]    = "keep-empty",
    ["people.link-collision"]     = "suffix-id",
    ["people.own-devices"]        = "none",
    ["people.split-records"]      = "hide",
    ["people.slash-in-link-name"] = "percent",
    ["log.record-shape"]          = "tsv",
    ["log.shape-mixing"]          = "fixed",
    ["log.duplicate-check"]       = "scan",
    ["log.edits"]                 = "never",
}

-- {{{ local function new_home
local function new_home(name)
    local home = t.fresh_home(rooms, name)
    for key, value in pairs(SETTINGS) do
        rooms.set_config(home, key, value)
    end
    local f = assert(io.open(home.dir .. "/contacts", "w"))
    f:write("girlfriend.token = g\nsister.token = s\nfriend.token = f\nphone.own = true\n")
    f:close()
    return home
end
-- }}}

-- {{{ local function sorted
local function sorted(list)
    local copy = {}
    for i, v in ipairs(list) do
        copy[i] = v
    end
    table.sort(copy)
    return copy
end
-- }}}

-- {{{ local function forest_tops
local function forest_tops(forest)
    local ids = {}
    for _, node in ipairs(forest) do
        ids[#ids + 1] = node.room_id
    end
    return ids
end
-- }}}

-- ---- a split of a room with a room inside it, both shapes
for _, shape in ipairs({ "fork", "rekey" }) do
    local home = new_home("neighbours-split-" .. shape)
    local h = rooms.create_room(home, { name = "home", parent_id = "", recipients = { "girlfriend", "sister" } })
    local r = rooms.create_room(home, { name = "ritz", parent_id = h, recipients = { "girlfriend", "sister" } })
    local p = rooms.create_room(home, { name = "programming", parent_id = r, recipients = { "friend" } })

    local ok, now = pcall(recipients.split_on_removal, home, r, "girlfriend", shape)
    t.check(ok, shape .. ": split of ritz went through" .. (ok and "" or (": " .. tostring(now))))
    -- the split ran: check where programming now hangs; it did not: the
    -- failure above says why, and the rest would only repeat it
    if ok then
        t.check(now ~= r, shape .. ": a new room id to talk in")
        t.same_list(tree.ancestors(home, p), { h, now, p }, shape .. ": programming now hangs under the new ritz")
        t.equal(tree.read_where(home, p).names, "home/ritz/programming", shape .. ": programming's where")
        t.equal(tree.read_where(home, now).folder, rooms.room_dir(home, now), shape .. ": new ritz's where names its own folder")
    end
end

-- ---- people links and the reader's forest agree on top rooms
for _, mode in ipairs({ "always", "shared-only" }) do
    local home = new_home("neighbours-tops-" .. mode)
    rooms.set_config(home, "tree.parent-disclosure", mode)
    local h = rooms.create_room(home, { name = "home", parent_id = "", recipients = { "girlfriend", "sister" } })
    local r = rooms.create_room(home, { name = "ritz", parent_id = h, recipients = {} })
    local p = rooms.create_room(home, { name = "programming", parent_id = r, recipients = { "girlfriend", "friend" } })

    for _, contact in ipairs({ "girlfriend", "friend", "sister" }) do
        local forest = tree.visible_forest(tree.what_contact_receives(home, contact, mode))
        t.same_list(sorted(forest_tops(forest)), sorted(people.top_rooms_for(home, contact)),
            mode .. ": " .. contact .. "'s tops agree with people links")
    end

    recipients.add(home, r, "girlfriend")
    local forest = tree.visible_forest(tree.what_contact_receives(home, "girlfriend", mode))
    t.same_list(forest_tops(forest), { h }, mode .. ": girlfriend added to ritz sees one tree")
    t.same_list(sorted(people.top_rooms_for(home, "girlfriend")), { h }, mode .. ": people links agree")
end

t.finish("036-test-with-neighbours")
