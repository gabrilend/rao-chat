-- 022-where-file.lua — the small `where` file kept inside every room folder.
--
-- Rooms are stored flat on disk, one folder per room id, so a folder's
-- location says nothing about which rooms it sits inside.  The owner asked
-- that a room's real folder on disk and its path of names from the top
-- ("home/ritz/programming") both be kept right beside the room, as easy to
-- read as its name.  This file knows only how that note is written and read
-- back; deciding what goes in it is the room tree's job (021).
--
-- The file is two "key = value" lines, the same shape as the config file,
-- so it can be read with cat and parsed by the same eye:
--
--   folder = /home/you/rao-home/rooms/3f2a...e1
--   names = home/ritz/programming
--
-- Only the first " = " on a line separates key from value, so a room name
-- holding "=" survives.  A line break in a name is refused by the room
-- folders module (101) before anything reaches here.
--
-- A "/" in a name is allowed only when the owner has set
-- rooms.slash-in-name = allow (101's choice).  Then, so the names line can
-- still be split back into its steps, each name is written into a path
-- with "\" doubled and "/" written as "\/": a room called "a/b" inside
-- "home" is "home/a\/b".  With no "/" or "\" in any name the path is
-- exactly the names joined with "/", which is every path under the
-- refuse setting.

local M = {}

-- {{{ function M.path_step
-- One name as it appears in a path of names (see the note above).
function M.path_step(name)
    return (name:gsub("\\", "\\\\"):gsub("/", "\\/"))
end
-- }}}

-- {{{ function M.split_path
-- The reverse of joining path steps: "home/a\/b" gives { "home", "a/b" }.
-- For readers of `where` and for tests; nothing in the tree needs it.
function M.split_path(path)
    local steps = {}
    local current = {}
    local position = 1
    while position <= #path do
        local c = path:sub(position, position)
        -- a backslash: the next character is part of the name as written
        -- a slash: the end of one step
        -- anything else: part of the name
        if c == "\\" then
            current[#current + 1] = path:sub(position + 1, position + 1)
            position = position + 2
        elseif c == "/" then
            steps[#steps + 1] = table.concat(current)
            current = {}
            position = position + 1
        else
            current[#current + 1] = c
            position = position + 1
        end
    end
    steps[#steps + 1] = table.concat(current)
    return steps
end
-- }}}

-- {{{ local function where_path
local function where_path(room_dir)
    return room_dir .. "/where"
end
-- }}}

-- {{{ function M.write
-- room_dir: string, the room's folder.  names: string, the path of names.
-- The folder line records room_dir itself, so the file always names the
-- folder it is in, even after the home folder has been moved and rewritten.
function M.write(room_dir, names)
    local f = assert(io.open(where_path(room_dir), "w"))
    f:write("folder = " .. room_dir .. "\n")
    f:write("names = " .. names .. "\n")
    f:close()
end
-- }}}

-- {{{ function M.read
-- Gives { folder = string, names = string }.  A missing file, or one
-- lacking either line, is an error: it means the room tree was not loaded
-- when the room was made or last changed, and that should be found, not
-- papered over.
function M.read(room_dir)
    local f = io.open(where_path(room_dir), "r")
    -- no where file: say which room and why it matters
    if not f then
        error("room-tree: no where file in " .. room_dir
            .. " (was the room tree loaded when this room was made?)")
    end
    local fields = {}
    for line in f:lines() do
        local key, value = line:match("^(.-) = (.*)$")
        -- a key = value line is kept; any other line is a damaged file
        if key then
            fields[key] = value
        else
            f:close()
            error("room-tree: unreadable line in " .. where_path(room_dir) .. ": " .. line)
        end
    end
    f:close()
    -- both lines must be there; a half-written file is an error
    if fields.folder == nil or fields.names == nil then
        error("room-tree: where file in " .. room_dir .. " is missing folder or names")
    end
    return { folder = fields.folder, names = fields.names }
end
-- }}}

return M
