-- 023-reader-forest.lua — the reader's side of the room tree: which trees a
-- person sees, given only the rooms that have reached them.
--
-- A reader never sees the sender's disk.  All they have is the rooms whose
-- messages reached them, each with the name they call it by and whatever
-- parent room id the sender chose to say (open question 3; see 021's
-- parent_to_disclose).  This file joins those rooms up: a room whose said
-- parent is also one of the reader's rooms hangs under it; a room whose
-- parent was not said, or was said but never reached the reader, stands at
-- the top of a tree of its own.  That is how the owner's girlfriend, in
-- `home` and `programming` but not `ritz`, sees two trees, and how the gap
-- closes the moment `ritz` reaches her.
--
-- The whole forest is rebuilt from the list each time; nothing is kept
-- between calls.  This is only the making of the trees; drawing them as
-- text is 024's job.
--
-- Input, one entry per room received (a list):
--   { room_id = string (32 hex), name = string (the reader's own name for
--     it), disclosed_parent_id = string (a room id, or "" when none said) }
--
-- Output, a list of top nodes, each node:
--   { room_id = string, name = string, disclosed_parent_id = string,
--     parent_unseen = bool   -- true when a parent id was said but that room
--                            -- has not reached this reader: they know a
--                            -- room exists above, and nothing else about it
--     children = list of nodes }
-- Top nodes and every children list are sorted by name, then room id, so
-- two readers with the same rooms see the same order.

local where_file = require("022-where-file")

local M = {}

-- {{{ local function check_entry
-- A received entry missing a field is a mistake by whoever built the list;
-- say which entry and which field instead of guessing.
local function check_entry(entry, position)
    for _, field in ipairs({ "room_id", "name", "disclosed_parent_id" }) do
        -- present and a string: fine; otherwise: stop here
        if type(entry[field]) ~= "string" then
            error("room-tree: received entry " .. position .. " has no string " .. field)
        end
    end
    -- a room naming itself as parent is a loop of one
    if entry.disclosed_parent_id == entry.room_id then
        error("room-tree: received room " .. entry.room_id .. " names itself as its parent")
    end
end
-- }}}

-- {{{ local function by_name_then_id
local function by_name_then_id(a, b)
    -- different names: alphabetical by name; same name: by room id
    if a.name ~= b.name then
        return a.name < b.name
    end
    return a.room_id < b.room_id
end
-- }}}

-- {{{ local function sort_tree
local function sort_tree(nodes)
    table.sort(nodes, by_name_then_id)
    for _, node in ipairs(nodes) do
        sort_tree(node.children)
    end
end
-- }}}

-- {{{ local function count_nodes
local function count_nodes(nodes)
    local total = 0
    for _, node in ipairs(nodes) do
        total = total + 1 + count_nodes(node.children)
    end
    return total
end
-- }}}

-- {{{ function M.visible_forest
function M.visible_forest(received)
    local by_id = {}
    for position, entry in ipairs(received) do
        check_entry(entry, position)
        -- the same room twice means the caller did not keep one entry per
        -- room (the latest disclosure should replace the older one)
        if by_id[entry.room_id] then
            error("room-tree: room " .. entry.room_id .. " received twice in one list")
        end
        by_id[entry.room_id] = {
            room_id = entry.room_id,
            name = entry.name,
            disclosed_parent_id = entry.disclosed_parent_id,
            parent_unseen = false,
            children = {},
        }
    end

    local tops = {}
    for _, entry in ipairs(received) do
        local node = by_id[entry.room_id]
        local parent = by_id[node.disclosed_parent_id]
        -- the said parent reached this reader too: hang under it
        -- no parent said: a top room, nothing more is known
        -- a parent said but never received: a top room that knows it has
        --   something above it
        if parent then
            parent.children[#parent.children + 1] = node
        elseif node.disclosed_parent_id == "" then
            tops[#tops + 1] = node
        else
            node.parent_unseen = true
            tops[#tops + 1] = node
        end
    end

    -- Rooms that each name another as parent in a ring (a said to be in b,
    -- b in a) never reach a top, so they would silently vanish.  Counting
    -- what the tops reach catches that.
    local reached = count_nodes(tops)
    -- every room reached from a top: a proper forest; some missing: a ring
    if reached ~= #received then
        error("room-tree: " .. (#received - reached)
            .. " received rooms name each other as parents in a ring")
    end

    sort_tree(tops)
    return tops
end
-- }}}

-- {{{ local function collect_paths
-- Walks the trees top-down, adding each room's path to `paths` (a list).
local function collect_paths(nodes, prefix, paths)
    for _, node in ipairs(nodes) do
        local path = prefix .. where_file.path_step(node.name)
        paths[#paths + 1] = path
        collect_paths(node.children, path .. "/", paths)
    end
end
-- }}}

-- {{{ function M.forest_paths
-- Every room in the forest as its path of names from the top of the tree
-- it is in, e.g. { "home", "programming" } or { "home", "home/ritz",
-- "home/ritz/programming" }, in drawing order.  Paths are what a reader
-- would see in the room's title; they are data, so tests compare them.
-- A "/" inside a name is written "\/" (see 022), as in the `where` file.
function M.forest_paths(forest)
    local paths = {}
    collect_paths(forest, "", paths)
    return paths
end
-- }}}

return M
