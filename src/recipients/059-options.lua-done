-- 059-options.lua — the undecided choices in the recipients module, written
-- down for the options tally (scripts/tally-options, issue 106).
--
-- Each entry is one question the owner (or some later state of the project)
-- has to settle.  Every variant listed is built and tested; the home's
-- config file picks the one in use.  The "findings" are what building and
-- testing each variant actually showed, so the choice can be made on facts.
-- Plain data: nothing here runs.

return {
    {
        id = "recipients-arrival-list",
        question = "When a message arrives in a room you have never seen, whom do your replies there go to?",
        waits_on = "owner",
        detail = "open question 2",
        config_key = "recipients.arrival-list",
        variants = {
            {
                name = "adder-only",
                summary = "Just the person whose message made the room.",
                built_in = "src/recipients/041-recipients.lua (arrival_lists)",
                tests = "tests/048-test-arrival.lua, tests/049-test-six-become-two-fives.lua",
                findings = "Needs nothing carried with the message. In the six-person example, each of the four "
                    .. "people in the middle sees p2's split room as a room of two (p2 and themself): "
                    .. "their replies reach p2 only, so the four never hear each other there unless "
                    .. "they add each other by hand. The room p2 sees as five people is a star around p2 "
                    .. "for everyone else.",
            },
            {
                name = "heard-from",
                summary = "The sender, then everyone you receive a message from in that room.",
                built_in = "src/recipients/041-recipients.lua (hear_from_authors, on the bell's \"log\")",
                tests = "tests/048-test-arrival.lua, tests/049-test-six-become-two-fives.lua",
                findings = "Needs nothing carried, but grows only as people speak to you, and people who "
                    .. "arrived under adder-only/heard-from themselves only send to the person who "
                    .. "added them, so in the six-person example the four in the middle still see p2's "
                    .. "room as two people after the first message. Without a 'declined' record a person "
                    .. "you removed is re-added the next time they speak, and after a split the remover "
                    .. "is re-added when the log is copied; both needed the declined lines in the arrival "
                    .. "marker. The whole log is re-read on each ring (cost grows with log length).",
            },
            {
                name = "adder-list",
                summary = "The sender's own list, carried with the message, minus you, plus the sender.",
                built_in = "src/recipients/041-recipients.lua (list_from_carried)",
                tests = "tests/048-test-arrival.lua, tests/049-test-six-become-two-fives.lua",
                findings = "The only mode that reproduces the owner's example exactly: each of the four in "
                    .. "the middle sees p2's room as the same five people p2 does. Costs: every message "
                    .. "must carry its sender's list (a phase 2 wire-format change, and it tells each "
                    .. "reader who else the sender writes to); names must be translated from the sender's "
                    .. "names to the reader's (built here as already-translated, reader written 'me'); "
                    .. "names the reader has no contact for are left out and handed back. Combined with "
                    .. "the rekey split it undoes the split: a third person's message into the old room "
                    .. "re-creates it at the removed person's server with the remover back on the list.",
            },
        },
        leaning = "adder-list, because it is the only one where 'everyone else is listening eagerly' "
            .. "gives everyone the same room; pair it with the fork split, not rekey.",
    },
    {
        id = "recipients-split-shape",
        question = "When you are removed and your copy of the room becomes its own room, how is that stored?",
        waits_on = "owner",
        detail = "issue 103: 'Being removed splits the room' (planning document section 3); not yet asked",
        config_key = "recipients.split-shape",
        variants = {
            {
                name = "fork",
                summary = "A new room id; name, parent and log copied; the old room kept read-only as the record.",
                built_in = "src/recipients/041-recipients.lua (split_by_fork)",
                tests = "tests/047-test-split.lua, tests/049-test-six-become-two-fives.lua",
                findings = "The log exists twice (disk cost equal to the room's history). The old id stays "
                    .. "known, so a third person who still writes into the shared room is followed through "
                    .. "the record (live_room_for) into your room: in the six-person example p3's message "
                    .. "in the shared room lands in p2's new room. Records chain correctly through repeated "
                    .. "splits. The record keeps its old recipients list, so a people/ view built from "
                    .. "lists (104) will still show the record under the remover unless it skips rooms "
                    .. "with a split marker.",
            },
            {
                name = "rekey",
                summary = "The room's folder renamed to a new id in place; the old id is gone from this server.",
                built_in = "src/recipients/041-recipients.lua (split_by_rekey)",
                tests = "tests/047-test-split.lua, tests/049-test-six-become-two-fives.lua",
                findings = "No copy; one rename. But the server forgets the shared room's id, so the next "
                    .. "message a third person writes into the shared room makes a fresh room of that id "
                    .. "on arrival (six-person example: p2 ends with two rooms, one holding only p3's "
                    .. "message), and under adder-list that fresh room has the remover back on it. "
                    .. "people/ links pointing at the old folder break until 104 relinks on the bell.",
            },
        },
        leaning = "fork: forgetting the old id makes the split leak back open through third parties.",
    },
    {
        id = "recipients-split-parent",
        question = "When your copy of a room splits off, does it stay under the same parent room, or become a top room?",
        waits_on = "owner",
        detail = "issue 103, open question found while writing",
        config_key = "recipients.split-parent",
        variants = {
            {
                name = "keep",
                summary = "Same parent as before, so your tree looks unchanged.",
                built_in = "src/recipients/041-recipients.lua (split_parent_for)",
                tests = "tests/047-test-split.lua",
                findings = "Nothing moves on screen. Under rekey no parent write happens (no bell ring for parent).",
            },
            {
                name = "top",
                summary = "The split room becomes a top room.",
                built_in = "src/recipients/041-recipients.lua (split_parent_for)",
                tests = "tests/047-test-split.lua",
                findings = "The room jumps out of its folder in your tree even though you did nothing; "
                    .. "its child rooms still follow it (children are always re-parented to the new room).",
            },
        },
        leaning = "keep: the split is about who hears you, not where you filed the room.",
    },
    {
        id = "recipients-split-alone",
        question = "If the remover was the only person you sent to (a room of two), what does the split leave you?",
        waits_on = "owner",
        detail = "issue 103, found while writing: a room is at least two people, but a split of a room of two leaves one",
        config_key = "recipients.split-alone",
        variants = {
            {
                name = "keep-empty",
                summary = "Split as usual; the new room has an empty list until you add someone.",
                built_in = "src/recipients/041-recipients.lua (split_alone_modes)",
                tests = "tests/047-test-split.lua",
                findings = "Breaks the two-person floor (a room with nobody to send to); needs 101's "
                    .. "create_room/write_recipients to accept an empty list. The room can be refilled with add.",
            },
            {
                name = "record-only",
                summary = "No new room; the room becomes a read-only record and split_on_removal returns \"\".",
                built_in = "src/recipients/041-recipients.lua (split_alone_modes)",
                tests = "tests/047-test-split.lua",
                findings = "Keeps the floor. Under rekey the old id is kept (as a record) rather than "
                    .. "renamed, since there is nothing to rename it to. You cannot continue the "
                    .. "conversation with anyone else from that room; you start a new one.",
            },
        },
        leaning = "record-only: it keeps the two-person rule true everywhere.",
    },
    {
        id = "recipients-arrival-room-name",
        question = "What is a room made on arrival called before you rename it?",
        waits_on = "owner",
        detail = "issue 103, found while writing: names never travel (planning document section 3)",
        config_key = "",
        variants = {
            {
                name = "from-<sender>",
                summary = "Named after the person whose message made it.",
                built_in = "src/recipients/041-recipients.lua (room_from_arrival)",
                tests = "tests/048-test-arrival.lua",
                findings = "Two rooms made by the same sender get the same name (allowed: names belong "
                    .. "to the reader and need not be unique). The only variant built.",
            },
        },
        leaning = "from-<sender> until phase 2 decides whether a suggested name may travel.",
    },
    {
        id = "recipients-arrival-parent",
        question = "Where in your tree does a room made on arrival go?",
        waits_on = "state",
        detail = "open question 3 (issue 102's tree.parent-disclosure) and phase 2's wire format",
        config_key = "",
        variants = {
            {
                name = "top",
                summary = "Always a top room for now.",
                built_in = "src/recipients/041-recipients.lua (room_from_arrival)",
                tests = "tests/048-test-arrival.lua",
                findings = "Correct until a message can carry a disclosed parent id; then a room whose "
                    .. "disclosed parent you have should be placed under it (102's visible_forest).",
            },
        },
        leaning = "top until phase 2 carries the disclosed parent.",
    },
}
