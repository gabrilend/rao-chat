-- 041-recipients.lua — who your messages in a room go to, and what happens
-- when someone takes you off theirs.
--
-- Every room on your home server keeps a list of the people your messages
-- there are sent to.  This module is the only thing that edits that list by
-- the rules of rao-chat:
--
--   * Adding someone means your messages there reach them from now on; they
--     must be one of your contacts, and not one of your own devices.
--   * Removing someone means your messages stop reaching them; you can never
--     remove the last person, because a room is at least two people.
--   * When you are told that someone removed you, your copy of the room
--     becomes a room of its own (a "split"), keeping everything you had
--     received, with the remover off your list.  Everyone else still hears
--     both rooms.  The split can be shaped two ways (fork / rekey).
--   * When a message arrives in a room you have never seen, the room is made
--     for you, and who your replies go to is chosen one of three ways
--     (adder-only / heard-from / adder-list).
--
-- The owner has not chosen between the shapes yet, so all of them are built
-- and each call says which one it wants; the home's config file names the
-- one in use (read through configured_split_shape / configured_arrival_list).
--
-- Two small marker files are kept inside a room's folder by this module
-- (both are "key = value" lines, like rmail's config):
--
--   rooms/<id>/split     only on a room kept as a read-only record after a
--                        fork split, or on a room that became read-only
--                        because nobody was left to talk to:
--                          into    = <room id you now talk in, or empty>
--                          remover = <contact who removed you>
--                          shape   = fork | rekey
--   rooms/<id>/arrival   only on a room that was made because a message
--                        arrived in it:
--                          mode     = adder-only | heard-from | adder-list
--                          sender   = <contact whose message made it>
--                          declined = <contact>   (repeatable) people the
--                                     heard-from mode must never re-add,
--                                     because you removed them or they
--                                     removed you
--
-- Data-making only: nothing here prints or draws.

local rooms = require("002-room-folders")

local M = {}

-- 105 (the message log) is loaded only when first needed: the log module is
-- built alongside this one and loading it at the top would make this module
-- unusable in any program that does not have it yet.
-- {{{ local function message_log
local function message_log()
    return require("081-message-log")
end
-- }}}

-- ---------------------------------------------------------------------
-- small file helpers
-- ---------------------------------------------------------------------

-- {{{ local function read_pairs
-- Reads a "key = value" file into an ordered list of {key, value} pairs.
-- A list, not a table keyed by name, because "declined" repeats.
local function read_pairs(path)
    local file = assert(io.open(path, "r"))
    local pairs_list = {}
    for line in file:lines() do
        local key, value = line:match("^%s*([%w%-_%.]+)%s*=%s*(.-)%s*$")
        -- a line that is not key = value is a broken marker: stop loudly
        -- rather than guess what it meant
        if key == nil then
            file:close()
            error("recipients: unreadable line in " .. path .. ": " .. line)
        end
        pairs_list[#pairs_list + 1] = { key, value }
    end
    file:close()
    return pairs_list
end
-- }}}

-- {{{ local function write_pairs
local function write_pairs(path, pairs_list)
    local file = assert(io.open(path, "w"))
    for _, pair in ipairs(pairs_list) do
        file:write(pair[1], " = ", pair[2], "\n")
    end
    file:close()
end
-- }}}

-- {{{ local function file_exists
local function file_exists(path)
    local file = io.open(path, "r")
    -- present: close it and say so; absent: io.open gave nothing back
    if file then
        file:close()
        return true
    end
    return false
end
-- }}}

-- {{{ local function first_value
-- The value of the first pair named key; errors when there is none, since
-- every caller asks only for keys the marker is always written with.
local function first_value(pairs_list, key, path)
    for _, pair in ipairs(pairs_list) do
        if pair[1] == key then
            return pair[2]
        end
    end
    error("recipients: " .. path .. " has no " .. key .. " line")
end
-- }}}

-- {{{ local function all_values
local function all_values(pairs_list, key)
    local values = {}
    for _, pair in ipairs(pairs_list) do
        if pair[1] == key then
            values[#values + 1] = pair[2]
        end
    end
    return values
end
-- }}}

-- {{{ local function contains
local function contains(list, item)
    for _, entry in ipairs(list) do
        if entry == item then
            return true
        end
    end
    return false
end
-- }}}

-- {{{ local function without
-- A copy of list with every entry equal to item left out.
local function without(list, item)
    local kept = {}
    for _, entry in ipairs(list) do
        if entry ~= item then
            kept[#kept + 1] = entry
        end
    end
    return kept
end
-- }}}

-- {{{ local function split_marker_path
local function split_marker_path(home, room_id)
    return rooms.room_dir(home, room_id) .. "/split"
end
-- }}}

-- {{{ local function arrival_marker_path
local function arrival_marker_path(home, room_id)
    return rooms.room_dir(home, room_id) .. "/arrival"
end
-- }}}

-- ---------------------------------------------------------------------
-- checks shared by every edit
-- ---------------------------------------------------------------------

-- {{{ local function check_contact
-- A recipient must be someone in the contacts file, and not one of your own
-- devices: a phone or browser paired with your own server already sees every
-- room, so "sending" to it would be a second copy of your own words.
-- The contacts file stores every field as text, so own is the string "true".
local function check_contact(home, contact)
    local contacts = rooms.read_contacts(home)
    local entry = contacts[contact]
    -- not in the contacts file: nobody to send to
    if entry == nil then
        error("recipients: " .. tostring(contact) .. " is not a contact")
    end
    -- marked own = true: one of your devices, never a recipient
    if entry.own == "true" then
        error("recipients: " .. contact .. " is one of your own devices, not a recipient")
    end
end
-- }}}

-- {{{ local function check_room_writable
-- A room kept as the record of a fork split is read-only: its list is the
-- list as it stood when you were removed, kept so the history reads true.
local function check_room_writable(home, room_id)
    -- the room must exist; a missing room is a caller's mistake
    if not rooms.room_exists(home, room_id) then
        error("recipients: no room " .. tostring(room_id))
    end
    -- a split marker means this is a record, not a room you talk in
    if file_exists(split_marker_path(home, room_id)) then
        error("recipients: room " .. room_id .. " was split and is read-only")
    end
end
-- }}}

-- ---------------------------------------------------------------------
-- the "declined" names of a room made on arrival (heard-from mode)
-- ---------------------------------------------------------------------

-- {{{ local function change_declined
-- Adds (present = true) or takes away (present = false) one name on the
-- arrival marker's declined lines.  Rooms with no arrival marker have no
-- declined list, and nothing is written for them.
local function change_declined(home, room_id, contact, present)
    local path = arrival_marker_path(home, room_id)
    -- a room you made yourself has no arrival marker and nothing to track
    if not file_exists(path) then
        return
    end
    local kept = {}
    for _, pair in ipairs(read_pairs(path)) do
        -- drop any existing declined line for this contact; re-added below
        -- when present is asked for, so there is never a duplicate
        if not (pair[1] == "declined" and pair[2] == contact) then
            kept[#kept + 1] = pair
        end
    end
    -- asked to decline: write one line for them; asked to accept: leave out
    if present then
        kept[#kept + 1] = { "declined", contact }
    end
    write_pairs(path, kept)
end
-- }}}

-- ---------------------------------------------------------------------
-- adding and removing
-- ---------------------------------------------------------------------

-- {{{ function M.add
function M.add(home, room_id, contact)
    check_room_writable(home, room_id)
    check_contact(home, contact)
    local room = rooms.read_room(home, room_id)
    -- already on the list: adding twice is a caller's mistake, not a no-op,
    -- so a doubled tap in a client shows up instead of hiding
    if contains(room.recipients, contact) then
        error("recipients: " .. contact .. " is already a recipient of " .. room_id)
    end
    local list = {}
    for i, name in ipairs(room.recipients) do
        list[i] = name
    end
    list[#list + 1] = contact
    -- choosing to add someone lifts any earlier "never re-add" for them
    change_declined(home, room_id, contact, false)
    rooms.write_recipients(home, room_id, list)
end
-- }}}

-- {{{ function M.remove
function M.remove(home, room_id, contact)
    check_room_writable(home, room_id)
    local room = rooms.read_room(home, room_id)
    -- not on the list: nothing to stop sending to, so say so
    if not contains(room.recipients, contact) then
        error("recipients: " .. tostring(contact) .. " is not a recipient of " .. room_id)
    end
    -- the last one: a room is at least you and one other person
    if #room.recipients == 1 then
        error("recipients: cannot remove " .. contact
              .. ", the last recipient of " .. room_id .. " (a room is at least two people)")
    end
    -- the heard-from mode must not quietly add them back when they speak
    change_declined(home, room_id, contact, true)
    rooms.write_recipients(home, room_id, without(room.recipients, contact))
end
-- }}}

-- ---------------------------------------------------------------------
-- reading which variant the home is set to
-- ---------------------------------------------------------------------

-- {{{ function M.configured_split_shape
function M.configured_split_shape(home)
    return rooms.config_value(home, "recipients.split-shape")
end
-- }}}

-- {{{ function M.configured_arrival_list
function M.configured_arrival_list(home)
    return rooms.config_value(home, "recipients.arrival-list")
end
-- }}}

-- ---------------------------------------------------------------------
-- the split
-- ---------------------------------------------------------------------

-- Where a split room sits in your tree (config recipients.split-parent).
-- keep: under the same parent as before, so your tree looks unchanged.
-- top:  as a top room, since the room you shared is not the room you are in.
local split_parent_for = {
    ["keep"] = function(old_parent_id) return old_parent_id end,
    ["top"]  = function(old_parent_id) return "" end,
}

-- {{{ local function repoint_children
-- Rooms inside the split room are yours and keep their own lists; they move
-- to hang under the room you now talk in, so your tree stays whole.  (The
-- parent file is read directly through 101 so this does not need 102.)
local function repoint_children(home, old_id, new_id)
    for _, child_id in ipairs(rooms.list_rooms(home)) do
        -- skip the room being split itself (in rekey its old folder is gone)
        if child_id ~= old_id and child_id ~= new_id then
            local child = rooms.read_room(home, child_id)
            -- a child of the old room: move it under the new one
            if child.parent_id == old_id then
                rooms.write_parent(home, child_id, new_id)
            end
        end
    end
end
-- }}}

-- {{{ local function mark_record
-- Writes the split marker that makes a room a read-only record, then rings
-- "split" on it, so listeners that treat records differently (104's
-- people/ view) hear that the room stopped being live.
local function mark_record(home, room_id, into_id, remover, shape)
    write_pairs(split_marker_path(home, room_id), {
        { "into", into_id },
        { "remover", remover },
        { "shape", shape },
    })
    rooms.notify(home, room_id, "split")
end
-- }}}

-- {{{ local function split_by_fork
-- fork: a new room id; name, parent and log copied; the old room kept,
-- read-only, as the record of the room you shared.
local function split_by_fork(home, old_id, remover, remaining, parent_id)
    local old = rooms.read_room(home, old_id)
    local new_id = rooms.new_room_id()
    rooms.create_room(home, {
        name = old.name,
        parent_id = parent_id,
        recipients = remaining,
        room_id = new_id,
    })
    -- the arrival marker travels with the room before the log does, so the
    -- heard-from listener (which wakes on the log copy) already knows the
    -- remover is declined and does not add them straight back
    local old_arrival = arrival_marker_path(home, old_id)
    -- a room made on arrival: its mode and declined names come along;
    -- a room you made yourself: nothing to carry
    if file_exists(old_arrival) then
        write_pairs(arrival_marker_path(home, new_id), read_pairs(old_arrival))
        change_declined(home, new_id, remover, true)
    end
    message_log().copy_log(home, old_id, new_id)
    -- children move before the record is announced, so no listener sees a
    -- child hanging under a room that has just become read-only
    repoint_children(home, old_id, new_id)
    mark_record(home, old_id, new_id, remover, "fork")
    return new_id
end
-- }}}

-- {{{ local function split_by_rekey
-- rekey: the room's folder is renamed to a new id in place; the old id is
-- gone from this server.  Nothing is copied; the bell says the old room was
-- removed and a new one created, so 102 rewrites `where` and 104 relinks.
local function split_by_rekey(home, old_id, remover, remaining, parent_id)
    local new_id = rooms.new_room_id()
    local renamed, why = os.rename(rooms.room_dir(home, old_id), rooms.room_dir(home, new_id))
    -- a rename that fails leaves the old room untouched; stop loudly
    if not renamed then
        error("recipients: could not rename room " .. old_id .. ": " .. tostring(why))
    end
    -- children are repointed before any bell rings, so no listener (102's
    -- where-writer, 104's links) ever sees a child whose parent is gone
    repoint_children(home, old_id, new_id)
    rooms.notify(home, old_id, "removed-room")
    rooms.notify(home, new_id, "created")
    change_declined(home, new_id, remover, true)
    rooms.write_recipients(home, new_id, remaining)
    -- only write the parent when it changes, so the bell rings only for a
    -- real move
    if rooms.read_room(home, new_id).parent_id ~= parent_id then
        rooms.write_parent(home, new_id, parent_id)
    end
    return new_id
end
-- }}}

local split_shapes = {
    ["fork"]  = split_by_fork,
    ["rekey"] = split_by_rekey,
}

-- What to do when the remover was the only person you sent to (a room of
-- two), so your split room would have nobody in it (config
-- recipients.split-alone):
-- keep-empty:  split as usual; the new room has an empty list until you add
--              someone; you can read it but your words go nowhere.
-- record-only: no new room; the room just becomes a read-only record (in
--              both shapes, since there is nothing to talk in).
local split_alone_modes = {
    ["keep-empty"] = function(home, room_id, remover, remaining, parent_id, shape)
        return split_shapes[shape](home, room_id, remover, remaining, parent_id)
    end,
    ["record-only"] = function(home, room_id, remover, remaining, parent_id, shape)
        mark_record(home, room_id, "", remover, shape)
        return ""
    end,
}

-- {{{ function M.split_on_removal
-- Called when your server is told `remover` took you off their list for this
-- room.  Returns the id of the room you now talk in ("" when none: the
-- record-only answer for a room of two).
function M.split_on_removal(home, room_id, remover, shape)
    check_room_writable(home, room_id)
    check_contact(home, remover)
    -- the shape must be one that is built; a typo is an error, not a default
    if split_shapes[shape] == nil then
        error("recipients: unknown split shape " .. tostring(shape)
              .. " (built: fork, rekey)")
    end
    local room = rooms.read_room(home, room_id)
    local parent_mode = rooms.config_value(home, "recipients.split-parent")
    -- an unknown parent mode in config is an error, not a default
    if split_parent_for[parent_mode] == nil then
        error("recipients: unknown recipients.split-parent " .. parent_mode
              .. " (built: keep, top)")
    end
    local parent_id = split_parent_for[parent_mode](room.parent_id)
    -- the remover may already be off your list (you removed them first);
    -- either way they are not on the new one
    local remaining = without(room.recipients, remover)
    -- somebody left to talk to: split in the asked shape
    if #remaining > 0 then
        return split_shapes[shape](home, room_id, remover, remaining, parent_id)
    end
    -- nobody left: the room-of-two case, chosen by config
    local alone_mode = rooms.config_value(home, "recipients.split-alone")
    if split_alone_modes[alone_mode] == nil then
        error("recipients: unknown recipients.split-alone " .. alone_mode
              .. " (built: keep-empty, record-only)")
    end
    return split_alone_modes[alone_mode](home, room_id, remover, remaining, parent_id, shape)
end
-- }}}

-- {{{ function M.live_room_for
-- Where a message addressed to room_id should be filed on this server.
-- Follows fork records to the room you now talk in, so a third person who
-- still writes into the shared room is heard in your copy.  Gives:
--   the room id to file into; or
--   ""  when there is no such room here (never seen, rekeyed away, or a
--       record-only split): the caller decides whether to make it on arrival.
function M.live_room_for(home, room_id)
    local seen = {}
    local current = room_id
    while true do
        -- not here at all: nothing to file into
        if not rooms.room_exists(home, current) then
            return ""
        end
        local path = split_marker_path(home, current)
        -- no split marker: this is a live room
        if not file_exists(path) then
            return current
        end
        -- a record: follow it, guarding against a loop of records
        if seen[current] then
            error("recipients: split records form a loop at " .. current)
        end
        seen[current] = true
        current = first_value(read_pairs(path), "into", path)
        -- a record that points nowhere (record-only): nothing to file into
        if current == "" then
            return ""
        end
    end
end
-- }}}

-- ---------------------------------------------------------------------
-- rooms made on first arrival
-- ---------------------------------------------------------------------

-- {{{ local function list_from_carried
-- adder-list: the sender's own list, carried with the message, minus you,
-- plus the sender.  `carried.recipients` is already in YOUR contact names,
-- with your own entry written "me" (translating the sender's names into
-- yours is phase 2's work).  Names you have no contact for cannot be sent
-- to; they are left out and handed back so the caller can tell the person.
local function list_from_carried(home, sender, carried)
    -- this mode needs the carried list; its absence is a caller's mistake
    if carried == nil or carried.recipients == nil then
        error("recipients: adder-list mode needs carried.recipients")
    end
    local contacts = rooms.read_contacts(home)
    local list = { sender }
    local unknown = {}
    for _, name in ipairs(carried.recipients) do
        local entry = contacts[name]
        -- "me", the sender, or a repeat: already accounted for
        if name == "me" or contains(list, name) then
            -- nothing to add
        -- not someone you know: cannot send to them; reported back
        elseif entry == nil then
            unknown[#unknown + 1] = name
        -- one of your own devices on someone else's list cannot happen
        -- unless a name was translated wrongly: stop loudly
        elseif entry.own == "true" then
            error("recipients: carried list names your own device " .. name)
        -- a contact: they hear your replies
        else
            list[#list + 1] = name
        end
    end
    return list, unknown
end
-- }}}

local arrival_lists = {
    ["adder-only"] = function(home, sender, carried) return { sender }, {} end,
    ["heard-from"] = function(home, sender, carried) return { sender }, {} end,
    ["adder-list"] = list_from_carried,
}

-- {{{ function M.room_from_arrival
-- A message arrived from `sender` in room `room_id`, which this server has
-- never had.  Makes the room (a top room, named after the sender until the
-- person renames it; names never travel) and returns its id, plus a list of
-- carried names that were left out because they are not your contacts
-- (always empty outside adder-list).
function M.room_from_arrival(home, room_id, sender, mode, carried)
    -- the room must be new; for a known id the caller files the message
    -- (via live_room_for) instead of making a room
    if rooms.room_exists(home, room_id) then
        error("recipients: room " .. room_id .. " already exists; file into it instead")
    end
    check_contact(home, sender)
    -- the mode must be one that is built
    if arrival_lists[mode] == nil then
        error("recipients: unknown arrival list mode " .. tostring(mode)
              .. " (built: adder-only, heard-from, adder-list)")
    end
    local list, unknown = arrival_lists[mode](home, sender, carried)
    rooms.create_room(home, {
        name = "from-" .. sender,
        parent_id = "",
        recipients = list,
        room_id = room_id,
    })
    write_pairs(arrival_marker_path(home, room_id), {
        { "mode", mode },
        { "sender", sender },
    })
    return room_id, unknown
end
-- }}}

-- {{{ local function hear_from_authors
-- The heard-from mode: whenever a message is filed in a room made on
-- arrival in that mode, everyone who has written in it becomes a recipient,
-- unless declined (you removed them, or they removed you).  The whole log is
-- read rather than only the newest message, because 105 may file several
-- messages under one ring (a log copy rings once).
local function hear_from_authors(home, room_id)
    local path = arrival_marker_path(home, room_id)
    -- a room not made on arrival, or a forked-away record: not our business
    if not file_exists(path) or file_exists(split_marker_path(home, room_id)) then
        return
    end
    local marker = read_pairs(path)
    -- another arrival mode: the list only changes when the person says so
    if first_value(marker, "mode", path) ~= "heard-from" then
        return
    end
    local declined = all_values(marker, "declined")
    local contacts = rooms.read_contacts(home)
    local list = rooms.read_room(home, room_id).recipients
    local grew = false
    for _, message in ipairs(message_log().read(home, room_id)) do
        local author = message.author
        -- you, someone already listed, or someone declined: leave alone
        if author == "me" or contains(list, author) or contains(declined, author) then
            -- nothing to add
        -- an author with no contact entry cannot be sent to; the log only
        -- holds contact names, so this means the contacts file lost them
        elseif contacts[author] == nil then
            error("recipients: " .. author .. " wrote in " .. room_id .. " but is not a contact")
        -- someone new who spoke: they hear you from now on
        else
            list[#list + 1] = author
            grew = true
        end
    end
    -- only write (and ring the bell) when the list actually changed
    if grew then
        rooms.write_recipients(home, room_id, list)
    end
end
-- }}}

-- The bell's messages this module listens for.  Only "log" matters: a new
-- message may bring a new voice into a heard-from room.
local bell_handlers = {
    ["log"] = hear_from_authors,
}

-- {{{ local function on_bell
local function on_bell(home, room_id, what)
    local handler = bell_handlers[what]
    -- a change this module cares about: handle it; any other: ignore
    if handler then
        handler(home, room_id)
    end
end
-- }}}

rooms.on_change(on_bell)

return M
