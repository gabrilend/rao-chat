-- 043-stand-in-message-log.lua — a small copy of the message-log module
-- (issue 105), written only so the recipients tests can run before the real
-- one exists.
--
-- Each room's log is a text file with one message per line, fields
-- separated by tabs (id, author, time written, time arrived, text).  Filing a
-- message twice is refused by its id, and filing rings the change bell with
-- "log" as the contract says.  Copying a log copies the file and rings once.

local rooms = require("002-room-folders")

local M = {}

-- {{{ function M.new_message_id
function M.new_message_id()
    return rooms.new_room_id()
end
-- }}}

-- {{{ function M.read
function M.read(home, room_id)
    local file = assert(io.open(rooms.log_path(home, room_id), "r"))
    local messages = {}
    for line in file:lines() do
        local id, author, written, arrived, text =
            line:match("^([^\t]*)\t([^\t]*)\t(%d+)\t(%d+)\t(.*)$")
        -- a well-formed record: keep it; anything else is a broken log
        if id == nil then
            file:close()
            error("stand-in log: unreadable line: " .. line)
        end
        messages[#messages + 1] = {
            id = id, author = author, text = text,
            written = tonumber(written), arrived = tonumber(arrived),
        }
    end
    file:close()
    return messages
end
-- }}}

-- {{{ function M.has_message
function M.has_message(home, room_id, message_id)
    for _, message in ipairs(M.read(home, room_id)) do
        -- same id: it is here
        if message.id == message_id then
            return true
        end
    end
    return false
end
-- }}}

-- {{{ function M.append
function M.append(home, room_id, message)
    -- already filed: refuse by id, the repeat-safe rule
    if M.has_message(home, room_id, message.id) then
        return "duplicate"
    end
    local file = assert(io.open(rooms.log_path(home, room_id), "a"))
    file:write(table.concat({ message.id, message.author,
        tostring(message.written), tostring(message.arrived), message.text }, "\t"), "\n")
    file:close()
    rooms.notify(home, room_id, "log")
    return "filed"
end
-- }}}

-- {{{ function M.read_ordered
function M.read_ordered(home, room_id)
    local messages = M.read(home, room_id)
    table.sort(messages, function(a, b)
        -- different times: earlier first; same time: by message id
        if a.written ~= b.written then
            return a.written < b.written
        end
        return a.id < b.id
    end)
    return messages
end
-- }}}

-- {{{ function M.copy_log
function M.copy_log(home, from_id, to_id)
    local source = assert(io.open(rooms.log_path(home, from_id), "r"))
    local text = source:read("*a")
    source:close()
    local target = assert(io.open(rooms.log_path(home, to_id), "w"))
    target:write(text)
    target:close()
    rooms.notify(home, to_id, "log")
end
-- }}}

return M
