#!/usr/bin/env luajit
-- 050-run-tests.lua — runs every recipients test and reports the count.
--
-- Usage:  luajit 050-run-tests.lua [project folder] [stand-in | real]
--
-- The recipients module leans on two neighbours (the room folders and the
-- message log).  "stand-in" runs the tests against the small copies kept in
-- this tests folder; "real" runs them against the real modules in src/.
-- Each test prints one pass/FAIL line; the last line is the tally, and the
-- program ends with a failure status if any test failed, so a build script
-- can stop on it.

local DIR = arg[1] or "/home/ritz/programs/rao-chat"
local neighbours = arg[2] or "stand-in"

local tests_dir = DIR .. "/src/recipients/tests/"
local h = dofile(tests_dir .. "045-test-harness.lua")(DIR, neighbours)

print("recipients tests against " .. neighbours .. " neighbours; scratch homes in " .. h.scratch)

for _, file in ipairs({
    "046-test-add-remove.lua",
    "047-test-split.lua",
    "048-test-arrival.lua",
    "049-test-six-become-two-fives.lua",
    "051-test-options.lua",
}) do
    print("-- " .. file)
    dofile(tests_dir .. file)(h)
end

print(string.format("recipients (%s): %d passed, %d failed", neighbours, h.passed, h.failed))
-- any failure: exit non-zero so callers stop; all passed: exit zero
if h.failed > 0 then
    os.exit(1)
end
os.exit(0)
