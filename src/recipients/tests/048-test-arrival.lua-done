-- 048-test-arrival.lua — tests for rooms made when a message arrives in a
-- room this server has never seen, in all three reply-list modes.
--
-- adder-only: your replies go to the sender alone.
-- heard-from: the sender, then everyone you hear from in the room, except
--             people you removed or who removed you.
-- adder-list: the sender's own list carried with the message, minus you,
--             plus the sender; names you have no contact for are left out
--             and reported.

-- {{{ local function run
local function run(h)
    local r = h.recipients

    -- {{{ local function fresh
    local function fresh(mode)
        return h.new_home("arrive-" .. mode, { "ana", "bo", "cy", "dee" }, { "myphone" }, {
            ["recipients.split-shape"] = "fork",
            ["recipients.arrival-list"] = mode,
            ["recipients.split-parent"] = "keep",
            ["recipients.split-alone"] = "record-only",
        })
    end
    -- }}}

    for _, mode in ipairs({ "adder-only", "heard-from", "adder-list" }) do
        local tag = "arrival " .. mode .. ": "
        local carried = { recipients = { "me", "bo" } }

        h.check(tag .. "the room is made with the id it arrived under", function()
            local home = fresh(mode)
            local id = h.rooms.new_room_id()
            local made, unknown = r.room_from_arrival(home, id, "ana", mode, carried)
            h.equal(made, id, "room id")
            h.equal(h.rooms.room_exists(home, id), true, "exists")
            h.equal(h.rooms.read_room(home, id).parent_id, "", "a top room")
            h.equal(h.rooms.read_room(home, id).name, "from-ana", "name")
            h.equal(#unknown, 0, "unknown names")
        end)

        h.check(tag .. "a room already here is refused", function()
            local home = fresh(mode)
            local id = h.rooms.create_room(home, { name = "x", parent_id = "", recipients = { "ana" } })
            h.expect_error("already exists", function() r.room_from_arrival(home, id, "ana", mode, carried) end)
        end)

        h.check(tag .. "a stranger or own device as sender is refused", function()
            local home = fresh(mode)
            h.expect_error("is not a contact", function()
                r.room_from_arrival(home, h.rooms.new_room_id(), "zed", mode, carried)
            end)
            h.expect_error("own devices", function()
                r.room_from_arrival(home, h.rooms.new_room_id(), "myphone", mode, carried)
            end)
        end)
    end

    h.check("arrival: an unbuilt mode is refused", function()
        local home = fresh("adder-only")
        h.expect_error("unknown arrival list mode", function()
            r.room_from_arrival(home, h.rooms.new_room_id(), "ana", "everyone", nil)
        end)
    end)

    h.check("arrival adder-only: replies go to the sender alone", function()
        local home = fresh("adder-only")
        local id = r.room_from_arrival(home, h.rooms.new_room_id(), "ana", "adder-only", nil)
        h.same_set(h.rooms.read_room(home, id).recipients, { "ana" })
    end)

    h.check("arrival adder-only: hearing others does not add them", function()
        local home = fresh("adder-only")
        local id = r.room_from_arrival(home, h.rooms.new_room_id(), "ana", "adder-only", nil)
        h.log.append(home, id, h.message("ana", "hi"))
        h.log.append(home, id, h.message("bo", "hello"))
        h.same_set(h.rooms.read_room(home, id).recipients, { "ana" })
    end)

    h.check("arrival heard-from: starts with the sender", function()
        local home = fresh("heard-from")
        local id = r.room_from_arrival(home, h.rooms.new_room_id(), "ana", "heard-from", nil)
        h.same_set(h.rooms.read_room(home, id).recipients, { "ana" })
    end)

    h.check("arrival heard-from: each new voice is added", function()
        local home = fresh("heard-from")
        local id = r.room_from_arrival(home, h.rooms.new_room_id(), "ana", "heard-from", nil)
        h.log.append(home, id, h.message("ana", "hi"))
        h.log.append(home, id, h.message("bo", "hello"))
        h.same_set(h.rooms.read_room(home, id).recipients, { "ana", "bo" }, "after bo")
        h.log.append(home, id, h.message("me", "hey both"))
        h.log.append(home, id, h.message("cy", "me too"))
        h.same_set(h.rooms.read_room(home, id).recipients, { "ana", "bo", "cy" }, "after cy")
    end)

    h.check("arrival heard-from: someone you removed is not re-added", function()
        local home = fresh("heard-from")
        local id = r.room_from_arrival(home, h.rooms.new_room_id(), "ana", "heard-from", nil)
        h.log.append(home, id, h.message("bo", "hello"))
        r.remove(home, id, "bo")
        h.log.append(home, id, h.message("bo", "still here"))
        h.same_set(h.rooms.read_room(home, id).recipients, { "ana" }, "bo stays off")
        r.add(home, id, "bo")
        r.remove(home, id, "ana")
        h.log.append(home, id, h.message("ana", "hey"))
        h.same_set(h.rooms.read_room(home, id).recipients, { "bo" }, "after swapping")
    end)

    for _, shape in ipairs({ "fork", "rekey" }) do
        h.check("arrival heard-from then split " .. shape .. ": remover not re-added", function()
            local home = fresh("heard-from")
            local id = r.room_from_arrival(home, h.rooms.new_room_id(), "ana", "heard-from", nil)
            h.log.append(home, id, h.message("ana", "hi"))
            h.log.append(home, id, h.message("bo", "hello"))
            local new_id = r.split_on_removal(home, id, "ana", shape)
            h.same_set(h.rooms.read_room(home, new_id).recipients, { "bo" }, "after split")
            h.log.append(home, new_id, h.message("cy", "new voice"))
            h.same_set(h.rooms.read_room(home, new_id).recipients, { "bo", "cy" }, "after cy")
        end)
    end

    h.check("arrival adder-list: sender's list minus you plus sender", function()
        local home = fresh("adder-list")
        local id, unknown = r.room_from_arrival(home, h.rooms.new_room_id(), "ana", "adder-list",
            { recipients = { "bo", "me", "cy" } })
        h.same_set(h.rooms.read_room(home, id).recipients, { "ana", "bo", "cy" })
        h.equal(#unknown, 0, "unknown")
    end)

    h.check("arrival adder-list: names you do not know are left out and reported", function()
        local home = fresh("adder-list")
        local id, unknown = r.room_from_arrival(home, h.rooms.new_room_id(), "ana", "adder-list",
            { recipients = { "me", "bo", "zed", "yul" } })
        h.same_set(h.rooms.read_room(home, id).recipients, { "ana", "bo" })
        h.same_set(unknown, { "zed", "yul" }, "unknown")
    end)

    h.check("arrival adder-list: sender and repeats on the carried list count once", function()
        local home = fresh("adder-list")
        local id = r.room_from_arrival(home, h.rooms.new_room_id(), "ana", "adder-list",
            { recipients = { "ana", "me", "bo", "bo" } })
        h.same_set(h.rooms.read_room(home, id).recipients, { "ana", "bo" })
    end)

    h.check("arrival adder-list: missing carried list is refused", function()
        local home = fresh("adder-list")
        h.expect_error("needs carried.recipients", function()
            r.room_from_arrival(home, h.rooms.new_room_id(), "ana", "adder-list", nil)
        end)
    end)

    h.check("arrival adder-list: your own device on the carried list is refused", function()
        local home = fresh("adder-list")
        h.expect_error("your own device", function()
            r.room_from_arrival(home, h.rooms.new_room_id(), "ana", "adder-list",
                { recipients = { "me", "myphone" } })
        end)
    end)

    h.check("arrival adder-list: hearing others does not add them", function()
        local home = fresh("adder-list")
        local id = r.room_from_arrival(home, h.rooms.new_room_id(), "ana", "adder-list",
            { recipients = { "me" } })
        h.log.append(home, id, h.message("dee", "hi"))
        h.same_set(h.rooms.read_room(home, id).recipients, { "ana" })
    end)
end
-- }}}

return run
