-- 103-demo-sections.lua — builds each scene of the phase 1 demo and measures it.
--
-- The demo plays out the owner's own example — home → ritz → programming,
-- with a household, a girlfriend and a programming friend — on real home
-- folders in a scratch space in RAM, using the five phase 1 modules exactly
-- as a later home server will.  Each scene here builds one situation and
-- hands back a record of what is now true on disk: folder listings, link
-- listings, file contents, counts, byte sizes, timings.  It prints nothing;
-- 104-demo-view.lua turns each record into text.  Keeping the two apart
-- means a scene that builds wrongly fails here, with its own error, and a
-- view that draws wrongly fails there.
--
-- Every scene that touches an undecided choice runs once per variant, each
-- in a home of its own, so the variants can be compared side by side.
--
-- Scenes, in the order the demo shows them:
--   flat        rooms stored flat by id, the tree they record, each `where`
--   people      the people/ links per contact, and the gap closing
--   collision   two top rooms with one name, in each link-collision variant
--   reader      the girlfriend's own view, in each parent-disclosure mode
--   log         filing messages (late, repeated) in each log record shape
--   edits       correcting a message under each edit rule
--   split       a room of six split by a removal, in each split shape
--   tally       the options tally over every module's options file

local sections = {}

-- The people in the owner's example.  Contact names are the names this home
-- knows them by; the planning document's example does not name them, so the
-- names say what each person is to the owner.
local EXAMPLE_CONTACTS = { "housemate", "girlfriend", "coder" }

-- A fixed starting clock for scripted messages, so every run of the demo
-- files the same written times and the ordering can be checked by eye.
-- 2026-09-23 12:00:00 UTC, the day the planning document was written.
local SCRIPT_T0 = 1790164800

-- {{{ local function new_home
-- A fresh home for one scene.  Every undecided choice is set before anything
-- else happens, because loaded modules listen on the change bell and read
-- their config keys the moment the first room is made.  `overrides` (key →
-- value) replaces the baseline for the choices this scene varies.  Gives the
-- home table { dir = string }.
local function new_home(ctx, label, contacts, overrides)
    local place = ctx.probes.fresh_dir(ctx.scratch, ctx.scratch .. "/" .. label)
    local home = ctx.m.rooms.open_home(place .. "/rao-home")
    for _, setting in ipairs(ctx.baseline) do
        ctx.m.rooms.set_config(home, setting.key, setting.value)
    end
    for key, value in pairs(overrides) do
        ctx.m.rooms.set_config(home, key, value)
    end
    -- rmail's contacts format: name.field = value.  The token and address
    -- are placeholders; nothing is delivered in phase 1.
    local lines = {}
    for position, name in ipairs(contacts) do
        lines[#lines + 1] = name .. '.token = "demo-token-' .. name .. '"'
        lines[#lines + 1] = name .. ".ip = 192.0.2." .. position
    end
    ctx.probes.write_text(home.dir .. "/contacts", table.concat(lines, "\n") .. "\n")
    return home
end
-- }}}

-- {{{ local function variants_of
-- The variant names of one config key, as the options files list them.  The
-- demo runs whatever variants the builders recorded, so a variant added
-- later is demonstrated without editing this file.
local function variants_of(ctx, key)
    local names = ctx.variants_by_key[key]
    if names == nil then
        -- no options file records this key: the scene cannot run every variant
        error("no options file records the config key '" .. key .. "'")
    end
    -- (recorded: hand back the names)
    return names
end
-- }}}

-- {{{ local function build_example
-- The owner's three rooms: home (household and girlfriend), ritz inside it
-- (nobody else: a room only the owner writes in), programming inside ritz
-- (girlfriend and coder).  Gives the home, the ids by name, and the seconds
-- it took to make the three rooms.
local function build_example(ctx, label, overrides)
    local rooms = ctx.m.rooms
    local home = new_home(ctx, label, EXAMPLE_CONTACTS, overrides)
    local started = ctx.probes.now()
    local ids = {}
    ids.home = rooms.create_room(home, { name = "home", parent_id = "",
                                         recipients = { "housemate", "girlfriend" } })
    ids.ritz = rooms.create_room(home, { name = "ritz", parent_id = ids.home,
                                         recipients = {} })
    ids.programming = rooms.create_room(home, { name = "programming", parent_id = ids.ritz,
                                                recipients = { "girlfriend", "coder" } })
    return home, ids, ctx.probes.now() - started
end
-- }}}

-- {{{ local function own_forest
-- The owner's own tree, as nodes 102's drawing understands, made from the
-- parent files through 102's children_of: every room with no parent is a
-- top, and each room's children hang beneath it.
local function own_forest(ctx, home)
    local rooms, tree = ctx.m.rooms, ctx.m.tree
    -- {{{ local function node_for
    local function node_for(id)
        local room = rooms.read_room(home, id)
        local node = { room_id = id, name = room.name, disclosed_parent_id = room.parent_id,
                       parent_unseen = false, children = {} }
        for _, child in ipairs(tree.children_of(home, id)) do
            node.children[#node.children + 1] = node_for(child)
        end
        return node
    end
    -- }}}
    local forest = {}
    for _, id in ipairs(rooms.list_rooms(home)) do
        if rooms.read_room(home, id).parent_id == "" then
            -- a top room: its tree starts here
            forest[#forest + 1] = node_for(id)
        end
        -- (a room with a parent is drawn under it, not here)
    end
    return forest
end
-- }}}

-- {{{ local function people_listing
-- What people/ holds for each contact: its links, each "link -> target",
-- and the names of the rooms behind 104's top_rooms_for.
local function people_listing(ctx, home)
    local listing = {}
    for _, contact in ipairs(EXAMPLE_CONTACTS) do
        local tops = {}
        for _, id in ipairs(ctx.m.people.top_rooms_for(home, contact)) do
            tops[#tops + 1] = ctx.m.rooms.read_room(home, id).name
        end
        listing[#listing + 1] = { contact = contact, tops = tops }
    end
    return { per_contact = listing, links = ctx.probes.links_with_targets(home.dir .. "/people") }
end
-- }}}

-- {{{ function sections.flat
-- Rooms stored flat by id: the rooms/ folder, every file in it with its
-- size, each room's name/parent/recipients/where as written on disk, and
-- the tree those parent files describe.
function sections.flat(ctx)
    local home, ids, seconds = build_example(ctx, "flat", {})
    local rooms = ctx.m.rooms
    local record = { home_dir = home.dir, seconds_to_make = seconds, rooms = {},
                      folder = ctx.probes.entries(home.dir .. "/rooms"),
                      files = ctx.probes.files_with_sizes(home.dir .. "/rooms") }
    for _, name in ipairs({ "home", "ritz", "programming" }) do
        local dir = rooms.room_dir(home, ids[name])
        record.rooms[#record.rooms + 1] = {
            id = ids[name],
            name = ctx.probes.read_text(dir .. "/name"),
            parent = ctx.probes.read_text(dir .. "/parent"),
            recipients = ctx.probes.read_text(dir .. "/recipients"),
            where = ctx.probes.read_text(dir .. "/where"),
            path_of_names = ctx.m.tree.path_of_names(home, ids[name]),
        }
    end
    record.tree_lines = ctx.m.forest_text.lines(own_forest(ctx, home))
    return record
end
-- }}}

-- {{{ function sections.people
-- The people/ folder before and after the owner adds the girlfriend to
-- ritz: before, she has two top rooms (home, programming); after, one.
function sections.people(ctx)
    local home, ids = build_example(ctx, "people", {})
    local record = { before = people_listing(ctx, home) }
    local started = ctx.probes.now()
    ctx.m.recipients.add(home, ids.ritz, "girlfriend")
    record.seconds_to_add = ctx.probes.now() - started
    record.after = people_listing(ctx, home)
    record.ritz_recipients = ctx.m.rooms.read_room(home, ids.ritz).recipients
    return record
end
-- }}}

-- {{{ function sections.collision
-- A second top room also called "programming", shared with coder only
-- (the owner: "They can absolutely have multiple directories named
-- programming").  Coder now has two top rooms of one name; each
-- link-collision variant names the two links its own way.
function sections.collision(ctx)
    local record = { variants = {} }
    for _, variant in ipairs(variants_of(ctx, "people.link-collision")) do
        local home = build_example(ctx, "collision-" .. variant,
                                   { ["people.link-collision"] = variant })
        ctx.m.rooms.create_room(home, { name = "programming", parent_id = "",
                                        recipients = { "coder" } })
        record.variants[#record.variants + 1] = {
            variant = variant,
            links = ctx.probes.links_with_targets(home.dir .. "/people/coder"),
        }
    end
    return record
end
-- }}}

-- {{{ function sections.reader
-- What the girlfriend's own screen would show, in each parent-disclosure
-- mode: the trees she can assemble from the rooms that reach her, before
-- and after she is added to ritz, and the coder's for comparison.  Names
-- are the sender's (names do not travel; 102 stands in the reader naming
-- each room the same way, as the owner's example assumes).
function sections.reader(ctx)
    local tree, draw = ctx.m.tree, ctx.m.forest_text
    local record = { modes = {} }
    for _, mode in ipairs(variants_of(ctx, "tree.parent-disclosure")) do
        local home, ids = build_example(ctx, "reader-" .. mode,
                                        { ["tree.parent-disclosure"] = mode })
        local names_by_id = { [ids.home] = "home", [ids.ritz] = "ritz",
                              [ids.programming] = "programming", [""] = "(nothing)" }
        -- {{{ local function view_of
        local function view_of(contact)
            local received = tree.what_contact_receives(home, contact, mode)
            local told = {}
            for _, entry in ipairs(received) do
                told[#told + 1] = { room = entry.name,
                                    parent = names_by_id[entry.disclosed_parent_id] }
            end
            return { told = told, lines = draw.lines(tree.visible_forest(received)) }
        end
        -- }}}
        local result = { mode = mode }
        result.girlfriend_before = view_of("girlfriend")
        result.coder = view_of("coder")
        ctx.m.recipients.add(home, ids.ritz, "girlfriend")
        result.girlfriend_after = view_of("girlfriend")
        record.modes[#record.modes + 1] = result
    end
    return record
end
-- }}}

-- {{{ local function message
local function message(ctx, author, written, arrived, text)
    return { id = ctx.m.log.new_message_id(), author = author, written = written,
             arrived = arrived, text = text }
end
-- }}}

-- The scripted conversation filed in each log shape.  Offsets are seconds
-- after SCRIPT_T0.  The fourth message was written at +30 but only arrives
-- at +200 (its sender's server was away), so it is last in the file and
-- second on screen.  The fifth delivery repeats the second message's id.
local SCRIPT = {
    { author = "me",         written = 0,   arrived = 0,   text = "anyone around to pair on the parser?" },
    { author = "coder",      written = 60,  arrived = 61,  text = "yes, give me ten minutes" },
    { author = "me",         written = 120, arrived = 120, text = "great, I pushed the branch" },
    { author = "girlfriend", written = 30,  arrived = 200, text = "I can look after dinner" },
}

-- How many messages the bulk measurement files per variant.  Enough for
-- the per-message cost to settle; small enough that the "scan" duplicate
-- check (which rereads the log each time) finishes in about a second.
local BULK_COUNT = 400

-- {{{ local function bulk_measure
-- Files BULK_COUNT one-line messages into a fresh room and times it; then
-- times asking has_message for the last id and for an id never filed.
local function bulk_measure(ctx, home)
    local room = ctx.m.rooms.create_room(home, { name = "bulk", parent_id = "",
                                                 recipients = { "coder" } })
    local log = ctx.m.log
    local last_id
    local started = ctx.probes.now()
    for number = 1, BULK_COUNT do
        local filed = message(ctx, "coder", SCRIPT_T0 + number, SCRIPT_T0 + number,
                              "bulk message number " .. number)
        last_id = filed.id
        log.append(home, room, filed)
    end
    local append_seconds = ctx.probes.now() - started
    started = ctx.probes.now()
    local found = log.has_message(home, room, last_id)
    local missing = log.has_message(home, room, log.new_message_id())
    local lookup_seconds = (ctx.probes.now() - started) / 2
    return {
        count = BULK_COUNT,
        bytes = ctx.probes.bytes(ctx.m.rooms.log_path(home, room)),
        append_seconds = append_seconds,
        lookup_seconds = lookup_seconds,
        found_last = found, found_unfiled = missing,
    }
end
-- }}}

-- {{{ function sections.log
-- For each log record shape (and each duplicate check), files the scripted
-- conversation, the late message and the repeat, and measures the file.
function sections.log(ctx)
    local record = { shapes = {}, t0 = SCRIPT_T0 }
    local checks = variants_of(ctx, "log.duplicate-check")
    for _, shape in ipairs(variants_of(ctx, "log.record-shape")) do
        local home = new_home(ctx, "log-" .. shape, EXAMPLE_CONTACTS,
                              { ["log.record-shape"] = shape })
        local room = ctx.m.rooms.create_room(home, { name = "programming", parent_id = "",
                                                     recipients = { "girlfriend", "coder" } })
        local results, filed = {}, {}
        for position, line in ipairs(SCRIPT) do
            filed[position] = message(ctx, line.author, SCRIPT_T0 + line.written,
                                      SCRIPT_T0 + line.arrived, line.text)
            results[#results + 1] = { label = "message " .. position,
                                      answer = ctx.m.log.append(home, room, filed[position]) }
        end
        -- the second message delivered again (the first answer was lost)
        results[#results + 1] = { label = "message 2 again",
                                  answer = ctx.m.log.append(home, room, filed[2]) }
        local path = ctx.m.rooms.log_path(home, room)
        local file_order, screen_order = {}, {}
        for _, m in ipairs(ctx.m.log.read(home, room)) do
            file_order[#file_order + 1] = { written = m.written - SCRIPT_T0, author = m.author,
                                            text = m.text }
        end
        for _, m in ipairs(ctx.m.log.read_ordered(home, room)) do
            screen_order[#screen_order + 1] = { written = m.written - SCRIPT_T0,
                                                author = m.author, text = m.text }
        end
        local bulk = {}
        for _, check in ipairs(checks) do
            local bulk_home = new_home(ctx, "log-" .. shape .. "-bulk-" .. check, EXAMPLE_CONTACTS,
                                       { ["log.record-shape"] = shape,
                                         ["log.duplicate-check"] = check })
            local measured = bulk_measure(ctx, bulk_home)
            measured.check = check
            bulk[#bulk + 1] = measured
        end
        record.shapes[#record.shapes + 1] = {
            shape = shape, results = results, file_order = file_order,
            screen_order = screen_order, bytes = ctx.probes.bytes(path),
            raw = ctx.probes.read_text(path), bulk = bulk,
        }
    end
    return record
end
-- }}}

-- How long after writing a message the "window" edit rule allows an edit,
-- for this demo.  It is a setting of that variant, not a choice between
-- variants; 300 seconds is the figure used here and printed beside it.
local DEMO_EDIT_WINDOW = "300"

-- {{{ function sections.edits
-- Under each edit rule: correct a message 60 seconds after writing it, and
-- again 3600 seconds after; delete one.  Records what each attempt gave —
-- "filed", or the refusal's own words — and what the screen then shows.
function sections.edits(ctx)
    local record = { rules = {}, window = DEMO_EDIT_WINDOW }
    for _, rule in ipairs(variants_of(ctx, "log.edits")) do
        local home = new_home(ctx, "edits-" .. rule, EXAMPLE_CONTACTS,
                              { ["log.edits"] = rule,
                                ["log.edit-window-seconds"] = DEMO_EDIT_WINDOW })
        local room = ctx.m.rooms.create_room(home, { name = "programming", parent_id = "",
                                                     recipients = { "coder" } })
        local original = message(ctx, "me", SCRIPT_T0, SCRIPT_T0, "the branch is called parsre")
        local other = message(ctx, "me", SCRIPT_T0 + 10, SCRIPT_T0 + 10, "ignore that last bit")
        ctx.m.log.append(home, room, original)
        ctx.m.log.append(home, room, other)
        local attempts = {
            { label = "correct after 60 s", run = function()
                return ctx.m.log.correct(home, room, { id = ctx.m.log.new_message_id(),
                    author = "me", written = SCRIPT_T0 + 60, arrived = SCRIPT_T0 + 60,
                    target = original.id, text = "the branch is called parser" }) end },
            { label = "correct after 3600 s", run = function()
                return ctx.m.log.correct(home, room, { id = ctx.m.log.new_message_id(),
                    author = "me", written = SCRIPT_T0 + 3600, arrived = SCRIPT_T0 + 3600,
                    target = original.id, text = "(renamed again) parser-v2" }) end },
            { label = "delete after 30 s", run = function()
                return ctx.m.log.delete(home, room, { id = ctx.m.log.new_message_id(),
                    author = "me", written = SCRIPT_T0 + 40, arrived = SCRIPT_T0 + 40,
                    target = other.id }) end },
        }
        local results = {}
        for _, attempt in ipairs(attempts) do
            local ran, answer = pcall(attempt.run)
            -- filed or duplicate: the answer; refused: the refusal's words
            results[#results + 1] = { label = attempt.label, accepted = ran,
                                      answer = tostring(answer) }
        end
        local screen = {}
        for _, m in ipairs(ctx.m.log.read_ordered(home, room)) do
            screen[#screen + 1] = { text = m.text, edited = m.edited, deleted = m.deleted }
        end
        record.rules[#record.rules + 1] = {
            rule = rule, results = results, screen = screen,
            records_in_file = #ctx.m.log.read(home, room),
            bytes = ctx.probes.bytes(ctx.m.rooms.log_path(home, room)),
        }
    end
    return record
end
-- }}}

-- The six people of the owner's split example.  p1 is the owner's side.
local SIX = { "p1", "p2", "p3", "p4", "p5", "p6" }

-- {{{ local function all_but
local function all_but(excluded)
    local list = {}
    for _, name in ipairs(SIX) do
        if name ~= excluded then
            -- everyone else goes on the list
            list[#list + 1] = name
        end
        -- (the person themself is never on their own list)
    end
    return list
end
-- }}}

-- {{{ local function room_state
-- One room as seen on disk: people counted as the list plus its keeper.
local function room_state(ctx, home, id)
    local room = ctx.m.rooms.read_room(home, id)
    local split_path = ctx.m.rooms.room_dir(home, id) .. "/split"
    local split_file = io.open(split_path, "r")
    local marker = ""
    if split_file then
        -- this room is a read-only record of a split: keep its marker text
        marker = split_file:read("*a")
        split_file:close()
    end
    -- (no marker: a live room)
    return { id = id, name = room.name, recipients = room.recipients,
             people = #room.recipients + 1, messages = #ctx.m.log.read(home, id),
             marker = marker }
end
-- }}}

-- {{{ function sections.split
-- The owner's example: six people share a room; p1 removes p2.  Two homes
-- are built — p1's and p2's — each holding the same room id with its own
-- list of the other five and the same three messages.  p1 takes p2 off
-- their list; p2's server, told of it, splits its copy.  Run once per
-- split shape.
function sections.split(ctx)
    local record = { shapes = {} }
    for _, shape in ipairs(variants_of(ctx, "recipients.split-shape")) do
        local overrides = { ["recipients.split-shape"] = shape }
        local p1 = new_home(ctx, "split-" .. shape .. "-p1", all_but("p1"), overrides)
        local p2 = new_home(ctx, "split-" .. shape .. "-p2", all_but("p2"), overrides)
        local shared_id = ctx.m.rooms.new_room_id()
        ctx.m.rooms.create_room(p1, { name = "the-six", parent_id = "", recipients = all_but("p1"),
                                      room_id = shared_id })
        ctx.m.rooms.create_room(p2, { name = "the-six", parent_id = "", recipients = all_but("p2"),
                                      room_id = shared_id })
        -- the same three messages in both homes; each home calls its own
        -- writing "me" and the other's by contact name
        local said = {
            { writer = "p1", offset = 0,  text = "welcome, all six of us" },
            { writer = "p2", offset = 30, text = "glad to be here" },
            { writer = "p3", offset = 60, text = "hello both" },
        }
        for _, line in ipairs(said) do
            local id = ctx.m.log.new_message_id()
            for _, pair in ipairs({ { home = p1, self = "p1" }, { home = p2, self = "p2" } }) do
                local author = (line.writer == pair.self) and "me" or line.writer
                ctx.m.log.append(pair.home, shared_id, { id = id, author = author,
                    written = SCRIPT_T0 + line.offset, arrived = SCRIPT_T0 + line.offset,
                    text = line.text })
            end
        end
        local result = { shape = shape, shared_id = shared_id,
                         p1_before = room_state(ctx, p1, shared_id),
                         p2_before = room_state(ctx, p2, shared_id),
                         p2_rooms_before = ctx.probes.entries(p2.dir .. "/rooms") }
        local started = ctx.probes.now()
        ctx.m.recipients.remove(p1, shared_id, "p2")
        local talk_in = ctx.m.recipients.split_on_removal(p2, shared_id, "p1", shape)
        result.seconds = ctx.probes.now() - started
        result.talk_in = talk_in
        result.p1_after = room_state(ctx, p1, shared_id)
        result.p2_rooms_after = ctx.probes.entries(p2.dir .. "/rooms")
        result.p2_files_after = ctx.probes.files_with_sizes(p2.dir .. "/rooms")
        result.p2_after = room_state(ctx, p2, talk_in)
        if ctx.m.rooms.room_exists(p2, shared_id) then
            -- fork: the old id stays on p2's disk as a read-only record
            result.p2_old = room_state(ctx, p2, shared_id)
        end
        -- (rekey: the old id is gone from p2's disk)
        result.live_for_old_id = ctx.m.recipients.live_room_for(p2, shared_id)
        result.p2_links_for_p3 = ctx.probes.links_with_targets(p2.dir .. "/people/p3")
        record.shapes[#record.shapes + 1] = result
    end
    return record
end
-- }}}

-- {{{ function sections.tally
-- The options tally over the real project, gathered once by the main
-- program (it also sets the demo's baseline from it) and passed through.
function sections.tally(ctx)
    return { record = ctx.options, counts = ctx.gather.counts(ctx.options) }
end
-- }}}

-- The order the scenes are shown in, with their titles.  A list, not the
-- keys of `sections`, so the order is the story's order.
sections.ORDER = {
    { key = "flat",      title = "Rooms stored flat by id, and the tree they record" },
    { key = "people",    title = "people/: what we share with each person" },
    { key = "collision", title = "Two top rooms with one name (people.link-collision)" },
    { key = "reader",    title = "The girlfriend's own view (tree.parent-disclosure)" },
    { key = "log",       title = "The message log: late, repeated, and its size (log.record-shape)" },
    { key = "edits",     title = "Correcting and deleting (log.edits)" },
    { key = "split",     title = "Removal splits a room of six into two of five (recipients.split-shape)" },
    { key = "tally",     title = "Every choice still open (scripts/tally-options)" },
}

return sections
