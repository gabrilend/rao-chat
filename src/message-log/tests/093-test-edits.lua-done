-- 093-test-edits.lua — checks the three edit rules (log.edits = never,
-- corrections, window) in every record shape: what is refused, what is
-- filed, that the original stays in the file, and what the room shows.
--
-- Run: luajit 093-test-edits.lua [DIR] [real|stand-in]

local DIR = "/home/ritz/programs/rao-chat"
-- Path: a DIR argument — use it.  None — the hard-coded project folder.
if arg[1] and arg[1] ~= "" then
    DIR = arg[1]
end
local t = dofile(DIR .. "/src/message-log/tests/090-test-harness.lua").start(arg, "edits")
local log, rooms = t.log, t.rooms

-- {{{ local function edit_of
local function edit_of(message, fields)
    local edit = {
        id = log.new_message_id(), author = message.author,
        written = message.written + 10, arrived = message.written + 10,
        target = message.id, text = "corrected",
    }
    for key, value in pairs(fields or {}) do
        edit[key] = value
    end
    return edit
end
-- }}}

for _, shape in ipairs(t.SHAPES) do
    -- never
    do
        local label = shape .. "/never: "
        local home = t.fresh_home(t.settings(shape, "fixed", "remembered", "never"))
        local room = t.new_room(home)
        local message = t.message({ written = 1000 })
        log.append(home, room, message)
        t.refuses(function() log.correct(home, room, edit_of(message)) end,
            "edits are off", label .. "a correction is refused")
        t.refuses(function() log.delete(home, room, edit_of(message)) end,
            "edits are off", label .. "a deletion is refused")
        t.check(#log.read(home, room) == 1, label .. "nothing was added to the file")
    end

    -- corrections and window share most behaviour.
    for _, mode in ipairs({ "corrections", "window" }) do
        local label = shape .. "/" .. mode .. ": "
        local settings = t.settings(shape, "fixed", "scan", mode)
        settings["log.edit-window-seconds"] = "60"
        local home = t.fresh_home(settings)
        local room = t.new_room(home)
        local message = t.message({ author = "sorelu", written = 1000, text = "teh cat" })
        log.append(home, room, message)

        local fix = edit_of(message, { text = "the cat\twith a tab\nand a line" })
        t.check(log.correct(home, room, fix) == "filed", label .. "the author may correct")
        t.check(log.correct(home, room, fix) == "duplicate", label .. "the same correction again is a duplicate")
        local records = log.read(home, room)
        t.check(#records == 2 and records[1].text == "teh cat" and records[2].kind == "correction"
            and records[2].target == message.id, label .. "the original stays in the file, the correction follows")
        local view = log.read_ordered(home, room)
        t.check(#view == 1 and view[1].text == fix.text and view[1].edited == true,
            label .. "the room shows the corrected text, marked edited")

        -- A second correction written later wins, even when filed first.
        local later = edit_of(message, { text = "the cat, final", written = 1030 })
        local earlier = edit_of(message, { text = "the cat, middle", written = 1020 })
        log.correct(home, room, later)
        log.correct(home, room, earlier)
        t.check(log.read_ordered(home, room)[1].text == "the cat, final",
            label .. "the latest-written correction wins, not the last filed")

        t.refuses(function() log.correct(home, room, edit_of(message, { author = "me" })) end,
            "may not edit", label .. "someone else may not correct it")
        t.refuses(function() log.correct(home, room, edit_of(message, { target = log.new_message_id() })) end,
            "no message", label .. "a correction of an unknown id is refused")
        t.refuses(function() log.correct(home, room, edit_of(message, { target = fix.id })) end,
            "no message", label .. "a correction of a correction is refused")
        local self = edit_of(message)
        self.target = self.id
        t.refuses(function() log.correct(home, room, self) end, "its own id", label .. "an edit naming itself is refused")

        t.check(log.delete(home, room, edit_of(message, { written = 1040 })) == "filed", label .. "the author may delete")
        view = log.read_ordered(home, room)
        t.check(#view == 1 and view[1].deleted == true and view[1].text == "",
            label .. "a deleted message stays in the view, empty and marked, so its anchor still resolves")
        t.check(log.read(home, room)[1].text == "teh cat", label .. "the deleted original is still in the file")
        t.refuses(function() log.correct(home, room, edit_of(message, { written = 1050 })) end,
            "already deleted", label .. "a deleted message cannot be corrected")
    end

    -- window only: the edge.
    do
        local label = shape .. "/window: "
        local settings = t.settings(shape, "fixed", "scan", "window")
        settings["log.edit-window-seconds"] = "60"
        local home = t.fresh_home(settings)
        local room = t.new_room(home)
        local message = t.message({ written = 1000 })
        log.append(home, room, message)
        t.check(log.correct(home, room, edit_of(message, { written = 1060 })) == "filed",
            label .. "a correction exactly at the window edge is filed")
        t.refuses(function() log.correct(home, room, edit_of(message, { written = 1061 })) end,
            "too late", label .. "a correction one second late is refused")
        t.refuses(function() log.delete(home, room, edit_of(message, { written = 5000 })) end,
            "too late", label .. "a late deletion is refused")
        rooms.set_config(home, "log.edit-window-seconds", "a minute")
        t.refuses(function() log.correct(home, room, edit_of(message, { written = 1001 })) end,
            "not a whole number", label .. "a window that is not a number is an error")
    end
end

-- Edits already in a file are shown even after edits are turned off.
do
    local home = t.fresh_home(t.settings("tsv", "fixed", "scan", "corrections"))
    local room = t.new_room(home)
    local message = t.message({ written = 1000 })
    log.append(home, room, message)
    log.correct(home, room, edit_of(message, { text = "kept" }))
    rooms.set_config(home, "log.edits", "never")
    t.check(log.read_ordered(home, room)[1].text == "kept",
        "never: corrections filed before the switch are still shown")
end

-- A window home without the window key is an error at the first edit.
do
    local home = t.fresh_home(t.settings("tsv", "fixed", "scan", "window"))
    local room = t.new_room(home)
    local message = t.message({ written = 1000 })
    log.append(home, room, message)
    t.refuses(function() log.correct(home, room, edit_of(message)) end, "log.edit-window-seconds",
        "window: a missing log.edit-window-seconds is an error")
end

-- A hand-made edit by someone other than the author makes the room unreadable.
do
    local home = t.fresh_home(t.settings("tsv", "fixed", "scan", "corrections"))
    local room = t.new_room(home)
    local message = t.message({ id = "aaaa", written = 1000 })
    log.append(home, room, message)
    local file = assert(io.open(rooms.log_path(home, room), "ab"))
    file:write("bbbb\tmallory\t1001\t1001\tcorrection\taaaa\tforged\n")
    file:close()
    t.refuses(function() log.read_ordered(home, room) end, "edit by someone else",
        "a forged edit in the file is refused on reading")
end

t.refuses(function()
    local home = t.fresh_home(t.settings("tsv", "fixed", "scan", "sometimes"))
    local room = t.new_room(home)
    local message = t.message()
    log.append(home, room, message)
    log.correct(home, room, edit_of(message))
end, "not one of never", "a misspelt log.edits is an error")

t.finish()
