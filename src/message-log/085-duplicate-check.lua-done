-- 085-duplicate-check.lua — answers "is a message with this id already in
-- this log?", which is what makes a repeated delivery safe: the second copy
-- is recognised and not filed again.
--
-- Two ways of answering are built (config key log.duplicate-check, found
-- while building issue 105; the issue left "does the check need an index of
-- ids?" to measurement):
--
--   scan        read the whole log file every time and search it for the
--               id's marker (a piece of text that can only occur where that
--               record begins; see id_marker in 083-record-codecs.lua).
--               Nothing is kept between calls, so nothing can go stale, but
--               the work grows with the size of the log.
--   remembered  keep, in this program's memory, the set of ids seen in each
--               log and how far into the file they were read.  Each check
--               reads only what was added to the file since the last one.
--               The file is still the truth: before trusting its memory the
--               check makes sure the file still has the same beginning and
--               the same bytes just before where it stopped reading; if not
--               (the file was replaced, for example a test making a fresh
--               home in the same place), it forgets and reads from the start.
--               Nothing is written to disk.

local codecs = require("083-record-codecs")
local reader = require("084-log-reader")

local duplicates = {}

-- {{{ local function marker_found
-- True when `marker` (which starts with "\n") occurs in `content`, counting
-- the very start of the file as if a newline stood before it.
local function marker_found(content, marker)
    local at_start = marker:sub(2)
    -- Path: the file starts with the record — found.  Else search the rest.
    if content:sub(1, #at_start) == at_start then
        return true
    end
    return content:find(marker, 1, true) ~= nil
end
-- }}}

-- Which shapes' markers to search for, per log.shape-mixing value.
local SHAPES_TO_SEARCH = {
    -- {{{ local function fixed
    ["fixed"] = function(shape)
        return { shape }
    end,
    -- }}}
    -- {{{ local function per_record
    ["per-record"] = function(shape)
        return codecs.SHAPE_NAMES
    end,
    -- }}}
}

-- {{{ local function scan
local function scan(path, id, mixing, shape)
    local content = reader.read_file(path)
    local choose = SHAPES_TO_SEARCH[mixing]
    -- Path: known mixing value — search.  Unknown — let the reader's
    -- picker raise its error (one place owns that message).
    if not choose then
        reader.picker(mixing)
    end
    for _, each_shape in ipairs(choose(shape)) do
        -- Path: this shape's marker is in the file — a duplicate.
        if marker_found(content, codecs.get(each_shape).id_marker(id)) then
            return true
        end
    end
    return false
end
-- }}}

-- What `remembered` keeps per log path:
--   offset   integer  bytes of the file already read into `ids`
--   head     string   the file's first bytes (up to 64) when last read
--   tail     string   the (up to 64) bytes just before `offset`
--   ids      table    id string -> true
local memory = {}

local FINGERPRINT_BYTES = 64

-- {{{ local function still_same_file
-- True when the file still starts with the remembered head and still holds
-- the remembered tail just before the remembered offset.  Ids are random,
-- so a different file matching both is not a practical worry.
local function still_same_file(file, kept)
    local head = file:read(#kept.head) or ""
    -- Path: the beginning changed — a different file.
    if head ~= kept.head then
        return false
    end
    file:seek("set", kept.offset - #kept.tail)
    local tail = file:read(#kept.tail) or ""
    return tail == kept.tail
end
-- }}}

-- {{{ local function remembered
local function remembered(path, id, mixing, shape)
    local file = io.open(path, "rb")
    -- Path: opened — check.  Missing — the room is not there.
    if not file then
        error("message-log: no log at " .. path .. " (is the room there?)", 0)
    end
    local size = file:seek("end")
    local kept = memory[path]
    file:seek("set", 0)
    -- Path: nothing remembered, the file is now shorter than what was read,
    -- or it no longer matches — start afresh from byte 0.  Otherwise carry on
    -- from the remembered offset.
    if not kept or size < kept.offset or not still_same_file(file, kept) then
        kept = { offset = 0, head = "", tail = "", ids = {} }
        memory[path] = kept
    end
    file:seek("set", kept.offset)
    local added = file:read("*a")
    -- Path: something new — parse it.  Nothing new — memory is current.
    if #added > 0 then
        local records = reader.parse(added, mixing, shape)
        for _, record in ipairs(records) do
            kept.ids[record.id] = true
        end
        kept.offset = kept.offset + #added
        file:seek("set", 0)
        kept.head = file:read(math.min(FINGERPRINT_BYTES, kept.offset))
        file:seek("set", kept.offset - math.min(FINGERPRINT_BYTES, kept.offset))
        kept.tail = file:read(math.min(FINGERPRINT_BYTES, kept.offset))
    end
    file:close()
    return kept.ids[id] == true
end
-- }}}

local STRATEGIES = { ["scan"] = scan, ["remembered"] = remembered }

-- {{{ function duplicates.contains
-- path:     string, the log file.
-- id:       string, the message id looked for.
-- strategy: string, "scan" or "remembered" (log.duplicate-check).
-- mixing:   string, log.shape-mixing.  shape: string, log.record-shape.
-- Gives:    bool.
function duplicates.contains(path, id, strategy, mixing, shape)
    local check = STRATEGIES[strategy]
    -- Path: known strategy — run it.  Unknown — refuse (config typo).
    if not check then
        error("message-log: log.duplicate-check '" .. tostring(strategy)
            .. "' is not one of scan, remembered", 0)
    end
    return check(path, id, mixing, shape)
end
-- }}}

-- {{{ function duplicates.forget
-- Drops what `remembered` holds for one log (or every log when path is
-- the string "all").  For tests and for a program that knows a log was
-- replaced; the fingerprint check catches replacement anyway.
function duplicates.forget(path)
    -- Path: "all" — clear everything.  A path — clear that one.
    if path == "all" then
        memory = {}
    else
        memory[path] = nil
    end
end
-- }}}

return duplicates
