-- 086-edits.lua — whether a sent message may be corrected or deleted, and
-- how a room looks once corrections are taken into account (open
-- question 12, config key log.edits).
--
-- The log is never rewritten, so an edit is itself a new record added to
-- the end of the file: a "correction" carrying the new text, or a
-- "deletion", each naming the id of the message it changes (its target).
-- The original stays in the file, readable with cat; the room view shows
-- the latest text.  Three rules are built:
--
--   never        no corrections or deletions may be filed.
--   corrections  the author of a message may correct or delete it at any
--                time.
--   window       as corrections, but only within log.edit-window-seconds
--                of the message being written (measured between the two
--                records' "written" times).
--
-- The rule governs filing new edits only.  When reading, every correction
-- or deletion already in the file is applied whatever the rule says now:
-- the file is the record of what happened, and a rule changed later does
-- not un-happen it.

local edits = {}

-- {{{ local function find_target
-- Gives the "message" record with id `target` from `records`, or raises an
-- error naming why the edit cannot be filed.
local function find_target(records, edit)
    local found
    local deleted = false
    for _, record in ipairs(records) do
        -- Path: the original message — remember it.  A deletion of it —
        -- note that it is gone.  Anything else — not relevant.
        if record.id == edit.target and record.kind == "message" then
            found = record
        elseif record.kind == "deletion" and record.target == edit.target then
            deleted = true
        end
    end
    -- Path: no such message here — refuse (phase 1 files edits only for
    -- messages already in the log; see issue 105's open questions for edits
    -- that arrive before their message).
    if not found then
        error("message-log: no message '" .. edit.target .. "' in this room to "
            .. (edit.kind == "deletion" and "delete" or "correct"), 0)
    end
    -- Path: another person's message — refuse; only its author may edit it.
    if found.author ~= edit.author then
        error("message-log: '" .. edit.author .. "' may not edit a message written by '"
            .. found.author .. "'", 0)
    end
    -- Path: already deleted — refuse; there is nothing left to change.
    if deleted then
        error("message-log: message '" .. edit.target .. "' was already deleted", 0)
    end
    return found
end
-- }}}

-- One entry per log.edits value.  Each takes the room's records, the edit
-- about to be filed, and a function that reads a config key; it returns
-- nothing when the edit may be filed and raises an error when it may not.
local RULES = {
    -- {{{ local function never
    ["never"] = function(records, edit, config_value)
        error("message-log: edits are off in this home (log.edits = never)", 0)
    end,
    -- }}}
    -- {{{ local function corrections
    ["corrections"] = function(records, edit, config_value)
        find_target(records, edit)
    end,
    -- }}}
    -- {{{ local function window
    ["window"] = function(records, edit, config_value)
        local target = find_target(records, edit)
        local text = config_value("log.edit-window-seconds")
        local seconds = tonumber(text)
        -- Path: a whole number of seconds — use it.  Anything else — refuse.
        if not text:match("^%d+$") or not seconds then
            error("message-log: log.edit-window-seconds '" .. text .. "' is not a whole number", 0)
        end
        local age = edit.written - target.written
        -- Path: within the window — allowed.  Past it — refused.
        if age > seconds then
            error("message-log: too late to edit '" .. edit.target .. "': " .. age
                .. " seconds after it was written, window is " .. seconds, 0)
        end
    end,
    -- }}}
}

-- {{{ function edits.check
-- mode:         string, log.edits value.
-- records:      list, the room's records in file order.
-- edit:         record of kind "correction" or "deletion".
-- config_value: function(key) -> string, erroring on an absent key.
-- Gives nothing; raises an error when the edit is refused.
function edits.check(mode, records, edit, config_value)
    local rule = RULES[mode]
    -- Path: known rule — apply it.  Unknown — refuse (config typo).
    if not rule then
        error("message-log: log.edits '" .. tostring(mode)
            .. "' is not one of never, corrections, window", 0)
    end
    rule(records, edit, config_value)
end
-- }}}

-- {{{ local function later
-- The order in which edits of one message take effect: by written time,
-- then by id, so every reader agrees on which correction is the latest.
local function later(a, b)
    -- Path: different times — the later time wins.  Same time — larger id.
    if a.written ~= b.written then
        return a.written > b.written
    end
    return a.id > b.id
end
-- }}}

-- {{{ function edits.apply
-- records: list, the room's records in file order.
-- Gives:   list of message views (only kind "message"), in file order, each
--          { id, author, written, arrived, text  (strings/integers as in the
--            record, text being the latest correction's text),
--            edited  = bool (at least one correction applies),
--            deleted = bool (a deletion applies; text is then "") }.
-- A correction or deletion whose message is not in the file is left out
-- quietly: it may belong to a message that has not arrived yet (phase 2).
function edits.apply(records)
    local latest_fix = {}
    local deletions = {}
    for _, record in ipairs(records) do
        -- Path: a correction — keep it if it is the latest for its target.
        -- A deletion — mark the target.  A message — nothing to collect.
        if record.kind == "correction" then
            local held = latest_fix[record.target]
            if not held or later(record, held) then
                latest_fix[record.target] = record
            end
        elseif record.kind == "deletion" then
            deletions[record.target] = record
        end
    end
    local views = {}
    for _, record in ipairs(records) do
        -- Path: a message — build its view.  Edits — already folded in.
        if record.kind == "message" then
            local fix = latest_fix[record.id]
            local deletion = deletions[record.id]
            local deleted = deletion ~= nil
            -- Path: an edit by someone other than the author is in the file —
            -- filing never allows that, so the file was altered by hand or by
            -- a faulty program; refuse to show it rather than pick a side.
            if (fix and fix.author ~= record.author)
                or (deletion and deletion.author ~= record.author) then
                error("message-log: message '" .. record.id .. "' by '" .. record.author
                    .. "' has an edit by someone else in the log", 0)
            end
            local text = record.text
            -- Path: deleted — no text.  Corrected — the latest text.
            -- Neither — as written.
            if deleted then
                text = ""
            elseif fix then
                text = fix.text
            end
            views[#views + 1] = {
                id = record.id, author = record.author,
                written = record.written, arrived = record.arrived,
                text = text, edited = fix ~= nil, deleted = deleted,
            }
        end
    end
    return views
end
-- }}}

return edits
