-- 081-message-log.lua — a room's messages: filing them, refusing repeats,
-- reading them back in file order or in the order they were written, making
-- corrections, and copying one room's log into another.
--
-- Every room folder holds a file called `log` (made empty by room-folders,
-- issue 101).  Filing a message adds one record to the end of that file; the
-- file is never rewritten, so a person can read a room with cat, back it up
-- by copying the folder, and search it with grep.
--
-- Before a record is added, the log is asked whether a record with the same
-- message id is already there.  If so the message is answered "duplicate"
-- and not filed again: a delivery repeated because the first answer was
-- lost does no harm.  (rmail, September 2026: two daemons dialling each
-- other at once filed one message eight times.)
--
-- Order is decided when reading, never by moving records in the file: a
-- message that arrives late is written at the end of the file but shown
-- where its written time puts it.
--
-- After anything is filed the room-folders change bell is rung with "log",
-- so modules that keep derived views (for example 103's heard-from lists)
-- can catch up.
--
-- Which choices this module reads from rao-home/config (all required; an
-- absent key is an error, there is no default):
--   log.record-shape        tsv | block | jsonl            (open question 8)
--   log.shape-mixing        fixed | per-record             (found in 105)
--   log.duplicate-check     scan | remembered              (found in 105)
--   log.edits               never | corrections | window   (open question 12)
--   log.edit-window-seconds whole number, read only when log.edits = window

local rooms = require("002-room-folders")
local ids = require("082-message-ids")
local codecs = require("083-record-codecs")
local reader = require("084-log-reader")
local duplicates = require("085-duplicate-check")
local edits = require("086-edits")

local log = {}

-- {{{ local function settings
-- Reads the three keys every read or write needs, once per call.
local function settings(home)
    return {
        shape = rooms.config_value(home, "log.record-shape"),
        mixing = rooms.config_value(home, "log.shape-mixing"),
        duplicate_check = rooms.config_value(home, "log.duplicate-check"),
    }
end
-- }}}

-- {{{ local function check_record
-- Refuses a record that could not be written and read back faithfully.
local function check_record(record)
    ids.check_id(record.id, "message id")
    ids.check_author(record.author)
    ids.check_time(record.written, "written")
    ids.check_time(record.arrived, "arrived")
    -- Path: text is a string (any bytes) — fine.  Else — caller error.
    if type(record.text) ~= "string" then
        error("message-log: text must be a string, got " .. type(record.text), 0)
    end
    -- Path: a plain message has no target; an edit names one.
    if record.kind == "message" then
        -- Path: target is "" — fine.  Anything else — a message cannot
        -- point at another message.
        if record.target ~= "" then
            error("message-log: a message record must have target \"\"", 0)
        end
    else
        ids.check_id(record.target, "target")
        -- Path: an edit naming itself — refuse.
        if record.target == record.id then
            error("message-log: an edit cannot name its own id as its target", 0)
        end
    end
end
-- }}}

-- {{{ local function file_record
-- Adds one checked record to a room's log unless its id is already there.
-- ring: bool, whether to ring the change bell (copy_log rings once at the
-- end instead of once per record).
-- Gives "filed" or "duplicate".
local function file_record(home, room_id, record, config, ring)
    local path = rooms.log_path(home, room_id)
    -- Path: the id is already in the log — a repeat; file nothing.
    if duplicates.contains(path, record.id, config.duplicate_check, config.mixing, config.shape) then
        return "duplicate"
    end
    local encoded = codecs.get(config.shape).encode(record)
    -- The whole record goes out in one write to a file opened for appending,
    -- so two programs appending at once put whole records one after the
    -- other (Linux appends each write at the end atomically for regular
    -- files of this size), rather than interleaving pieces.
    local file = io.open(path, "ab")
    -- Path: opened — write.  Not openable — refuse (permissions, disk).
    if not file then
        error("message-log: cannot open " .. path .. " to append", 0)
    end
    file:write(encoded)
    file:close()
    -- Path: ring the bell now — single filing.  Don't — the caller rings.
    if ring then
        rooms.notify(home, room_id, "log")
    end
    return "filed"
end
-- }}}

-- {{{ function log.new_message_id
-- Gives: string, 32 lower-case hex characters from /dev/urandom.
function log.new_message_id()
    return ids.new_message_id()
end
-- }}}

-- {{{ function log.append
-- message: { id=string, author=string, written=integer, arrived=integer,
--            text=string }.  A `kind` field, if given, must be "message";
--            corrections and deletions go through log.correct / log.delete.
-- Gives:   "filed" or "duplicate".
function log.append(home, room_id, message)
    -- Path: kind absent or "message" — a plain message.  Else — refuse, the
    -- edit rules must not be skipped by filing an edit through append.
    if message.kind ~= nil and message.kind ~= "message" then
        error("message-log: append files messages only; use correct or delete for '"
            .. tostring(message.kind) .. "'", 0)
    end
    local record = {
        id = message.id, author = message.author,
        written = message.written, arrived = message.arrived,
        kind = "message", target = "", text = message.text,
    }
    check_record(record)
    return file_record(home, room_id, record, settings(home), true)
end
-- }}}

-- {{{ local function file_edit
local function file_edit(home, room_id, record)
    check_record(record)
    local config = settings(home)
    -- A repeated delivery of an edit already filed is a duplicate, not a
    -- refusal, so the duplicate check comes before the edit rules.
    -- Path: already here — "duplicate".  New — check the rules, then file.
    if duplicates.contains(rooms.log_path(home, room_id), record.id,
        config.duplicate_check, config.mixing, config.shape) then
        return "duplicate"
    end
    local records = reader.parse(reader.read_file(rooms.log_path(home, room_id)),
        config.mixing, config.shape)
    edits.check(rooms.config_value(home, "log.edits"), records, record, function(key)
        return rooms.config_value(home, key)
    end)
    return file_record(home, room_id, record, config, true)
end
-- }}}

-- {{{ function log.correct
-- correction: { id=string (a new message id), author=string,
--               written=integer, arrived=integer, target=string (the id
--               of the message corrected), text=string (the new text) }.
-- Gives "filed" or "duplicate"; raises an error when log.edits refuses.
function log.correct(home, room_id, correction)
    return file_edit(home, room_id, {
        id = correction.id, author = correction.author,
        written = correction.written, arrived = correction.arrived,
        kind = "correction", target = correction.target, text = correction.text,
    })
end
-- }}}

-- {{{ function log.delete
-- deletion: { id=string (a new message id), author=string, written=integer,
--             arrived=integer, target=string }.  Gives as log.correct.
function log.delete(home, room_id, deletion)
    return file_edit(home, room_id, {
        id = deletion.id, author = deletion.author,
        written = deletion.written, arrived = deletion.arrived,
        kind = "deletion", target = deletion.target, text = "",
    })
end
-- }}}

-- {{{ function log.has_message
-- Gives bool: is a record with this id (message or edit) in the room's log.
function log.has_message(home, room_id, message_id)
    local config = settings(home)
    return duplicates.contains(rooms.log_path(home, room_id), message_id,
        config.duplicate_check, config.mixing, config.shape)
end
-- }}}

-- {{{ function log.read
-- Gives every record in the room's log in file order: messages, and any
-- corrections and deletions, each { id, author, written, arrived, kind,
-- target, text } (see 083-record-codecs.lua).  Plain messages have kind
-- "message" and target "".
function log.read(home, room_id)
    local config = settings(home)
    return (reader.parse(reader.read_file(rooms.log_path(home, room_id)),
        config.mixing, config.shape))
end
-- }}}

-- {{{ function log.read_ordered
-- Gives the room as a person should see it: messages only, corrections
-- applied, sorted by written time, then room id, then message id.
-- Each is { id, author, written, arrived, text, edited=bool, deleted=bool }.
-- Every message in one log belongs to the room being read, so the room-id
-- step never separates two of them here; it is kept so that a later view
-- merging several rooms sorts the same way.
function log.read_ordered(home, room_id)
    local views = edits.apply(log.read(home, room_id))
    for _, view in ipairs(views) do
        view.room_id = room_id
    end
    table.sort(views, function(a, b)
        -- Path: written times differ — earlier first.  Same time, different
        -- rooms — smaller room id first.  Else — smaller message id first.
        if a.written ~= b.written then
            return a.written < b.written
        end
        if a.room_id ~= b.room_id then
            return a.room_id < b.room_id
        end
        return a.id < b.id
    end)
    return views
end
-- }}}

-- {{{ function log.copy_log
-- Files every record of one room's log into another room's log, in file
-- order, through the same duplicate check (so copying twice files nothing
-- the second time) and in the shape configured now.  Edits are copied as
-- history: the edit rules are not asked again.  Rings the bell once for the
-- receiving room when anything was filed.
-- Gives the number of records filed (integer).
function log.copy_log(home, from_id, to_id)
    local config = settings(home)
    local records = log.read(home, from_id)
    local filed = 0
    for _, record in ipairs(records) do
        check_record(record)
        -- Path: filed — count it.  Duplicate — already there, skip.
        if file_record(home, to_id, record, config, false) == "filed" then
            filed = filed + 1
        end
    end
    -- Path: something new arrived — tell listeners once.  Nothing — silence.
    if filed > 0 then
        rooms.notify(home, to_id, "log")
    end
    return filed
end
-- }}}

-- {{{ function log.forget_remembered_ids
-- Drops the in-memory id sets kept by log.duplicate-check = remembered
-- (argument: a log path, or "all").  Only needed by tests and tools that
-- replace log files; replacement is also detected on its own.
function log.forget_remembered_ids(path)
    duplicates.forget(path)
end
-- }}}

return log
