# rao-chat home: @HOME_COMMENT@
# A systemd system service for this home (issue 604), written by
# scripts/install-home; re-running the installer writes it again.  The
# launcher (scripts/run-home) reads the home's environment file, and it
# stops the home's programs itself: KillMode=mixed sends the stop signal to
# it alone, and only what is left after TimeoutStopSec is killed.
[Unit]
Description=rao-chat home @SERVICE@
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
ExecStart=@EXEC_SYSTEMD@
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=60
StandardOutput=append:@LOG@
StandardError=append:@LOG@

[Install]
WantedBy=multi-user.target
