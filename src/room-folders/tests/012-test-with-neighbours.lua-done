-- 012-test-with-neighbours.lua — room-folders driven together with the
-- real modules that build on it (room-tree, recipients, people-links,
-- message-log), whichever of them exist yet.
--
-- The other four modules sign up to room-folders' change bell when they
-- are loaded, so every room made or changed here also makes them do their
-- work.  This file loads each neighbour that is present (and says SKIP
-- for any that is not), builds the owner's example tree in a fresh RAM
-- home with every setting filled in, and checks that what room-folders
-- promised them holds: a room is whole (log included) when the bell
-- rings, changes reach every listener, and a listener's failure reaches
-- the caller.  It then tries room-folders' two undecided choices with the
-- neighbours listening and prints what happened as NOTE lines — those are
-- findings for 019-options, not pass/fail checks.
-- Run: luajit 012-test-with-neighbours.lua [project folder]

local DIR = arg[1] or "/home/ritz/programs/rao-chat"
local kit = dofile(DIR .. "/src/room-folders/tests/006-kit-for-tests.lua")
local rooms = kit.setup(DIR)
local check, same, fails = kit.check, kit.same, kit.fails

-- Each neighbour by the name the contract gives its front door.
local NEIGHBOURS = {
    { key = "tree",       module = "021-room-tree" },
    { key = "recipients", module = "041-recipients" },
    { key = "people",     module = "061-people-links" },
    { key = "log",        module = "081-message-log" },
}

-- One value for every config key any module reads; a key missing here
-- shows up as an error naming it, which is itself worth seeing.
local SETTINGS = {
    ["rooms.unknown-parent"]     = "refuse",
    ["rooms.slash-in-name"]      = "refuse",
    ["tree.parent-disclosure"]   = "shared-only",
    ["recipients.split-shape"]   = "fork",
    ["recipients.arrival-list"]  = "adder-list",
    ["recipients.split-parent"]  = "keep",
    ["recipients.split-alone"]   = "keep-empty",
    ["people.link-collision"]    = "suffix-id",
    ["people.own-devices"]       = "none",
    ["people.split-records"]     = "hide",
    ["log.record-shape"]         = "tsv",
    ["log.shape-mixing"]         = "fixed",
    ["log.duplicate-check"]      = "scan",
    ["log.edits"]                = "never",
}

-- {{{ local function note
-- A finding, printed for the reader; not counted as pass or fail.
local function note(text)
    print("NOTE " .. text)
end
-- }}}

-- {{{ local function new_home
local function new_home(name)
    local home = rooms.open_home(kit.fresh_home_dir(name))
    for key, value in pairs(SETTINGS) do
        rooms.set_config(home, key, value)
    end
    kit.write_file(home.dir .. "/contacts",
        "girlfriend.token = \"g\"\nhousemate.token = \"h\"\ncoder.token = \"c\"\nphone.own = true\n")
    return home
end
-- }}}

local loaded = {}
for _, neighbour in ipairs(NEIGHBOURS) do
    local ok, result = pcall(require, neighbour.module)
    -- present: use it.  Absent or broken on load: skip, and say why.
    if ok then
        loaded[neighbour.key] = result
        print("LOADED " .. neighbour.module)
    else
        print("SKIP " .. neighbour.module .. ": " .. tostring(result):match("^[^\n]*"))
    end
end

check("every loaded neighbour signed up to the bell", function()
    local listening = 0
    for _ in pairs(loaded) do listening = listening + 1 end
    -- recipients and message-log may or may not listen; tree and people must.
    local must = (loaded.tree and 1 or 0) + (loaded.people and 1 or 0)
    same(rooms.listener_count() >= must, true, "at least " .. must .. " listeners, have " .. rooms.listener_count())
end)

local home = new_home("neighbours")
local top, middle, bottom

check("the owner's tree builds with every neighbour listening", function()
    top = rooms.create_room(home, { name = "home", parent_id = "", recipients = { "girlfriend", "housemate" } })
    middle = rooms.create_room(home, { name = "ritz", parent_id = top, recipients = {} })
    bottom = rooms.create_room(home, { name = "programming", parent_id = middle, recipients = { "girlfriend", "coder" } })
end)

check("room-tree: where files follow names", function()
    -- absent neighbour: nothing to check.
    if not loaded.tree then return end
    same(loaded.tree.path_of_names(home, bottom), "home/ritz/programming")
    rooms.write_name(home, middle, "me-only")
    same(loaded.tree.path_of_names(home, bottom), "home/me-only/programming")
    local where = kit.read_file(rooms.room_dir(home, bottom) .. "/where")
    same(where:find("home/me-only/programming", 1, true) ~= nil, true, "where file rewritten by the bell")
    rooms.write_name(home, middle, "ritz")
end)

check("people-links: girlfriend sees two tops, coder one", function()
    if not loaded.people then return end
    local girlfriend = loaded.people.top_rooms_for(home, "girlfriend")
    table.sort(girlfriend)
    local want = { top, bottom }
    table.sort(want)
    same(#girlfriend, 2, "girlfriend's tops")
    same(girlfriend[1], want[1])
    same(girlfriend[2], want[2])
    same(#loaded.people.top_rooms_for(home, "coder"), 1, "coder's tops")
    -- adding her to ritz closes the gap: one tree
    rooms.write_recipients(home, middle, { "girlfriend" })
    same(#loaded.people.top_rooms_for(home, "girlfriend"), 1, "after adding her to ritz")
    rooms.write_recipients(home, middle, {})
end)

check("message-log: a brand-new room takes a message at once", function()
    if not loaded.log then return end
    local id = rooms.create_room(home, { name = "fresh", parent_id = "", recipients = { "coder" } })
    local message = { id = loaded.log.new_message_id(), author = "me", written = 1790000000, arrived = 1790000000, text = "hello" }
    same(loaded.log.append(home, id, message), "filed")
    same(loaded.log.append(home, id, message), "duplicate")
    same(#loaded.log.read(home, id), 1)
end)

check("recipients: add and remove go through room-folders", function()
    if not loaded.recipients then return end
    loaded.recipients.add(home, bottom, "housemate")
    local list = rooms.read_room(home, bottom).recipients
    same(list[#list], "housemate")
    loaded.recipients.remove(home, bottom, "housemate")
    same(#rooms.read_room(home, bottom).recipients, 2)
end)

check("a failing neighbour listener reaches the writer", function()
    if not loaded.tree then return end
    -- a hand-damaged parent file makes room-tree's where-writer fail
    local id = rooms.create_room(home, { name = "victim", parent_id = "", recipients = {} })
    kit.write_file(rooms.room_dir(home, id) .. "/parent", "not an id\n")
    fails(function() rooms.write_name(home, id, "renamed") end, "damaged parent file")
    kit.write_file(rooms.room_dir(home, id) .. "/parent", "")
end)

-- The two undecided choices, with the neighbours listening.  Results are
-- findings; they are printed, not judged.

-- {{{ local function try
local function try(label, action)
    local ok, problem = pcall(action)
    -- ok: say it worked.  Not ok: say the first line of why.
    if ok then
        note(label .. ": worked")
    else
        note(label .. ": ERROR " .. tostring(problem):match("^[^\n]*"))
    end
end
-- }}}

do
    local probe = new_home("neighbours-slash")
    rooms.set_config(probe, "rooms.slash-in-name", "allow")
    local parent
    try("slash-in-name=allow, create top room 'home/ritz'", function()
        parent = rooms.create_room(probe, { name = "home/ritz", parent_id = "", recipients = { "girlfriend" } })
    end)
    note("  rooms on disk after that create: " .. #rooms.list_rooms(probe) .. " (the folder is made before the bell rings)")
    parent = parent or rooms.list_rooms(probe)[1]
    try("slash-in-name=allow, child 'code' under it", function()
        local child = rooms.create_room(probe, { name = "code", parent_id = parent, recipients = { "coder" } })
        -- present: show the ambiguity the owner would face.
        if loaded.tree then
            note("  path_of_names of the child = " .. loaded.tree.path_of_names(probe, child) ..
                 " (same text as three rooms home > ritz > code)")
        end
    end)
    if loaded.people then
        local ok, listing = pcall(require("003-disk").list_dir, probe.dir .. "/people/girlfriend")
        note("  people/girlfriend holds: " .. (ok and table.concat(listing, ", ") or tostring(listing)))
    end
end

do
    local probe = new_home("neighbours-unknown-parent")
    rooms.set_config(probe, "rooms.unknown-parent", "keep")
    local absent_parent = rooms.new_room_id()
    local child
    try("unknown-parent=keep, room arrives naming an absent parent", function()
        child = rooms.create_room(probe, { name = "programming", parent_id = absent_parent, recipients = { "girlfriend" } })
    end)
    if loaded.tree and child then
        note("  before the parent arrives, path_of_names = " .. tostring(loaded.tree.path_of_names(probe, child)))
    end
    try("unknown-parent=keep, the parent arrives with that id", function()
        rooms.create_room(probe, { name = "ritz", parent_id = "", recipients = { "girlfriend" }, room_id = absent_parent })
    end)
    if loaded.tree and child then
        note("  after the parent arrives, path_of_names = " .. tostring(loaded.tree.path_of_names(probe, child)))
        local where = kit.read_file(rooms.room_dir(probe, child) .. "/where")
        note("  child's where file after the parent arrived: " .. where:gsub("\n", " | "))
    end
    if loaded.people and child then
        note("  girlfriend's top rooms after: " .. #loaded.people.top_rooms_for(probe, "girlfriend"))
    end
end

kit.finish()
