-- 019-options.lua — the undecided choices found while building room-folders,
-- written down for the options tally (scripts/tally-options, issue 106).
--
-- Each entry is one question the owner (or some later state of the
-- project) has to settle.  Where a choice is switchable, every variant is
-- built and the home's config file picks the one in use; room-folders
-- only reads the key when the edge case actually happens, so a home that
-- never meets it never needs the setting.  "findings" are what building
-- and testing each variant showed, including runs with the real
-- neighbouring modules (tests/012-test-with-neighbours.lua).
-- Plain data: nothing here runs.

return {
    {
        id = "rooms-unknown-parent",
        question = "A room arrives naming a parent room you are not in (you hold no folder for it). "
            .. "Keep that parent id in the room's parent file, or refuse it?",
        waits_on = "owner",
        detail = "issue 101: new; tied to open question 3 (what travels with a message to place its room in a tree)",
        config_key = "rooms.unknown-parent",
        variants = {
            {
                name = "refuse",
                summary = "A parent id must name a room already in this home; anything else is an error.",
                built_in = "src/room-folders/002-room-folders.lua (check_parent, UNKNOWN_PARENT)",
                tests = "tests/011-test-variants.lua",
                findings = "Every parent file on disk points at a real folder, so any upward walk ends at a "
                    .. "top room with no special case. But a room that arrives from someone whose tree you "
                    .. "are only partly in must be made with parent \"\" (or not at all), and the id it "
                    .. "named is lost: when you are later added to the parent room, nothing joins the two "
                    .. "trees unless the parent id is sent again and the child is re-parented.",
            },
            {
                name = "keep",
                summary = "A parent id not held here is stored as written; the room reads as a top until "
                    .. "the parent arrives, then the tree joins by itself.",
                built_in = "src/room-folders/002-room-folders.lua (check_parent, UNKNOWN_PARENT); "
                    .. "room-tree 021 reads the same key and stops its upward walk there",
                tests = "tests/011-test-variants.lua, tests/012-test-with-neighbours.lua",
                findings = "With the real room-tree and people-links listening: before the parent arrives "
                    .. "the child's path of names is 'programming'; when the parent is created with the "
                    .. "id the child named, the child's where file is rewritten to 'ritz/programming' and "
                    .. "the girlfriend's people/ folder drops to one top — the owner's 'the full tree "
                    .. "structure would resolve for her', with no extra step. Cost: a loop can now close "
                    .. "through a room that is not here yet (b names absent a; a arrives naming b); the "
                    .. "loop check had to compare ids before checking a folder exists to catch it (test "
                    .. "'a loop through a kept parent is still refused'). Every module that walks upward "
                    .. "must treat 'parent id with no folder' as a top, not as damage.",
            },
        },
        leaning = "keep: it is the only variant where the owner's girlfriend example resolves by itself "
            .. "once she is added to the missing room, and room-tree already handles it.",
    },
    {
        id = "rooms-slash-in-name",
        question = "May a room's name contain '/'?",
        waits_on = "owner",
        detail = "issue 101: new; names are shown joined by '/' (home/ritz/programming) and people/ links "
            .. "are named after rooms",
        config_key = "rooms.slash-in-name",
        variants = {
            {
                name = "refuse",
                summary = "A name holding '/' is an error when a room is made or renamed.",
                built_in = "src/room-folders/002-room-folders.lua (check_name, SLASH_IN_NAME)",
                tests = "tests/011-test-variants.lua",
                findings = "Paths of names always split back into the same rooms, and every name can be a "
                    .. "link name in people/. The only cost is one character people cannot use.",
            },
            {
                name = "allow",
                summary = "A name is stored exactly as written, '/' and all.",
                built_in = "src/room-folders/002-room-folders.lua (check_name, SLASH_IN_NAME)",
                tests = "tests/011-test-variants.lua, tests/012-test-with-neighbours.lua",
                findings = "room-folders stores and reads 'home/ritz' fine, but with the real neighbours "
                    .. "listening the create fails: people-links (063-link-names) refuses 'home/ritz' as a "
                    .. "link name inside the 'created' ring, so create_room raises after the room folder "
                    .. "already exists (the room is on disk, its people/ links are not). A child 'code' "
                    .. "under it would read 'home/ritz/code', the same text as three rooms. So allow is not "
                    .. "workable unless people/ link names escape '/' and paths of names escape it too.",
            },
        },
        leaning = "refuse: allow breaks people/ links today and makes paths of names ambiguous.",
    },
    {
        id = "rooms-bell-failure",
        question = "When a module listening on the change bell fails after a room was written (say its "
            .. "people/ links cannot be built), should the room change stay, or be undone?",
        waits_on = "owner",
        detail = "issue 101: new; found when people-links refused a room name inside the 'created' ring",
        config_key = "",
        variants = {
            {
                name = "keep-and-raise",
                summary = "The write stays on disk; the listener's error reaches whoever made the change.",
                built_in = "src/room-folders/005-change-bell.lua (notify) — the only variant built",
                tests = "tests/010-test-change-bell.lua ('a failing listener's error reaches the writer'), "
                    .. "tests/012-test-with-neighbours.lua",
                findings = "Simple and loud: the caller learns at once. But the home is left with the room "
                    .. "changed and some summaries (where files, people/ links) not matching it, until the "
                    .. "cause is fixed and something rings again. Listeners earlier in the list have "
                    .. "already acted on the change.",
            },
            {
                name = "undo-and-raise",
                summary = "Put the old file back (or remove a new room) before passing the error on.",
                built_in = "not built",
                tests = "none",
                findings = "Not built: undoing would need the listeners that already ran to undo too (a "
                    .. "second ring with the old value), and a second failure during the undo has no good "
                    .. "answer. Would need a design for 'ring again to put things back'.",
            },
        },
        leaning = "keep-and-raise for phase 1; revisit if a listener is found that fails for ordinary "
            .. "reasons rather than on damaged or refused data.",
    },
    {
        id = "rooms-write-durability",
        question = "Should room files survive a power cut, not just a crash (fsync before rename)?",
        waits_on = "state",
        detail = "issue 101: new; waits on a measurement of how often rooms are written and on phase 6 "
            .. "(running as a service), where power loss becomes a real case",
        config_key = "",
        variants = {
            {
                name = "rename-only",
                summary = "Write a temporary file, then rename it over the old one.",
                built_in = "src/room-folders/003-disk.lua (write_atomic) — the only variant built",
                tests = "tests/008-test-home-and-config.lua and tests/009-test-rooms.lua (no temporary "
                    .. "files left behind)",
                findings = "A crashed program leaves either the old file or the new, never half. After a "
                    .. "power cut the filesystem may hold the renamed file with no contents yet (ext4 "
                    .. "usually protects rename-over-existing, not a first write). Tests run in RAM so "
                    .. "cannot show this either way.",
            },
            {
                name = "fsync-then-rename",
                summary = "Also force the file's bytes to disk before the rename (and the folder after).",
                built_in = "not built",
                tests = "none",
                findings = "Not built: needs file descriptors through LuaJIT's ffi (open/write/fsync) "
                    .. "instead of io.open, and costs a disk flush per write; worth measuring once "
                    .. "message traffic exists.",
            },
        },
        leaning = "rename-only until phase 6 measures the cost of fsync on a real home server.",
    },
}
