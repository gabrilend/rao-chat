-- 068-test-owners-example.lua — the owner's own example, in all three
-- collision modes, driven only by the change bell (no rebuild is called by
-- hand until people/ is deleted on purpose).
--
--   home          girlfriend, housemate
--   └── ritz      (just you)
--       └── programming   girlfriend, friend
--
-- The girlfriend gets two links (home, programming); adding her to ritz
-- leaves one (home); deleting people/ and rebuilding gives the same links.
--
-- Run: luajit 068-test-owners-example.lua [DIR] <stand-in|real>

local DIR = arg[1] or "/home/ritz/programs/rao-chat"
local H = dofile(DIR .. "/src/people-links/tests/065-test-harness.lua")
H.setup(DIR, arg[2])
local rooms, people = H.rooms, H.people

-- {{{ local function expected_view
-- What H.view should show for a map contact -> list of {name, room id},
-- in the given collision mode (names here never clash).
local function expected_view(mode, map)
    local out = {}
    for contact, list in pairs(map) do
        local prefix = contact .. "/"
        -- "" means a view of one person's folder: no folder line, no prefix
        if contact == "" then
            prefix = ""
        else
            out[#out + 1] = prefix
        end
        for _, entry in ipairs(list) do
            local name, id = entry[1], entry[2]
            -- id-folder: a folder per room with the link one level down
            if mode == "id-folder" then
                out[#out + 1] = prefix .. id .. "/"
                out[#out + 1] = prefix .. id .. "/" .. name .. " -> ../../../rooms/" .. id
            -- the other two: the link straight in the person's folder
            else
                out[#out + 1] = prefix .. name .. " -> ../../rooms/" .. id
            end
        end
    end
    table.sort(out)
    return out
end
-- }}}

-- {{{ local function sorted
local function sorted(list)
    local copy = {}
    for i, v in ipairs(list) do
        copy[i] = v
    end
    table.sort(copy)
    return copy
end
-- }}}

-- {{{ local function read_through
-- Reads a room's name file through a person's link, proving the relative
-- link really leads to the room.
local function read_through(path)
    local file = io.open(path .. "/name", "r")
    -- the link does not lead anywhere
    if file == nil then
        return "(unreachable)"
    end
    local line = file:read("*l")
    file:close()
    return line
end
-- }}}

-- {{{ local function link_path
local function link_path(home, mode, contact, name, id)
    -- id-folder: one level deeper
    if mode == "id-folder" then
        return home.dir .. "/people/" .. contact .. "/" .. id .. "/" .. name
    end
    return home.dir .. "/people/" .. contact .. "/" .. name
end
-- }}}

for _, mode in ipairs(H.names.MODES) do
    local home = H.fresh_home("owners-example-" .. mode, mode)
    local home_id = H.room(home, "home", "", { "girlfriend", "housemate" })
    local ritz_id = H.room(home, "ritz", home_id, {})
    local prog_id = H.room(home, "programming", ritz_id, { "girlfriend", "friend" })

    H.same(people.top_rooms_for(home, "girlfriend"), sorted({ home_id, prog_id }),
           mode .. ": girlfriend's tops are home and programming")
    H.same(people.top_rooms_for(home, "friend"), { prog_id }, mode .. ": friend's top is programming")
    H.same(people.top_rooms_for(home, "housemate"), { home_id }, mode .. ": housemate's top is home")
    H.same(people.top_rooms_for(home, "phone"), {}, mode .. ": own device none: no tops")

    local before = H.view(home)
    H.same(before, expected_view(mode, {
        girlfriend = { { "home", home_id }, { "programming", prog_id } },
        friend     = { { "programming", prog_id } },
        housemate  = { { "home", home_id } },
    }), mode .. ": the bell alone built people/ (girlfriend has two links)")

    H.check(read_through(link_path(home, mode, "girlfriend", "programming", prog_id)) == "programming",
            mode .. ": girlfriend/programming leads to the programming room")

    -- the planned links match what is on disk
    local planned = people.planned_links(home, "girlfriend")
    H.check(#planned == 2, mode .. ": two planned links for girlfriend")

    -- delete people/ entirely and rebuild: the same view
    os.execute('rm -rf "' .. home.dir .. '/people"')
    H.same(H.view(home), {}, mode .. ": people/ really gone")
    people.rebuild_all(home)
    H.same(H.view(home), before, mode .. ": deleting people/ and rebuilding gives the same links")

    -- rebuilding again changes nothing
    people.rebuild_all(home)
    H.same(H.view(home), before, mode .. ": a second rebuild is a no-op")

    -- add her to ritz: the gap closes, one link left
    rooms.write_recipients(home, ritz_id, { "girlfriend" })
    H.same(people.top_rooms_for(home, "girlfriend"), { home_id }, mode .. ": after adding her to ritz, one top")
    H.same(H.view(home, "girlfriend"), expected_view(mode, { [""] = { { "home", home_id } } }), mode
           .. ": after adding her to ritz, girlfriend/ holds only home")
    H.same(H.view(home, "friend"), expected_view(mode, { [""] = { { "programming", prog_id } } }),
           mode .. ": friend unchanged")

    -- and rebuilding from nothing still agrees
    local after = H.view(home)
    os.execute('rm -rf "' .. home.dir .. '/people"')
    people.rebuild_all(home)
    H.same(H.view(home), after, mode .. ": rebuild from nothing after the change")

    -- renaming a room renames the links
    rooms.write_name(home, home_id, "house")
    H.check(read_through(link_path(home, mode, "girlfriend", "house", home_id)) == "house",
            mode .. ": renamed room, renamed link")
    H.check(not H.disk.exists(link_path(home, mode, "girlfriend", "home", home_id)),
            mode .. ": old name's link gone")

    -- moving programming to the top: friend unchanged, girlfriend gains it
    rooms.write_parent(home, prog_id, "")
    H.same(people.top_rooms_for(home, "girlfriend"), sorted({ home_id, prog_id }),
           mode .. ": moving programming to the top makes it a top again")

    -- removing the housemate from home empties and removes her folder
    rooms.write_recipients(home, home_id, { "girlfriend" })
    H.check(not H.disk.exists(home.dir .. "/people/housemate"), mode .. ": housemate's empty folder removed")

    -- the whole rao-home copied elsewhere: links still lead to rooms there
    local copy = home.dir .. "-copy"
    os.execute('rm -rf "' .. copy .. '"')
    os.execute('cp -a "' .. home.dir .. '" "' .. copy .. '"')
    local copied = copy .. link_path(home, mode, "friend", "programming", prog_id):sub(#home.dir + 1)
    H.check(read_through(copied) == "programming", mode .. ": links still work in a copied rao-home")
end

H.finish()
