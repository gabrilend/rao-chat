-- 064-stand-in-room-folders.lua — a small stand-in for the room-folders
-- module (issue 101), written only so the people-links tests can run before
-- the real one exists.
--
-- It keeps rooms on disk as the phase 1 contract describes (a folder per
-- room id holding name, parent and recipients files), reads the config and
-- contacts files in rmail's "key = value" shapes, and rings a change bell
-- that listeners hear after every write.  It does only what the contract
-- promises.  The test runner uses the real module instead when it exists.
--
-- Stand-in file shapes (private to this stand-in; the real 101 may differ,
-- which is why people-links only reads rooms through the functions):
--   rooms/<id>/name        one line
--   rooms/<id>/parent      one line, empty for a top room
--   rooms/<id>/recipients  one name per line

local M = {}

local listeners = {}

-- {{{ local function read_lines
local function read_lines(path)
    local file = assert(io.open(path, "r"))
    local lines = {}
    for line in file:lines() do
        lines[#lines + 1] = line
    end
    file:close()
    return lines
end
-- }}}

-- {{{ local function write_text
local function write_text(path, text)
    local file = assert(io.open(path, "w"))
    file:write(text)
    file:close()
end
-- }}}

-- {{{ local function first_line
-- A one-line file; an empty file reads as "" (a top room's parent).
local function first_line(path)
    local lines = read_lines(path)
    return lines[1] or ""
end
-- }}}

-- {{{ function M.open_home
function M.open_home(dir)
    os.execute('mkdir -p "' .. dir .. '/rooms" "' .. dir .. '/people"')
    for _, name in ipairs({ "config", "contacts" }) do
        local path = dir .. "/" .. name
        local file = io.open(path, "r")
        -- present: leave it; absent: make it empty
        if file then
            file:close()
        else
            write_text(path, "")
        end
    end
    return { dir = dir }
end
-- }}}

-- {{{ function M.read_config
function M.read_config(home)
    local config = {}
    for _, line in ipairs(read_lines(home.dir .. "/config")) do
        local key, value = line:match("^%s*([^=%s]+)%s*=%s*(.-)%s*$")
        -- a key = value line: keep it; anything else: skip
        if key then
            config[key] = value
        end
    end
    return config
end
-- }}}

-- {{{ function M.set_config
function M.set_config(home, key, value)
    local config = M.read_config(home)
    config[key] = value
    local keys = {}
    for k in pairs(config) do
        keys[#keys + 1] = k
    end
    table.sort(keys)
    local out = {}
    for _, k in ipairs(keys) do
        out[#out + 1] = k .. " = " .. config[k] .. "\n"
    end
    write_text(home.dir .. "/config", table.concat(out))
end
-- }}}

-- {{{ function M.config_value
function M.config_value(home, key)
    local value = M.read_config(home)[key]
    -- absent: loud, no default
    if value == nil then
        error("stand-in room-folders: config has no " .. key)
    end
    return value
end
-- }}}

-- {{{ function M.read_contacts
function M.read_contacts(home)
    local contacts = {}
    for _, line in ipairs(read_lines(home.dir .. "/contacts")) do
        local name, field, value = line:match("^%s*([^.%s]+)%.([^=%s]+)%s*=%s*(.-)%s*$")
        -- a name.field = value line: keep it; anything else: skip
        if name then
            contacts[name] = contacts[name] or {}
            contacts[name][field] = value
        end
    end
    return contacts
end
-- }}}

-- {{{ function M.new_room_id
function M.new_room_id()
    local file = assert(io.open("/dev/urandom", "rb"))
    local bytes = file:read(16)
    file:close()
    local hex = {}
    for i = 1, #bytes do
        hex[i] = string.format("%02x", bytes:byte(i))
    end
    return table.concat(hex)
end
-- }}}

-- {{{ function M.room_dir
function M.room_dir(home, id)
    return home.dir .. "/rooms/" .. id
end
-- }}}

-- {{{ function M.log_path
function M.log_path(home, id)
    return M.room_dir(home, id) .. "/log"
end
-- }}}

-- {{{ function M.room_exists
function M.room_exists(home, id)
    local file = io.open(M.room_dir(home, id) .. "/name", "r")
    -- a name file: the room is there
    if file then
        file:close()
        return true
    end
    return false
end
-- }}}

-- {{{ function M.on_change
function M.on_change(listener)
    listeners[#listeners + 1] = listener
end
-- }}}

-- {{{ function M.notify
function M.notify(home, id, what)
    for _, listener in ipairs(listeners) do
        listener(home, id, what)
    end
end
-- }}}

-- {{{ function M.create_room
function M.create_room(home, spec)
    local id = spec.room_id or M.new_room_id()
    local dir = M.room_dir(home, id)
    os.execute('mkdir -p "' .. dir .. '"')
    write_text(dir .. "/name", spec.name .. "\n")
    write_text(dir .. "/parent", spec.parent_id .. "\n")
    write_text(dir .. "/recipients", table.concat(spec.recipients, "\n")
                                       .. (#spec.recipients > 0 and "\n" or ""))
    write_text(dir .. "/log", "")
    M.notify(home, id, "created")
    return id
end
-- }}}

-- {{{ function M.read_room
function M.read_room(home, id)
    local dir = M.room_dir(home, id)
    return {
        id = id,
        name = first_line(dir .. "/name"),
        parent_id = first_line(dir .. "/parent"),
        recipients = read_lines(dir .. "/recipients"),
    }
end
-- }}}

-- {{{ function M.write_name
function M.write_name(home, id, value)
    write_text(M.room_dir(home, id) .. "/name", value .. "\n")
    M.notify(home, id, "name")
end
-- }}}

-- {{{ function M.write_parent
function M.write_parent(home, id, value)
    write_text(M.room_dir(home, id) .. "/parent", value .. "\n")
    M.notify(home, id, "parent")
end
-- }}}

-- {{{ function M.write_recipients
function M.write_recipients(home, id, list)
    write_text(M.room_dir(home, id) .. "/recipients", table.concat(list, "\n")
                                                     .. (#list > 0 and "\n" or ""))
    M.notify(home, id, "recipients")
end
-- }}}

-- {{{ function M.list_rooms
function M.list_rooms(home)
    local listing = io.popen('ls -1 "' .. home.dir .. '/rooms"')
    local ids = {}
    for entry in listing:lines() do
        ids[#ids + 1] = entry
    end
    listing:close()
    table.sort(ids)
    return ids
end
-- }}}

return M
