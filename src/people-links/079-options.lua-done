-- 079-options.lua — the undecided choices in the people-links module,
-- written down for the options tally (scripts/tally-options, issue 106).
--
-- Each entry is one question the owner (or some later state of the project)
-- has to settle.  Every switchable variant is built and tested; the home's
-- config file picks the one in use.  The findings are what building and
-- testing each variant actually showed.  Plain data: nothing here runs.

return {
    {
        id = "people-link-collision",
        question = "Two top rooms you share with one person have the same name. What are their links in people/<person>/ called?",
        waits_on = "owner",
        detail = "issue 104: new question, not yet in the planning document",
        config_key = "people.link-collision",
        variants = {
            {
                name = "suffix-id",
                summary = "Clashing rooms get a tag from their room id: programming~3fa9, programming~b710. Rooms that do not clash keep their plain name.",
                built_in = "src/people-links/063-link-names.lua (name_suffix_id)",
                tests = "tests/066-test-link-names.lua, tests/069-test-collisions-on-disk.lua",
                findings = "A clashing room's link name depends only on its own name and id, so a third "
                    .. "'programming' arriving adds a link without renaming the other two. Two ids sharing "
                    .. "their first four characters (1 in 65536 per pair) grow to five characters for that "
                    .. "group (tested). A room really named 'p~3fa9' keeps its name and the made-up ones grow "
                    .. "longer instead of landing on it (tested). The first time a clash appears, the room "
                    .. "that had the bare name gains a tag too (both are tagged, symmetrically), so an "
                    .. "existing link does move once. '~' is legal in file names but needs quoting in some "
                    .. "shells when it starts a word (it never does here).",
            },
            {
                name = "numbered",
                summary = "Clashing rooms are numbered in room-id order: programming, programming-2, programming-3.",
                built_in = "src/people-links/063-link-names.lua (name_numbered)",
                tests = "tests/066-test-link-names.lua, tests/069-test-collisions-on-disk.lua",
                findings = "Reads most naturally in ls, and the same set of rooms always gets the same "
                    .. "numbers on every rebuild. But the numbers belong to the set, not to a room: a new "
                    .. "clashing room whose id sorts lower takes the bare name and pushes every higher one "
                    .. "up by one (tested: a middle id arriving turns HIGH's 'programming-2' into "
                    .. "'programming-3'). So a path someone remembered or scripted can come to mean a "
                    .. "different room. A room really named 'p-2' is skipped over (the clash then gets p, p-3).",
            },
            {
                name = "id-folder",
                summary = "Every top room gets a folder named by its room id, with the named link inside: people/<person>/<room id>/programming.",
                built_in = "src/people-links/063-link-names.lua (name_id_folder)",
                tests = "tests/066-test-link-names.lua, tests/068-test-owners-example.lua, tests/069-test-collisions-on-disk.lua",
                findings = "Names can never clash and no link ever moves when another room appears. The "
                    .. "cost is that 'ls people/girlfriend' shows 32-character ids, not names: answering "
                    .. "'what do I share with her' takes 'ls people/girlfriend/*' instead. Each shared top "
                    .. "room costs one extra folder, and the rebuild has to look one level deeper to sweep "
                    .. "(an emptied id folder is removed; one holding someone's own file is kept). Switching "
                    .. "to or from this mode leaves nothing of the old shape behind (all six switches tested).",
            },
        },
        leaning = "suffix-id: names stay readable and a link's name never changes because some other "
            .. "room appeared; numbered is friendlier to read but renumbers, id-folder gives up the one-ls "
            .. "answer the owner asked for.",
    },
    {
        id = "people-own-devices",
        question = "Should your own devices (contacts marked own = true) get a folder in people/?",
        waits_on = "owner",
        detail = "issue 104: found while writing (open question in the issue)",
        config_key = "people.own-devices",
        variants = {
            {
                name = "none",
                summary = "No folder for your own devices.",
                built_in = "src/people-links/061-people-links.lua (own_device_tops, no_tops)",
                tests = "tests/071-test-choices.lua",
                findings = "Matches how the rest of phase 1 treats devices: 103 refuses to put an own "
                    .. "device on a recipient list, and people-links errors if one is found on a list. So "
                    .. "under this variant a device can never have a folder. Switching from all-tops to "
                    .. "none sweeps the device's folder away (tested).",
            },
            {
                name = "all-tops",
                summary = "Each own device gets a folder linking the top of every tree you have (your devices see everything).",
                built_in = "src/people-links/061-people-links.lua (tops_for_own_device)",
                tests = "tests/071-test-choices.lua",
                findings = "Works, but the folder is the same for every device and says nothing a list "
                    .. "of rooms with no parent would not: it answers 'what do I have', not 'what do I "
                    .. "share with this person'. It would become meaningful only if a later phase lets a "
                    .. "device be limited to some rooms.",
            },
        },
        leaning = "none, until devices can be limited to some rooms.",
    },
    {
        id = "people-split-records",
        question = "After a split, the room you used to share is kept as a read-only record (103's fork). Does it still show up in people/?",
        waits_on = "owner",
        detail = "issue 104 / issue 103: only matters when recipients.split-shape = fork, or a record-only split; under rekey the old room is gone",
        config_key = "people.split-records",
        variants = {
            {
                name = "show",
                summary = "A split record is a shared room like any other: everyone on its old list keeps a link to it.",
                built_in = "src/people-links/061-people-links.lua (read_snapshot: visible)",
                tests = "tests/071-test-choices.lua, tests/072-test-with-neighbours.lua",
                findings = "After a fork split everyone still in the room gets two links with the same "
                    .. "name (the record and the room you now talk in), so every split turns into a name "
                    .. "clash handled by people.link-collision (numbered gave 'programming' and "
                    .. "'programming-2'). The person you were removed by keeps a link to a room that is "
                    .. "now read-only and will never hear from them again — the thing 103 warned about.",
            },
            {
                name = "hide",
                summary = "A room with 103's split marker is not a shared room; only the room you now talk in is linked.",
                built_in = "src/people-links/061-people-links.lua (read_snapshot: visible)",
                tests = "tests/071-test-choices.lua, tests/072-test-with-neighbours.lua",
                findings = "people/ then says what you share now: the removed person's link to the room "
                    .. "goes (their folder too if nothing else is shared), and there is no clash. Needed "
                    .. "103 to ring the bell once the marker is written (the 'split' bell kind, added at "
                    .. "104's request); with it, the bell alone leaves people/ exactly as a full rebuild "
                    .. "would, for fork and rekey (tested against the real 103). A child still under a "
                    .. "hidden record becomes a top (tested with a hand-written marker; 103 repoints "
                    .. "children to the new room, so this does not happen in real splits). The record "
                    .. "is still reachable through rooms/ and 103's 'into' line.",
            },
        },
        leaning = "hide: people/ is 'what do I share with this person', and a record is shared with nobody any more.",
    },
    {
        id = "people-slash-in-link-name",
        question = "A room name holding '/' cannot be a file name. How is the '/' shown in its people/ link?",
        waits_on = "state",
        detail = "issue 104: only reachable when 101's rooms.slash-in-name = allow; read only when such a name exists",
        config_key = "people.slash-in-link-name",
        variants = {
            {
                name = "percent",
                summary = "'/' becomes %2F: home%2Fritz.",
                built_in = "src/people-links/061-people-links.lua (slash_rewrites)",
                tests = "tests/071-test-choices.lua",
                findings = "Plain ASCII, obviously an escape, safe in every tool. Not reversed and not "
                    .. "needed to be: a room really called 'a%2Fb' clashing with 'a/b' is separated by "
                    .. "the collision mode like any other clash (tested: a%2Fb and a%2Fb-2 under numbered).",
            },
            {
                name = "division-slash",
                summary = "'/' becomes the look-alike character U+2215: home∕ritz.",
                built_in = "src/people-links/061-people-links.lua (slash_rewrites)",
                tests = "tests/071-test-choices.lua",
                findings = "Reads exactly like the real name in ls, which is also its danger: it looks "
                    .. "like a path, and someone typing people/friend/home/ritz gets nothing. Three bytes "
                    .. "of UTF-8 in the file name.",
            },
        },
        leaning = "percent, if rooms.slash-in-name = allow is chosen at all; under refuse this never comes up.",
    },
    {
        id = "people-rebuild-scope",
        question = "Every ring of the bell (except a new message) rebuilds all of people/. Is that cheap enough, or should a ring rebuild only the people it can affect?",
        waits_on = "state",
        detail = "issue 104: needs a measurement on a real home's size",
        config_key = "",
        variants = {
            {
                name = "rebuild-all",
                summary = "Built: any name/parent/list/room change rebuilds every person's folder from one read of all rooms.",
                built_in = "src/people-links/061-people-links.lua (on_bell, rebuild_all)",
                tests = "tests/071-test-choices.lua (the bell), tests/068-test-owners-example.lua",
                findings = "Simple and always right: a parent change can move tops for everyone below "
                    .. "it, and the old list of a changed room is not known when the bell rings, so "
                    .. "narrowing needs more than the bell carries. Measured against the real 101 "
                    .. "(people-links only, CPU time): one rebuild_all over 100 rooms took 6 ms, over "
                    .. "400 rooms 19 ms; making 400 rooms one after another, each ringing a full rebuild, "
                    .. "took 5 s in total (the cost grows with the square of the room count when rooms "
                    .. "are made in bulk, e.g. an import). Unchanged links are left alone, so a rebuild "
                    .. "that changes nothing writes nothing.",
            },
            {
                name = "rebuild-affected",
                summary = "Not built: rebuild only people on the old or new list of the changed room and its subtree.",
                built_in = "",
                tests = "",
                findings = "Would need the bell to carry the old list (or 104 to keep its own copy), "
                    .. "which is a second truth the planning document warns against. Worth building "
                    .. "only if bulk imports or large homes make the measured cost matter.",
            },
        },
        leaning = "keep rebuild-all until a home with thousands of rooms exists; a bulk import can "
            .. "call rebuild_all once at the end instead of ringing per room.",
    },
}
