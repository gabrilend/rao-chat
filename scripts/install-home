#!/usr/bin/env bash
#
# install-home — makes a rao-chat home on this machine, or brings one up to
# date (issue 602).  It asks where the home keeps its mailboxes, its name,
# its two ports and the address it listens on, then makes the home through
# the home's own code (src/install/232-make-home.lua), stating every other
# setting in the config with its question beside it.  Re-running it is
# safe: an existing home's values are the suggestions, and nothing a person
# wrote is overwritten unless a new value is given.
#
# What it does, top to bottom:
#   1. LuaJIT on the path, then what a home needs (601): a missing required
#      thing stops it before anything is written.
#   2. The questions (each answerable by a flag; see --help).
#   3. The home, written as soon as the answers are known (232).
#   4. The home's environment file, <home>/environment: the paths its
#      programs run with (scripts/run-home reads it; a service does not see
#      this shell's PATH).
#   5. What to do next: the ports to open, pairing a phone or a browser,
#      the page's folder, running the home.
#
# It never raises its own privileges and writes nothing outside the home
# folder.
#
# Usage (from any folder):
#   scripts/install-home [options]           see --help
#
# The program folder is the one this script is in (the home runs the
# program it was installed from); --project=<folder> names another.
#
# Exit status: 0 the home is made or up to date; 1 it is not (and why was
# said); 2 a mistaken argument.

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# {{{ the words it prints
err()  { printf '  error: %s\n' "$*" >&2; }
warn() { printf '  warning: %s\n' "$*" >&2; }
info() { printf '  %s\n' "$*"; }
ok()   { printf '  ok: %s\n' "$*"; }
# }}}

# ---------------------------------------------------------------------------
# The option store (rmail's, rubric note section 1, step 2).  Every
# question has a key; --key=value, --key value, --flag and --no-flag answer
# it and skip the question.  Values come from the command line only, never
# from the environment: a stale export would change an install silently.
# ---------------------------------------------------------------------------

declare -A OPT=()
SILENT=false
ALL_YES=false

# The keys this installer knows.  Value keys take a string; yes/no keys a
# yes or a no.
VALUE_KEYS="home home_name device_port direct_port address ram_root project"
YN_KEYS=""

# {{{ show_help
show_help() {
    cat <<'HELP'
Usage: scripts/install-home [options]

  -h, --help            this help
  --silent              never ask: every value it cannot know must be given,
                        or it stops, naming the flag, before writing anything
  -y, --yes             answer every yes/no question yes, unless --no-<flag>

The questions (giving the flag skips the question):
  --home=FOLDER         where this home keeps its mailboxes (asked first;
                        the folder above it must exist)
  --home-name=NAME      this home's name, as anyone sharing an upstream sees
                        it (git.home-name)
  --device-port=PORT    the port your phones and browsers connect to
                        (devices.port)
  --direct-port=PORT    the port other homes send your direct messages to
                        (the direct-message mailbox)
  --address=ADDRESS     the address the home listens on: "any", or one of
                        this machine's (gatherer.address and devices.address)

Flags with no question:
  --ram-root=FOLDER     where the home's RAM folders go (gatherer.ram-root;
                        stated as /dev/shm/rao-chat when not given)
  --project=FOLDER      the program folder (the one this script is in)

There are no default ports.  Asked, a free port is suggested; with
--silent both ports must be given.

Unattended example:
  scripts/install-home --silent --home=/srv/rao/alice --home-name=alice \
      --device-port=51234 --direct-port=52345 --address=any

Values are read from the command line only, never from the environment.
HELP
}
# }}}

# {{{ local option helpers
has_opt() { [ -n "${OPT[$1]+set}" ]; }

parse_bool() {
    case "$1" in
        [Yy]|[Yy][Ee][Ss]|[Tt][Rr][Uu][Ee]|1) return 0 ;;
        [Nn]|[Nn][Oo]|[Ff][Aa][Ll][Ss][Ee]|0) return 1 ;;
        *) err "not a yes or a no: '$1' (yes/no/true/false/1/0)"; exit 2 ;;
    esac
}
# }}}

# {{{ the arguments
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) show_help; exit 0 ;;
        --silent) SILENT=true; shift ;;
        -y|--yes) ALL_YES=true; shift ;;
        --no-*=*) err "$1: --no- takes no value"; exit 2 ;;
        --no-*)
            key=$(printf '%s' "${1#--no-}" | tr '-' '_')
            case " $YN_KEYS " in
                *" $key "*) OPT[$key]=no; shift ;;
                *) err "unknown argument: $1 (see --help)"; exit 2 ;;
            esac
            ;;
        --*=*)
            key=$(printf '%s' "${1%%=*}" | sed 's/^--//' | tr '-' '_')
            value="${1#*=}"
            case " $VALUE_KEYS $YN_KEYS " in
                *" $key "*) OPT[$key]="$value"; shift ;;
                *) err "unknown argument: $1 (see --help)"; exit 2 ;;
            esac
            ;;
        --*)
            key=$(printf '%s' "${1#--}" | tr '-' '_')
            case " $VALUE_KEYS " in
                *" $key "*)
                    if [ $# -lt 2 ]; then err "$1 needs a value"; exit 2; fi
                    OPT[$key]="$2"; shift 2 ;;
                *)
                    case " $YN_KEYS " in
                        *" $key "*) OPT[$key]=yes; shift ;;
                        *) err "unknown argument: $1 (see --help)"; exit 2 ;;
                    esac
                    ;;
            esac
            ;;
        *) err "unknown argument: $1 (see --help)"; exit 2 ;;
    esac
done
if has_opt project; then
    if [ ! -d "${OPT[project]}/src/install" ]; then
        err "--project: ${OPT[project]} is not a rao-chat program folder (no src/install)"
        exit 2
    fi
    DIR="$(cd "${OPT[project]}" && pwd)"
fi
# }}}

# {{{ ask_value KEY "question" "suggestion" → the answer on stdout
# A flag's value when given.  Under --silent, a missing value stops the
# run, naming the flag.  Otherwise the question goes to stderr with the
# suggestion in [brackets]; Enter takes the suggestion.  Lines are read
# with line editing (rubric I12); input that ends is no answer, not a yes.
ask_value() {
    local key="$1" question="$2" suggestion="$3" answer
    if has_opt "$key"; then
        printf '%s' "${OPT[$key]}"
        return 0
    fi
    if $SILENT; then
        err "--silent: no value for $key; give --$(printf '%s' "$key" | tr '_' '-')=VALUE"
        return 1
    fi
    printf '  %s [%s]: ' "$question" "$suggestion" >&2
    if [ -t 0 ]; then
        IFS= read -e -r answer || { printf '\n' >&2; err "no answer (input ended)"; return 1; }
    else
        IFS= read -r answer || { printf '\n' >&2; err "no answer (input ended)"; return 1; }
    fi
    if [ -z "$answer" ]; then answer="$suggestion"; fi
    printf '%s' "$answer"
}
# }}}

# {{{ ask_yn KEY "question" → status 0 yes, 1 no
ask_yn() {
    local key="$1" question="$2" answer
    if has_opt "$key"; then parse_bool "${OPT[$key]}"; return; fi
    if $ALL_YES; then return 0; fi
    if $SILENT; then
        err "--silent: no answer for $key; give --$(printf '%s' "$key" | tr '_' '-') or --no-$(printf '%s' "$key" | tr '_' '-')"
        exit 1
    fi
    printf '  %s [y/N] ' "$question" >&2
    IFS= read -r answer || { printf '\n' >&2; return 1; }
    case "$answer" in [Yy]*) return 0 ;; *) return 1 ;; esac
}
# }}}

# ---------------------------------------------------------------------------
# 1. What a home needs (601)
# ---------------------------------------------------------------------------

echo ""
echo "rao-chat: making a home"
echo "  program folder: $DIR"

LUAJIT="$(command -v luajit 2>/dev/null || true)"
if [ -z "$LUAJIT" ]; then
    err "LuaJIT is not on this PATH: every program of a home runs on it (luajit)."
    err "Install LuaJIT with your system's packages and run this again.  Nothing was written."
    exit 1
fi
if ! NEEDS="$("$LUAJIT" "$DIR/src/install/230-what-a-home-needs.lua" "$DIR" --quiet 2>&1)"; then
    printf '%s\n' "$NEEDS" | sed 's/^/  /'
    err "this machine is missing what a home needs (above).  Nothing was written."
    exit 1
fi
if [ -n "$NEEDS" ]; then printf '%s\n' "$NEEDS" | sed 's/^/  /'; fi
ok "this machine has what a home needs ($("$LUAJIT" -v 2>&1 | cut -d' ' -f1-2))"

# ---------------------------------------------------------------------------
# 2. The questions
# ---------------------------------------------------------------------------

echo ""
echo "  (Enter keeps the suggestion in [brackets])"

# The home's folder first: everything else about an existing home is read
# from it, and nothing else is consulted (no list of homes is kept for
# suggestions; rmail #102).
HOME_DIR="$(ask_value home "Where should this home keep its mailboxes?" "${HOME}/rao-home")" || exit 1
case "$HOME_DIR" in
    "~") HOME_DIR="$HOME" ;;
    "~/"*) HOME_DIR="${HOME}/${HOME_DIR#\~/}" ;;
esac
case "$HOME_DIR" in
    /*) ;;
    *) HOME_DIR="$(pwd)/${HOME_DIR}" ;;
esac
while [ "${HOME_DIR%/}" != "$HOME_DIR" ] && [ "$HOME_DIR" != "/" ]; do HOME_DIR="${HOME_DIR%/}"; done
PARENT_DIR="$(dirname "$HOME_DIR")"
if [ ! -d "$PARENT_DIR" ]; then
    err "the folder above the home does not exist: $PARENT_DIR"
    err "  make it first (a mistyped path should not grow a new tree of folders).  Nothing was written."
    exit 1
fi

# What the home already holds: its settings and its mailboxes' ports.
SHOWN=""
if [ -f "$HOME_DIR/config" ]; then
    if ! SHOWN="$("$LUAJIT" "$DIR/src/install/232-make-home.lua" "$DIR" "$HOME_DIR" --show 2>&1)"; then
        printf '%s\n' "$SHOWN" | sed 's/^/  /'
        err "the home at $HOME_DIR could not be read (above).  Nothing was written."
        exit 1
    fi
    info "a home is already at $HOME_DIR: its values are the suggestions"
fi
shown_config() { printf '%s\n' "$SHOWN" | sed -n "s/^config $1 = //p" | head -n 1; }
shown_ports() { printf '%s\n' "$SHOWN" | sed -n 's/^mailbox [a-z]* \([0-9]*\) .*/\1/p'; }
WAS_NAME="$(shown_config git.home-name)"
WAS_DEVICE_PORT="$(shown_config devices.port)"
WAS_ADDRESS="$(shown_config gatherer.address)"
WAS_DIRECT_PORT="$(printf '%s\n' "$SHOWN" | sed -n 's/^mailbox direct \([0-9]*\) .*/\1/p' | head -n 1)"

# {{{ the port check (ss or netstat; rmail's port_holder)
PORT_LISTER=""
if command -v ss >/dev/null 2>&1; then
    PORT_LISTER="ss -ltnH"
elif command -v netstat >/dev/null 2>&1; then
    PORT_LISTER="netstat -ltn"
fi
# port_holder PORT → the listening line holding it, or nothing
port_holder() {
    [ -n "$PORT_LISTER" ] || return 0
    $PORT_LISTER 2>/dev/null | awk -v p=":$1" '$4 ~ p"$" || $5 ~ p"$" { print; exit }'
}
# random_port [AVOID...] → a free port in 50000-65000, none of AVOID
random_port() {
    local raw port avoid clash
    while true; do
        raw=$(od -An -tu2 -N2 /dev/urandom | tr -d ' ')
        port=$(( (raw % 15001) + 50000 ))
        clash=false
        for avoid in "$@" $(shown_ports); do [ "$port" = "$avoid" ] && clash=true; done
        $clash && continue
        [ -n "$(port_holder "$port")" ] && continue
        echo "$port"
        return
    done
}
# }}}

# {{{ ask_port KEY "question" WAS AVOID → a checked port
# A port this home already holds (WAS) is not checked against listeners:
# a running home holds its own ports.
ask_port() {
    local key="$1" question="$2" was="$3" avoid="$4" port holder suggestion
    suggestion="$was"
    [ -n "$suggestion" ] || suggestion="$(random_port $avoid)"
    while true; do
        port="$(ask_value "$key" "$question" "$suggestion")" || return 1
        if ! printf '%s' "$port" | grep -qE '^[0-9]+$' || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
            warn "a port is a whole number from 1 to 65535, not '$port'"
            if $SILENT || has_opt "$key"; then return 1; fi
            continue
        fi
        if [ -n "$avoid" ] && [ "$port" = "$avoid" ]; then
            warn "port $port is already this home's other port: each needs its own"
            if $SILENT || has_opt "$key"; then return 1; fi
            suggestion="$(random_port $avoid)"
            continue
        fi
        if [ "$port" != "$was" ]; then
            if [ -z "$PORT_LISTER" ]; then
                warn "neither ss nor netstat is here, so port $port was not checked against what is listening"
            else
                holder="$(port_holder "$port")"
                if [ -n "$holder" ]; then
                    warn "something is already listening on port $port: $holder"
                    if $SILENT || has_opt "$key"; then return 1; fi
                    suggestion="$(random_port $avoid)"
                    continue
                fi
            fi
        fi
        printf '%s' "$port"
        return 0
    done
}
# }}}

# {{{ login_name → this user's login name, or "home"
login_name() {
    local name
    name="$(whoami 2>/dev/null)" || name=""
    [ -n "$name" ] || name="$(id -un 2>/dev/null)" || name=""
    printf '%s' "${name:-home}"
}
# }}}

# The name: seen by anyone sharing an upstream (215), so two homes never
# share one by default (602 decision 2).
while true; do
    HOME_NAME="$(ask_value home_name "This home's name, as anyone sharing an upstream sees it" \
        "${WAS_NAME:-$(login_name)}")" || exit 1
    if printf '%s' "$HOME_NAME" | grep -qE '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$' \
        && ! printf '%s' "$HOME_NAME" | grep -q '\.\.' && [ "${HOME_NAME%.lock}" = "$HOME_NAME" ]; then
        break
    fi
    warn "a name is letters, digits, '.', '_' or '-', starting with a letter or digit, at most 64"
    if $SILENT || has_opt home_name; then exit 1; fi
done

DEVICE_PORT="$(ask_port device_port "The port your phones and browsers connect to" "$WAS_DEVICE_PORT" "")" \
    || { err "no device port.  Nothing was written."; exit 1; }
DIRECT_PORT="$(ask_port direct_port "The port other homes send your direct messages to" "$WAS_DIRECT_PORT" \
    "$DEVICE_PORT")" || { err "no direct-message port.  Nothing was written."; exit 1; }

ADDRESS="$(ask_value address "The address this home listens on (any, or one of this machine's)" \
    "${WAS_ADDRESS:-any}")" || exit 1

# ---------------------------------------------------------------------------
# 3. The home, written now (rubric I2)
# ---------------------------------------------------------------------------

echo ""
SETTINGS=( "git.home-name=$HOME_NAME" "devices.port=$DEVICE_PORT" "gatherer.address=$ADDRESS"
           "devices.address=$ADDRESS" "direct-port=$DIRECT_PORT" )
if has_opt ram_root; then SETTINGS+=( "gatherer.ram-root=${OPT[ram_root]}" ); fi
if ! MADE="$("$LUAJIT" "$DIR/src/install/232-make-home.lua" "$DIR" "$HOME_DIR" "${SETTINGS[@]}" 2>&1)"; then
    printf '%s\n' "$MADE" | sed 's/^/  /'
    err "the home was not made (above)."
    exit 1
fi
printf '%s\n' "$MADE" | grep -v '^stated ' | sed 's/^/  /'
STATED=$(printf '%s\n' "$MADE" | grep -c '^stated ' || true)
if [ "$STATED" -gt 0 ]; then
    info "stated   $STATED more setting(s) from their options files' first variants, each with its question"
fi
ok "the home is at $HOME_DIR"

# ---------------------------------------------------------------------------
# 4. The home's environment file (rubric I9)
# ---------------------------------------------------------------------------

# {{{ the paths its programs run with
ENV_PATH=""
add_path() {
    case ":$ENV_PATH:" in
        *":$1:"*) ;;
        *) ENV_PATH="${ENV_PATH:+$ENV_PATH:}$1" ;;
    esac
}
for tool in luajit git flock; do
    found="$(command -v "$tool" 2>/dev/null || true)"
    if [ -n "$found" ]; then add_path "$(dirname "$found")"; fi
done
for folder in /usr/local/bin /usr/bin /bin; do add_path "$folder"; done
ENV_TEXT="# The paths this home's programs run with: written by scripts/install-home,
# read by scripts/run-home (a service does not see the installer's shell).
# Only PATH, LUA_PATH and LUA_CPATH lines are read.  Re-running the
# installer writes this file again.
PATH=$ENV_PATH
"
for name in LUA_PATH LUA_CPATH; do
    value="${!name:-}"
    if [ -n "$value" ]; then
        ENV_TEXT="${ENV_TEXT}${name}=${value}
"
        info "$name is set in this shell, so the home's environment file carries it too"
    fi
done
ENV_FILE="$HOME_DIR/environment"
if [ -f "$ENV_FILE" ] && [ "$(cat "$ENV_FILE")
" = "$ENV_TEXT" ]; then
    info "kept     $ENV_FILE"
else
    printf '%s' "$ENV_TEXT" > "$ENV_FILE.new" && mv "$ENV_FILE.new" "$ENV_FILE"
    info "wrote    $ENV_FILE"
fi
# }}}

# ---------------------------------------------------------------------------
# 5. What to do next
# ---------------------------------------------------------------------------

ALL_PORTS="$("$LUAJIT" "$DIR/src/install/232-make-home.lua" "$DIR" "$HOME_DIR" --show \
    | sed -n 's/^mailbox \([a-z]*\) \([0-9]*\) .*/\2 (the \1 mailbox)/p')"

cat <<NEXT

  This home:
    folder:       $HOME_DIR
    name:         $HOME_NAME
    device port:  $DEVICE_PORT (your phones and browsers)
    mailboxes:    $(printf '%s\n' "$ALL_PORTS" | sed 's/direct mailbox/direct-message mailbox/' | paste -sd ',' - | sed 's/,/, /g')
    listens on:   $ADDRESS

  About firewalls:
    A port is a numbered channel on this machine.  Other homes reach this
    one on each mailbox's port, and your phones and browsers on the device
    port; each new top-level room adds a mailbox with a port of its own.
    To be reached from outside the house, each must be open in this
    machine's firewall and forwarded by the router.  To see what is
    listening and what the firewall allows, one of:
      ss -tln                     what is listening
      sudo nft list ruleset       nftables
      sudo iptables -L            iptables
      ufw status                  ufw
      firewall-cmd --list-all     firewalld

  Pairing a phone or a browser (issue 303; --browser for the web page):
NEXT
printf '    luajit %q %q %q add <label> [--browser]\n' "$DIR/src/devices/189-pair.lua" "$DIR" "$HOME_DIR"
printf '  The web page is the folder %q: copy it to the computer\n' "$DIR/src/web"
printf '  you will use and open 203-rao-chat.html there (issue 401).\n'
if [ -x "$DIR/scripts/run-home" ]; then
    echo ""
    echo "  Running the home, in the foreground (issue 603):"
    printf '    %q %q %q\n' "$DIR/scripts/run-home" "$DIR" "$HOME_DIR"
fi
exit 0
